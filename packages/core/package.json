{
  "name": "@specter-ts/core",
  "version": "0.2.2",
  "description": "TypeScript framework for vertically sliced event-sourced applications.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-entry.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing-entry.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "vitest": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "specter",
    "typescript",
    "event-sourcing",
    "vertical-slice",
    "application-framework",
    "agents"
  ],
  "homepage": "https://github.com/devagrawal09/specter#readme",
  "bugs": {
    "url": "https://github.com/devagrawal09/specter/pulls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devagrawal09/specter.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
