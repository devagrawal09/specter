{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/schemas/greenfield-provenance.schema.json",
  "title": "Specter greenfield evaluation frozen provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specterCommit",
    "artifactManifestSha256",
    "artifacts",
    "packages",
    "runtime"
  ],
  "properties": {
    "specterCommit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "array",
      "minItems": 28,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "artifactId", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "artifactId": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "runtime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactKind": {
      "enum": [
        "adopterPrompt",
        "browserFixture",
        "candidateTable",
        "checkCases",
        "checkCatalog",
        "coordinatorDriver",
        "developerPolicy",
        "domainBrief",
        "environmentFailureSignatures",
        "evaluationRunner",
        "executionCatalog",
        "frictionCodebook",
        "guidance",
        "heldOutSuite",
        "initializer",
        "methodology",
        "randomizedSchedule",
        "recommendationEvidenceMap",
        "reviewerAssignment",
        "semanticCatalog",
        "semanticMapContract",
        "serviceFixture",
        "specterPackage",
        "systemPolicy",
        "toolPolicy",
        "verificationPlan",
        "verifier",
        "visibleSuite"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audience", "kind", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "audience": { "enum": ["public", "private"] },
        "kind": { "$ref": "#/$defs/artifactKind" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "agentHarness",
        "platform",
        "toolchain",
        "services",
        "executionImage",
        "resourceLimits",
        "dependencyCache",
        "imageInputs",
        "runOrderSeed",
        "runOrder",
        "freshContexts"
      ],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "build", "reasoningSetting", "sampler"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 },
            "reasoningSetting": { "type": "string", "minLength": 1 },
            "sampler": {
              "type": "object",
              "additionalProperties": { "type": ["boolean", "null", "number", "string"] }
            }
          }
        },
        "agentHarness": { "$ref": "#/$defs/nameVersion" },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatingSystem", "release", "architecture"],
          "properties": {
            "operatingSystem": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "packageManager", "browser", "browserRevision"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "packageManager": { "type": "string", "minLength": 1 },
            "browser": { "type": "string", "minLength": 1 },
            "browserRevision": { "type": "string", "minLength": 1 }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "minLength": 1 }
            }
          }
        },
        "executionImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "resourceLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contextTokens", "cpuCores", "memoryMiB", "activeMinutes", "checkpointMinutes", "remediationMinutes"],
          "properties": {
            "contextTokens": { "type": "integer", "minimum": 1 },
            "cpuCores": { "type": "number", "exclusiveMinimum": 0 },
            "memoryMiB": { "type": "integer", "minimum": 1 },
            "activeMinutes": { "const": 180 },
            "checkpointMinutes": { "const": 75 },
            "remediationMinutes": { "const": 60 }
          }
        },
        "dependencyCache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "imageInputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "runOrderSeed": { "type": "string", "minLength": 1 },
        "runOrder": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "freshContexts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attemptId", "taskId", "initialContextTokens", "freshTask", "parentTaskId"],
            "properties": {
              "attemptId": { "$ref": "#/$defs/id" },
              "taskId": { "type": "string", "minLength": 1 },
              "initialContextTokens": { "type": "integer", "minimum": 0 },
              "freshTask": { "const": true },
              "parentTaskId": { "type": "null" }
            }
          }
        }
      }
    },
    "nameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
