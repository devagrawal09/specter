{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/schemas/greenfield-provenance.schema.json",
  "title": "Specter greenfield evaluation frozen provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specterCommit",
    "artifactManifestSha256",
    "artifacts",
    "packages",
    "runtime"
  ],
  "properties": {
    "specterCommit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "array",
      "minItems": 18,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "artifactId", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "artifactId": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "runtime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactKind": {
      "enum": [
        "adopterPrompt",
        "browserFixture",
        "checkCases",
        "checkCatalog",
        "coordinatorDriver",
        "domainBrief",
        "evaluationRunner",
        "executionCatalog",
        "guidance",
        "heldOutSuite",
        "initializer",
        "semanticCatalog",
        "semanticMapContract",
        "serviceFixture",
        "specterPackage",
        "verificationPlan",
        "verifier",
        "visibleSuite"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audience", "kind", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "audience": { "enum": ["public", "private"] },
        "kind": { "$ref": "#/$defs/artifactKind" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "agentHarness", "platform", "toolchain", "services", "runOrderSeed"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "build", "reasoningSetting", "sampler"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 },
            "reasoningSetting": { "type": "string", "minLength": 1 },
            "sampler": {
              "type": "object",
              "additionalProperties": { "type": ["boolean", "null", "number", "string"] }
            }
          }
        },
        "agentHarness": { "$ref": "#/$defs/nameVersion" },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatingSystem", "release", "architecture"],
          "properties": {
            "operatingSystem": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "packageManager", "browser", "browserRevision"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "packageManager": { "type": "string", "minLength": 1 },
            "browser": { "type": "string", "minLength": 1 },
            "browserRevision": { "type": "string", "minLength": 1 }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "minLength": 1 }
            }
          }
        },
        "runOrderSeed": { "type": "string", "minLength": 1 }
      }
    },
    "nameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
