{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/schemas/greenfield-provenance.schema.json",
  "title": "Specter greenfield evaluation frozen provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specterCommit",
    "promptSha256",
    "guidanceSha256",
    "guidanceFiles",
    "briefSha256",
    "verifierSha256",
    "semanticCatalogSha256",
    "packages",
    "model",
    "reasoningSetting"
  ],
  "properties": {
    "specterCommit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "promptSha256": { "$ref": "#/$defs/sha256" },
    "guidanceSha256": { "$ref": "#/$defs/sha256" },
    "guidanceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "briefSha256": { "$ref": "#/$defs/sha256" },
    "verifierSha256": { "$ref": "#/$defs/sha256" },
    "semanticCatalogSha256": { "$ref": "#/$defs/sha256" },
    "model": { "type": "string", "minLength": 1 },
    "reasoningSetting": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
