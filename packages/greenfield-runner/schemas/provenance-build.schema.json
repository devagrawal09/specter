{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/schemas/greenfield-provenance-build.schema.json",
  "title": "Specter greenfield provenance build input",
  "type": "object",
  "additionalProperties": false,
  "required": ["specterCommit", "artifacts", "packageTarballs", "runtime"],
  "properties": {
    "specterCommit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audience", "kind", "path"],
        "properties": {
          "id": { "$ref": "greenfield-provenance.schema.json#/$defs/id" },
          "audience": { "enum": ["public", "private"] },
          "kind": { "$ref": "greenfield-provenance.schema.json#/$defs/artifactKind" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packageTarballs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "artifactId", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "artifactId": { "$ref": "greenfield-provenance.schema.json#/$defs/id" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime": { "$ref": "greenfield-provenance.schema.json#/$defs/runtime" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactManifestSha256": { "$ref": "greenfield-provenance.schema.json#/$defs/sha256" },
        "artifacts": { "$ref": "#/$defs/digestRecord" },
        "packageTarballs": { "$ref": "#/$defs/digestRecord" }
      }
    }
  },
  "$defs": {
    "digestRecord": {
      "type": "object",
      "additionalProperties": { "$ref": "greenfield-provenance.schema.json#/$defs/sha256" }
    }
  }
}
