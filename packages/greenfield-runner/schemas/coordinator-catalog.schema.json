{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/schemas/greenfield-coordinator-catalog.schema.json",
  "title": "Specter greenfield coordinator catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domains",
    "workspacePath",
    "freezePaths",
    "visibleCommands",
    "heldOutCommands"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domainId",
          "domainName",
          "domainKind",
          "persistence",
          "port"
        ],
        "properties": {
          "domainId": { "$ref": "#/$defs/id" },
          "domainName": { "type": "string", "minLength": 1 },
          "domainKind": { "enum": ["replication", "transfer"] },
          "persistence": { "enum": ["sqlite", "postgres"] },
          "port": { "type": "integer", "minimum": 10000, "maximum": 65535 }
        }
      }
    },
    "workspacePath": { "$ref": "#/$defs/relativePath" },
    "freezePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "visibleCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandTemplate" }
    },
    "heldOutCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandTemplate" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|\\\\|[A-Za-z]:|\\.\\.(?:/|\\\\|$))" }
    },
    "commandTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "args", "cwd", "timeoutMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
