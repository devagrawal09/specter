{
  "name": "@specter/evaluation-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Coordinator-side orchestration for the Specter greenfield adoption evaluation.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "specter-greenfield": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm build && node --test --experimental-strip-types test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  }
}
