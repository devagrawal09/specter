{
  "name": "@specter-ts/observability",
  "version": "0.3.0",
  "description": "Shared Specter runtime collector, dashboard, CLI, and telemetry producer.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "specter-observe": "./dist/cli.js"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm spec:build && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "pnpm spec:build && vite build && vitest run && node --test test/packaged-dashboard.node.mjs",
    "typecheck": "pnpm spec:build && tsc -p tsconfig.json --noEmit",
    "spec:build": "specter-spec export src/features"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@specter-ts/core": "workspace:*",
    "@specter-ts/memory": "workspace:*",
    "@specter-ts/protocol": "workspace:*",
    "@specter-ts/reaction-outbox": "workspace:*",
    "@specter-ts/spec": "workspace:*",
    "@specter-ts/sqlite": "workspace:*",
    "solid-js": "^1.9.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
