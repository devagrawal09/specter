{
  "name": "@specter-ts/spec-editor",
  "version": "0.4.0",
  "description": "Local visual editor for portable Specter Slice specifications.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "specter-spec-editor": "./dist/cli.js"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@specter-ts/spec": "workspace:*",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
