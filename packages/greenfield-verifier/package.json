{
  "name": "@specter-ts/greenfield-verifier",
  "version": "0.0.0",
  "private": true,
  "description": "Coordinator-owned verifier for frozen Specter greenfield adoption attempts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "specter-greenfield-verify": "./dist/cli.js"
  },
  "files": [
