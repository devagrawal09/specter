{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"],
  "exclude": ["dist", ".test-dist"],
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": ".test-dist"
  }
}
