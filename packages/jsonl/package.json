{
  "name": "@specter-ts/jsonl",
  "version": "0.4.0",
  "description": "Append-only JSONL file Event Log, JSON file Slice Store, and JSONL Reaction outbox Store for Specter.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "node --expose-gc --import tsx bench/app-construction.ts"
  },
  "dependencies": {
    "@specter-ts/core": "workspace:*",
    "@specter-ts/reaction-outbox": "workspace:*"
  },
  "peerDependencies": {
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@specter-ts/memory": "workspace:*",
    "@specter-ts/spec": "workspace:*",
    "@types/node": "^24.10.1",
    "effect": "4.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
