{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "formatVersion": 2,
  "kind": "command",
  "name": "addTodo",
  "description": "Adds a todo.",
  "scenarios": [{
    "description": "Adds one.",
    "given": [],
    "when": { "todoId": "todo-1", "title": "Ship it" },
    "expect": [{ "kind": "scenario-event", "eventType": "todo-added", "examplePayload": { "todoId": "todo-1", "title": "Ship it" } }]
  }, {
    "description": "Refuses a blank title.",
    "given": [],
    "when": { "todoId": "todo-1", "title": " " },
    "expect": [],
    "reject": { "code": "title-required", "message": "Todo title is required" }
  }]
}
