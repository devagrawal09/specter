{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/protocol/v1/envelope.schema.json",
  "title": "Specter protocol v1 envelope",
  "type": "object",
  "required": ["protocolVersion", "kind", "requestId"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 }
  }
}
