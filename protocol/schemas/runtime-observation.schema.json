{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/protocol/v1/runtime-observation.schema.json",
  "title": "Specter runtime observation",
  "type": "object",
  "required": ["observationId", "sequence", "observedAt", "source", "kind", "operationId"],
  "properties": {
    "observationId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "observedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "kind": {
      "enum": [
        "command.started", "command.completed", "command.rejected", "command.failed",
        "query.started", "query.completed", "query.rejected", "query.failed", "events.persisted",
        "slice.catch-up.started", "slice.catch-up.completed", "slice.catch-up.failed",
        "subscription.invalidated", "replay.started", "replay.completed", "replay.failed",
        "reaction.pass.started", "reaction.pass.completed", "reaction.pass.failed", "reaction.run.started",
        "reaction.run.completed", "reaction.run.failed", "outbox.enqueued",
        "outbox.attempted", "outbox.retry-scheduled", "outbox.dead-lettered", "telemetry.dropped"
      ]
    },
    "source": {
      "type": "object",
      "required": ["application", "environment", "runtimeLanguage", "runtimeVersion", "instanceId", "eventLogId"],
      "properties": {
        "application": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "runtimeLanguage": { "type": "string", "minLength": 1 },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "instanceId": { "type": "string", "minLength": 1 },
        "eventLogId": { "type": "string", "minLength": 1 }
      }
    },
    "operationId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "parentOperationIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "triggeringEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "triggeringEventOrder": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/safeInteger" },
        "to": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "reactionPassId": { "type": "string", "minLength": 1 },
    "deliveryId": { "type": "string", "minLength": 1 },
    "events": { "type": "array", "items": { "$ref": "#/$defs/eventReference" } },
    "cursor": { "$ref": "#/$defs/safeInteger" },
    "droppedCount": { "$ref": "#/$defs/safeInteger" },
    "attributes": { "type": "object" },
    "error": { "$ref": "#/$defs/structuredError" }
  },
  "$defs": {
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "eventReference": {
      "type": "object",
      "required": ["eventId", "type", "order", "recordedAt", "commitVersion"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "order": { "$ref": "#/$defs/safeInteger" },
        "recordedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "commitVersion": { "$ref": "#/$defs/safeInteger" },
        "attributes": { "type": "object" }
      }
    },
    "structuredError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": {},
        "retryable": { "type": "boolean" }
      }
    }
  }
}
