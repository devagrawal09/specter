{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/evaluations/greenfield-result.schema.json",
  "title": "Specter greenfield adoption attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assignmentId",
    "attemptId",
    "domainId",
    "cohort",
    "profile",
    "startedAt",
    "frozenAt",
    "activeMilliseconds",
    "wallMilliseconds",
    "phaseTiming",
    "firstAttemptStatus",
    "fullFirstAttemptSuccess",
    "gates",
    "visibleChecks",
    "heldOutChecks",
    "checkpoint",
    "firstAttemptFreeze",
    "generatorUses",
    "friction",
    "iterationCount",
    "implementationSize",
    "sourcesConsulted",
    "remediation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assignmentId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "domainId": { "type": "string", "minLength": 1 },
    "cohort": { "enum": ["replication", "transfer"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "topology"],
      "properties": {
        "persistence": { "enum": ["sqlite", "postgres"] },
        "topology": { "enum": ["single-process", "multi-process"] }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "activeMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10800000
    },
    "wallMilliseconds": { "type": "integer", "minimum": 0 },
    "phaseTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrapMilliseconds",
        "verticalPathMilliseconds",
        "domainCompletionMilliseconds"
      ],
      "properties": {
        "bootstrapMilliseconds": { "type": "integer", "minimum": 0 },
        "verticalPathMilliseconds": { "type": "integer", "minimum": 0 },
        "domainCompletionMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "firstAttemptStatus": { "enum": ["passed", "failed", "timed-out"] },
    "fullFirstAttemptSuccess": { "type": "boolean" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "verticalPath", "domainCompleteness", "robustness"],
      "properties": {
        "bootstrap": { "$ref": "#/$defs/gate" },
        "verticalPath": { "$ref": "#/$defs/gate" },
        "domainCompleteness": { "$ref": "#/$defs/gate" },
        "robustness": { "$ref": "#/$defs/gate" }
      }
    },
    "visibleChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "heldOutChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "checkpoint": { "$ref": "#/$defs/freeze" },
    "firstAttemptFreeze": { "$ref": "#/$defs/freeze" },
    "generatorUses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "dryRun", "generated", "decision"],
        "properties": {
          "kind": { "enum": ["command", "query", "reaction", "persistent-harness"] },
          "dryRun": { "type": "boolean" },
          "generated": { "type": "boolean" },
          "decision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "friction": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "phase", "summary"],
        "properties": {
          "category": {
            "enum": [
              "initialization",
              "generator-output",
              "event-scenario-modeling",
              "private-state-projection",
              "app-registration",
              "persistence",
              "reaction",
              "transport-subscription",
              "ui-integration",
              "recovery",
              "testing",
              "toolchain",
              "guidance",
              "non-specter"
            ]
          },
          "phase": { "enum": ["bootstrap", "vertical-path", "domain-completion", "verification"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "iterationCount": { "type": "integer", "minimum": 0 },
    "implementationSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "linesAdded", "linesDeleted"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "linesAdded": { "type": "integer", "minimum": 0 },
        "linesDeleted": { "type": "integer", "minimum": 0 }
      }
    },
    "sourcesConsulted": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "additionalMilliseconds", "checks"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not-run"] },
        "additionalMilliseconds": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mandatoryChecksPassed", "mandatoryChecksTotal"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not-run", "timed-out"] },
        "mandatoryChecksPassed": { "type": "integer", "minimum": 0 },
        "mandatoryChecksTotal": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gate", "visibility", "status", "durationMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "gate": { "enum": ["bootstrap", "verticalPath", "domainCompleteness", "robustness"] },
        "visibility": { "enum": ["visible", "held-out"] },
        "status": { "enum": ["passed", "failed", "not-run", "timed-out"] },
        "durationMs": { "type": "integer", "minimum": 0 },
        "detail": { "type": "string" }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "revision", "sha256"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
