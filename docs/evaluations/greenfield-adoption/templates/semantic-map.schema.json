{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter.dev/evaluations/greenfield-semantic-map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domain", "mappings"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "domain": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "mappings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
      },
      "additionalProperties": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "pointer": { "type": "string", "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$" },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "identity" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields"],
          "properties": {
            "kind": { "const": "objectFields" },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/pointer" },
              "additionalProperties": { "$ref": "#/$defs/pointer" }
            }
          }
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "identity" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields"],
          "properties": {
            "kind": { "const": "objectFields" },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/pointer" }
            }
          }
        }
      ]
    },
    "mapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "envelopeType", "request", "result"],
          "properties": {
            "capability": { "enum": ["command", "query"] },
            "envelopeType": { "type": "string", "minLength": 1 },
            "request": { "$ref": "#/$defs/request" },
            "result": { "$ref": "#/$defs/result" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "queryEnvelopeType", "request", "result"],
          "properties": {
            "capability": { "const": "subscription" },
            "queryEnvelopeType": { "type": "string", "minLength": 1 },
            "request": { "$ref": "#/$defs/request" },
            "result": { "$ref": "#/$defs/result" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "events"],
          "properties": {
            "capability": { "const": "eventLog" },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["eventType", "canonicalType", "payload"],
                "properties": {
                  "eventType": { "type": "string", "minLength": 1 },
                  "canonicalType": { "type": "string", "minLength": 1 },
                  "payload": { "$ref": "#/$defs/result" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "route", "selectors"],
          "properties": {
            "capability": { "const": "browser" },
            "route": { "type": "string", "pattern": "^/" },
            "selectors": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
