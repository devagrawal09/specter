+import { eventsFor, testSliceImplementation } from "@specter-ts/core/testing";
+
+import type { StringListReadState, StringListWriteState } from "@karakeep/db";
+import type { SliceStoreAdapter } from "@specter-ts/core";
+
+import { createAddBookmarkToList } from "./add-bookmark-to-list/impl";
+import { bookmarkListEventDefinitions } from "./events";
+import { createProjectBookmarkListMembership } from "./project-bookmark-list-membership/impl";
+
+function scenarioStore() {
+  let states = new Map<string, { values: string[]; order: number }>();
+  const store: SliceStoreAdapter<StringListWriteState, StringListReadState> = {
+    async get(sliceName) {
+      const state = states.get(sliceName) ?? { values: [], order: 0 };
+      const staged = [...state.values];
+      return {
+        write: {
+          append: async (value) => {
+            staged.push(value);
+          },
+        },
+        read: { values: async () => [...staged] },
+        lastAppliedOrder: async () => state.order,
+        setLastAppliedOrder: async (order) => {
+          states.set(sliceName, { values: [...staged], order });
+        },
+      };
+    },
+    async transaction(sliceName, run) {
+      return run(await store.get(sliceName));
+    },
+  };
+  return {
+    store,
+    reset: async <T>(run: () => Promise<T>) => {
+      states = new Map();
+      return run();
+    },
+  };
+}
+
+const commandState = scenarioStore();
+const command = createAddBookmarkToList(commandState.store);
+testSliceImplementation(command, {
+  events: eventsFor(command, bookmarkListEventDefinitions),
+  runScenario: commandState.reset,
+});
+
+const reactionState = scenarioStore();
+const reaction = createProjectBookmarkListMembership(
+  reactionState.store,
+  async () => undefined,
+);
+testSliceImplementation(reaction, {
+  events: eventsFor(reaction, bookmarkListEventDefinitions),
+  runScenario: reactionState.reset,
+});
