+import { createEventDefinition } from "@specter-ts/core";
+import { z } from "zod";
+
+const membershipSchema = z.object({
+  bookmarkId: z.string().min(1),
+  listMembershipId: z.string().min(1).nullable(),
+  addedAt: z.string().datetime(),
+});
+
+export const bookmarkListBootstrappedSchema = z.object({
+  listId: z.string().min(1),
+  listType: z.enum(["manual", "smart"]),
+  memberships: z.array(membershipSchema),
+});
+
+export const bookmarkListBootstrappedEvent = createEventDefinition(
+  "bookmark-list-bootstrapped",
+  bookmarkListBootstrappedSchema,
+);
+
+export const bookmarkAddedToListSchema = z.object({
+  additionId: z.string().min(1),
+  listId: z.string().min(1),
+  bookmarkId: z.string().min(1),
+  bookmarkUserId: z.string().min(1),
+  listMembershipId: z.string().min(1).nullable(),
+  addedAt: z.string().datetime(),
+});
+
+export const bookmarkAddedToListEvent = createEventDefinition(
+  "bookmark-added-to-list",
+  bookmarkAddedToListSchema,
+);
+
+export const bookmarkListMembershipUnchangedEvent = createEventDefinition(
+  "bookmark-list-membership-unchanged",
+  z.object({
+    listId: z.string().min(1),
+    bookmarkId: z.string().min(1),
+    observedAt: z.string().datetime(),
+  }),
+);
+
+export const bookmarkListEventDefinitions = [
+  bookmarkListBootstrappedEvent,
+  bookmarkAddedToListEvent,
+  bookmarkListMembershipUnchangedEvent,
+] as const;
