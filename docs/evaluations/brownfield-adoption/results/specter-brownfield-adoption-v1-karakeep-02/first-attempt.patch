+import { z } from "zod";
+
+import type { StringListReadState, StringListWriteState } from "@karakeep/db";
+import type { SliceStoreAdapter } from "@specter-ts/core";
+
+import {
+  bookmarkAddedToListEvent,
+  bookmarkListBootstrappedEvent,
+  bookmarkListBootstrappedSchema,
+  bookmarkListMembershipUnchangedEvent,
+} from "../events";
+import { addBookmarkToListSpec } from "./spec";
+
+type BookmarkListStore = SliceStoreAdapter<
+  StringListWriteState,
+  StringListReadState
+>;
+
+const inputSchema = z.object({
+  additionId: z.string().min(1),
+  listId: z.string().min(1),
+  bookmarkId: z.string().min(1),
+  bookmarkUserId: z.string().min(1),
+  listMembershipId: z.string().min(1).nullable(),
+  addedAt: z.string().datetime(),
+  membershipPresent: z.boolean(),
+});
+
+export function createAddBookmarkToList(store: BookmarkListStore) {
+  return addBookmarkToListSpec
+    .inputSchema(inputSchema)
+    .store(store)
+    .apply(bookmarkListBootstrappedEvent, async (event, state) => {
+      await state.append(JSON.stringify(event));
+    })
+    .apply(bookmarkAddedToListEvent, async (event, state) => {
+      await state.append(JSON.stringify(event));
+    })
+    .handle(async (command, state) => {
+      const facts = (await state.values()).map(
+        (value) => JSON.parse(value) as { type: string; payload: unknown },
+      );
+      const bootstrapped = facts
+        .filter((fact) => fact.type === bookmarkListBootstrappedEvent.type)
+        .map(
+          (fact) =>
+            fact.payload as z.infer<typeof bookmarkListBootstrappedSchema>,
+        )
+        .find((list) => list.listId === command.listId);
+
+      if (!bootstrapped) {
+        throw new Error(`List ${command.listId} was not bootstrapped`);
+      }
+      if (bootstrapped.listType === "smart") {
+        throw new Error("Smart lists cannot be added to");
+      }
+      if (command.membershipPresent) {
+        return [
+          bookmarkListMembershipUnchangedEvent.create({
+            listId: command.listId,
+            bookmarkId: command.bookmarkId,
+            observedAt: command.addedAt,
+          }),
+        ];
+      }
+      return [
+        bookmarkAddedToListEvent.create({
+          additionId: command.additionId,
+          listId: command.listId,
+          bookmarkId: command.bookmarkId,
+          bookmarkUserId: command.bookmarkUserId,
+          listMembershipId: command.listMembershipId,
+          addedAt: command.addedAt,
+        }),
+      ];
+    });
+}
