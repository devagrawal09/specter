@@ -0,0 +1,116 @@
+import { and, eq } from "drizzle-orm";
+import { beforeEach, describe, expect, test } from "vitest";
+
+import { bookmarksInLists } from "@karakeep/db/schema";
+import { BookmarkTypes } from "@karakeep/shared/types/bookmarks";
+
+import type { CustomTestContext } from "../../testUtils";
+import { defaultBeforeEach } from "../../testUtils";
+import { createBookmarkListSpecterApp } from "./runtime";
+
+beforeEach<CustomTestContext>(defaultBeforeEach(true));
+
+describe("bookmark-list Specter runtime", () => {
+  test<CustomTestContext>("bootstraps legacy state, replays its projection after restart, and preserves the reader", async ({
+    apiCallers,
+    db,
+  }) => {
+    const api = apiCallers[0];
+    const bookmark = await api.bookmarks.createBookmark({
+      type: BookmarkTypes.TEXT,
+      text: "Replay bookmark",
+    });
+    const list = await api.lists.create({
+      name: "Replay list",
+      type: "manual",
+      icon: "📚",
+    });
+
+    const bootstrap = await createBookmarkListSpecterApp(db);
+    await bootstrap.close();
+    const sqlite = db.$client;
+    const bootstrapCount = (
+      sqlite
+        .prepare(
+          "SELECT count(*) AS count FROM specter_events WHERE type = 'bookmark-list-bootstrapped'",
+        )
+        .get() as { count: number }
+    ).count;
+    expect(bootstrapCount).toBe(
+      await db.query.bookmarkLists.findMany().then((lists) => lists.length),
+    );
+
+    await api.lists.addToList({ listId: list.id, bookmarkId: bookmark.id });
+    sqlite
+      .prepare(
+        "DELETE FROM specter_slice_state WHERE slice_name = 'projectBookmarkListMembership'",
+      )
+      .run();
+    await db
+      .delete(bookmarksInLists)
+      .where(
+        and(
+          eq(bookmarksInLists.listId, list.id),
+          eq(bookmarksInLists.bookmarkId, bookmark.id),
+        ),
+      );
+
+    const restarted = await createBookmarkListSpecterApp(db);
+    const execution = await restarted.app.command({
+      type: "addBookmarkToList",
+      payload: {
+        additionId: "replay-trigger",
+        listId: list.id,
+        bookmarkId: bookmark.id,
+        bookmarkUserId: (await api.users.whoami()).id,
+        listMembershipId: null,
+        addedAt: "2026-07-18T12:00:00.000Z",
+        membershipPresent: true,
+      },
+    });
+    await execution.reactions;
+    await restarted.close();
+
+    expect(
+      (await api.lists.getListsOfBookmark({ bookmarkId: bookmark.id })).lists
+        .map((entry) => entry.id)
+        .includes(list.id),
+    ).toBe(true);
+  });
+
+  test<CustomTestContext>("rejects malformed transport input without committing an Event", async ({
+    apiCallers,
+    db,
+  }) => {
+    const api = apiCallers[0];
+    const bookmark = await api.bookmarks.createBookmark({
+      type: BookmarkTypes.TEXT,
+      text: "Invalid transport bookmark",
+    });
+    const runtime = await createBookmarkListSpecterApp(db);
+    await runtime.close();
+    const before = (
+      db.$client
+        .prepare("SELECT count(*) AS count FROM specter_events")
+        .get() as {
+        count: number;
+      }
+    ).count;
+
+    await expect(
+      api.lists.addToList({
+        listId: 42 as unknown as string,
+        bookmarkId: bookmark.id,
+      }),
+    ).rejects.toThrow();
+
+    const after = (
+      db.$client
+        .prepare("SELECT count(*) AS count FROM specter_events")
+        .get() as {
+        count: number;
+      }
+    ).count;
+    expect(after).toBe(before);
+  });
+});
diff --git a/packages/trpc/features/bookmark-lists/runtime.ts b/packages/trpc/features/bookmark-lists/runtime.ts
new file mode 100644
index 0000000..b6fe402
--- /dev/null
+++ b/packages/trpc/features/bookmark-lists/runtime.ts
@@ -0,0 +1,154 @@
+import { randomUUID } from "node:crypto";
+import { and, asc, eq } from "drizzle-orm";
+
+import {
+  createKarakeepEventLog,
+  createKarakeepAppReactionRuntime,
+  createKarakeepSliceStore,
+} from "@karakeep/db";
+import type { DB } from "@karakeep/db";
+import { bookmarkLists, bookmarksInLists } from "@karakeep/db/schema";
+import { createSpecterApp } from "@specter-ts/core";
+import type { EventLogAdapter, ReactionScheduler } from "@specter-ts/core";
+
+import { RuleEngine } from "../../lib/ruleEngine";
+import { createAddBookmarkToList } from "./add-bookmark-to-list/impl";
+import {
+  bookmarkListBootstrappedEvent,
+  bookmarkListEventDefinitions,
+} from "./events";
+import { createProjectBookmarkListMembership } from "./project-bookmark-list-membership/impl";
+
+type SqliteClient = Parameters<typeof createKarakeepEventLog>[0];
+
+function rawClient(db: DB): SqliteClient {
+  return (db as DB & { $client: SqliteClient }).$client;
+}
+
+const immediateSerializedScheduler: ReactionScheduler = (run) => {
+  let tail = Promise.resolve();
+  return () => {
+    const context = {
+      deliveryId: randomUUID(),
+      scheduledAt: new Date().toISOString(),
+      attemptId: randomUUID(),
+      attemptNumber: 1,
+    };
+    const completion = (tail = tail.then(() => run(context)));
+    return () => completion;
+  };
+};
+
+async function bootstrapBookmarkLists(db: DB, eventLog: EventLogAdapter) {
+  const lists = await db
+    .select({ id: bookmarkLists.id, type: bookmarkLists.type })
+    .from(bookmarkLists)
+    .orderBy(asc(bookmarkLists.id));
+  const memberships = await db
+    .select({
+      listId: bookmarksInLists.listId,
+      bookmarkId: bookmarksInLists.bookmarkId,
+      listMembershipId: bookmarksInLists.listMembershipId,
+      addedAt: bookmarksInLists.addedAt,
+    })
+    .from(bookmarksInLists)
+    .orderBy(asc(bookmarksInLists.listId), asc(bookmarksInLists.bookmarkId));
+
+  for (const list of lists) {
+    const idempotencyKey = `karakeep-bookmark-list-bootstrap:${list.id}`;
+    if (await eventLog.findCommit(idempotencyKey)) continue;
+    const payload = {
+      listId: list.id,
+      listType: list.type,
+      memberships: memberships
+        .filter((membership) => membership.listId === list.id)
+        .map((membership) => ({
+          bookmarkId: membership.bookmarkId,
+          listMembershipId: membership.listMembershipId,
+          addedAt: (membership.addedAt ?? new Date(0)).toISOString(),
+        })),
+    } as const;
+    const fingerprint = JSON.stringify(payload);
+    await eventLog.append([bookmarkListBootstrappedEvent.create(payload)], {
+      idempotencyKey,
+      fingerprint,
+    });
+  }
+}
+
+export async function createBookmarkListSpecterApp(db: DB) {
+  const sqlite = rawClient(db);
+  const eventLog = createKarakeepEventLog(sqlite);
+  const store = createKarakeepSliceStore(sqlite);
+  await bootstrapBookmarkLists(db, eventLog);
+
+  const durableReactions = createKarakeepAppReactionRuntime(sqlite);
+
+  const command = createAddBookmarkToList(store);
+  const projection = createProjectBookmarkListMembership(
+    store,
+    async (addition) => {
+      const inserted = await db
+        .insert(bookmarksInLists)
+        .values({
+          listId: addition.listId,
+          bookmarkId: addition.bookmarkId,
+          listMembershipId: addition.listMembershipId,
+          addedAt: new Date(addition.addedAt),
+        })
+        .onConflictDoNothing()
+        .returning({ bookmarkId: bookmarksInLists.bookmarkId });
+      if (inserted.length === 0) return;
+      await RuleEngine.triggerOnEvent(
+        addition.bookmarkUserId,
+        addition.bookmarkId,
+        [{ type: "addedToList", listId: addition.listId }],
+        { idempotencyKey: `specter-list-addition:${addition.additionId}` },
+        db,
+      );
+    },
+  );
+
+  const app = await createSpecterApp({
+    events: bookmarkListEventDefinitions,
+    eventLog,
+    schedule: durableReactions?.schedule ?? immediateSerializedScheduler,
+    slices: [command, projection],
+  });
+  return {
+    app,
+    close: () => durableReactions?.close() ?? Promise.resolve(),
+  };
+}
+
+export async function membershipBoundaryData(
+  db: DB,
+  listId: string,
+  bookmarkId: string,
+  actorId: string,
+) {
+  const [bookmark, membership, collaborator] = await Promise.all([
+    db.query.bookmarks.findFirst({
+      where: (table, { eq }) => eq(table.id, bookmarkId),
+      columns: { userId: true },
+    }),
+    db.query.bookmarksInLists.findFirst({
+      where: and(
+        eq(bookmarksInLists.listId, listId),
+        eq(bookmarksInLists.bookmarkId, bookmarkId),
+      ),
+      columns: { bookmarkId: true },
+    }),
+    db.query.listCollaborators.findFirst({
+      where: (table, { and, eq }) =>
+        and(eq(table.listId, listId), eq(table.userId, actorId)),
+      columns: { id: true },
+    }),
+  ]);
+  if (!bookmark) throw new Error(`Bookmark not found: ${bookmarkId}`);
+  return {
+    bookmarkUserId: bookmark.userId,
+    listMembershipId: collaborator?.id ?? null,
+    membershipPresent: Boolean(membership),
+  };
+}
