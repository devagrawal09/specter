@@ -0,0 +1,574 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { randomUUID } from "node:crypto";
+import path from "node:path";
+
+import Database from "better-sqlite3";
+
+import {
+  SpecterIdempotencyConflictError,
+  SpecterVersionConflictError,
+} from "@specter-ts/core";
+import type {
+  EventDraft,
+  EventLogAdapter,
+  EventLogAppendOptions,
+  EventLogAppendResult,
+  EventLogCommit,
+  EventLogTransaction,
+  PersistedEvent,
+  ReactionDeliveryContext,
+  ReactionScheduler,
+  SliceStore,
+  SliceStoreAdapter,
+} from "@specter-ts/core";
+
+type Sqlite = InstanceType<typeof Database>;
+
+interface EventTransactionScope {
+  afterRollback: (() => void)[];
+}
+const eventTransactionScope = new AsyncLocalStorage<EventTransactionScope>();
+let eventTransactionTail: Promise<void> = Promise.resolve();
+
+function serializeEventTransaction<T>(run: () => Promise<T>): Promise<T> {
+  if (eventTransactionScope.getStore()) return run();
+  const previous = eventTransactionTail;
+  let release: () => void;
+  const current = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  eventTransactionTail = previous.then(() => current);
+  return previous.then(async () => {
+    try {
+      return await eventTransactionScope.run({ afterRollback: [] }, run);
+    } finally {
+      release();
+    }
+  });
+}
+
+export function prepareSpecterPersistence(sqlite: Sqlite): void {
+  sqlite.exec(`
+    CREATE TABLE IF NOT EXISTS specter_events (
+      event_order INTEGER PRIMARY KEY AUTOINCREMENT,
+      id TEXT NOT NULL UNIQUE,
+      type TEXT NOT NULL,
+      payload TEXT NOT NULL,
+      recorded_at TEXT NOT NULL
+    );
+    CREATE INDEX IF NOT EXISTS specter_events_type_order_idx
+      ON specter_events(type, event_order);
+    CREATE TABLE IF NOT EXISTS specter_event_commits (
+      idempotency_key TEXT PRIMARY KEY,
+      fingerprint TEXT,
+      first_event_order INTEGER NOT NULL,
+      last_event_order INTEGER NOT NULL,
+      committed_at TEXT NOT NULL
+    );
+    CREATE TABLE IF NOT EXISTS specter_slice_state (
+      slice_name TEXT PRIMARY KEY,
+      state_json TEXT NOT NULL,
+      last_applied_order INTEGER NOT NULL DEFAULT 0
+    );
+  `);
+}
+
+export function createKarakeepEventLog(sqlite: Sqlite): EventLogAdapter {
+  prepareSpecterPersistence(sqlite);
+
+  const fromRow = (row: Record<string, unknown>): PersistedEvent => ({
+    id: String(row.id),
+    order: Number(row.event_order),
+    type: String(row.type),
+    payload: JSON.parse(String(row.payload)) as unknown,
+    recordedAt: String(row.recorded_at),
+  });
+
+  const query = async (afterOrder: number, eventTypes: readonly string[]) => {
+    if (eventTypes.length === 0) return [];
+    const placeholders = eventTypes.map(() => "?").join(", ");
+    return sqlite
+      .prepare(
+        `SELECT id, event_order, type, payload, recorded_at
+           FROM specter_events
+          WHERE event_order > ? AND type IN (${placeholders})
+          ORDER BY event_order ASC`,
+      )
+      .all(afterOrder, ...eventTypes)
+      .map((row) => fromRow(row as Record<string, unknown>));
+  };
+
+  const currentVersion = async () => {
+    const row = sqlite
+      .prepare(
+        "SELECT COALESCE(MAX(event_order), 0) AS version FROM specter_events",
+      )
+      .get() as { version: number };
+    return Number(row.version);
+  };
+
+  const findCommit = async (
+    idempotencyKey: string,
+  ): Promise<EventLogCommit | undefined> => {
+    const receipt = sqlite
+      .prepare(
+        `SELECT fingerprint, first_event_order, last_event_order
+           FROM specter_event_commits WHERE idempotency_key = ?`,
+      )
+      .get(idempotencyKey) as
+      | {
+          fingerprint: string | null;
+          first_event_order: number;
+          last_event_order: number;
+        }
+      | undefined;
+    if (!receipt) return undefined;
+    const rows = sqlite
+      .prepare(
+        `SELECT id, event_order, type, payload, recorded_at
+           FROM specter_events
+          WHERE event_order BETWEEN ? AND ? ORDER BY event_order ASC`,
+      )
+      .all(receipt.first_event_order, receipt.last_event_order);
+    return {
+      events: rows.map((row) => fromRow(row as Record<string, unknown>)),
+      version: receipt.last_event_order,
+      idempotencyKey,
+      fingerprint: receipt.fingerprint ?? undefined,
+    };
+  };
+
+  const appendUnlocked = async (
+    drafts: readonly EventDraft[],
+    options: EventLogAppendOptions = {},
+  ): Promise<EventLogAppendResult> => {
+    if (options.idempotencyKey) {
+      const existing = await findCommit(options.idempotencyKey);
+      if (existing) {
+        if (existing.fingerprint !== options.fingerprint) {
+          throw new SpecterIdempotencyConflictError(options.idempotencyKey);
+        }
+        return { ...existing, duplicate: true };
+      }
+    }
+    if (drafts.length === 0) {
+      throw new Error("Event Log append requires at least one Event");
+    }
+    const version = await currentVersion();
+    if (
+      options.expectedVersion !== undefined &&
+      options.expectedVersion !== version
+    ) {
+      throw new SpecterVersionConflictError(options.expectedVersion, version);
+    }
+    const events: PersistedEvent[] = [];
+    const insert = sqlite.prepare(
+      "INSERT INTO specter_events (id, type, payload, recorded_at) VALUES (?, ?, ?, ?)",
+    );
+    for (const draft of drafts) {
+      const payload = JSON.stringify(draft.payload);
+      if (payload === undefined) {
+        throw new Error("SQLite Event payload must be JSON-serializable");
+      }
+      const id = randomUUID();
+      const recordedAt = new Date().toISOString();
+      const result = insert.run(id, draft.type, payload, recordedAt);
+      events.push({
+        ...draft,
+        id,
+        order: Number(result.lastInsertRowid),
+        recordedAt,
+      });
+    }
+    const committedVersion = events.at(-1)?.order ?? version;
+    if (options.idempotencyKey) {
+      sqlite
+        .prepare(
+          `INSERT INTO specter_event_commits
+             (idempotency_key, fingerprint, first_event_order, last_event_order, committed_at)
+           VALUES (?, ?, ?, ?, ?)`,
+        )
+        .run(
+          options.idempotencyKey,
+          options.fingerprint ?? null,
+          events[0]?.order,
+          committedVersion,
+          new Date().toISOString(),
+        );
+    }
+    return {
+      events,
+      version: committedVersion,
+      idempotencyKey: options.idempotencyKey,
+      fingerprint: options.fingerprint,
+      duplicate: false,
+    };
+  };
+
+  const transaction = async <T>(
+    run: (eventLog: EventLogTransaction) => Promise<T>,
+  ): Promise<T> =>
+    serializeEventTransaction(async () => {
+      sqlite.exec("BEGIN IMMEDIATE");
+      try {
+        const result = await run(transactionApi);
+        sqlite.exec("COMMIT");
+        return result;
+      } catch (error) {
+        if (sqlite.inTransaction) sqlite.exec("ROLLBACK");
+        for (const repair of eventTransactionScope.getStore()?.afterRollback ??
+          []) {
+          sqlite.transaction(repair)();
+        }
+        throw error;
+      }
+    });
+
+  const transactionApi: EventLogTransaction = {
+    query,
+    currentVersion,
+    findCommit,
+    append: appendUnlocked,
+  };
+
+  return {
+    ...transactionApi,
+    append: (drafts, options) =>
+      eventTransactionScope.getStore()
+        ? appendUnlocked(drafts, options)
+        : transaction(() => appendUnlocked(drafts, options)),
+    transaction,
+  };
+}
+
+export interface StringListWriteState {
+  append(value: string): Promise<void>;
+}
+
+export interface StringListReadState {
+  values(): Promise<readonly string[]>;
+}
+
+export function createKarakeepSliceStore(
+  sqlite: Sqlite,
+): SliceStoreAdapter<StringListWriteState, StringListReadState> {
+  prepareSpecterPersistence(sqlite);
+
+  function load(sliceName: string) {
+    const row = sqlite
+      .prepare(
+        "SELECT state_json, last_applied_order FROM specter_slice_state WHERE slice_name = ?",
+      )
+      .get(sliceName) as
+      | { state_json: string; last_applied_order: number }
+      | undefined;
+    return row
+      ? {
+          values: JSON.parse(row.state_json) as string[],
+          order: Number(row.last_applied_order),
+        }
+      : { values: [] as string[], order: 0 };
+  }
+
+  function createStore(
+    sliceName: string,
+    deferPublish: boolean,
+  ): SliceStore<StringListWriteState, StringListReadState> & {
+    publish(): void;
+  } {
+    const initial = load(sliceName);
+    const staged = [...initial.values];
+    let nextOrder = initial.order;
+    let cursorWasSet = false;
+    const publish = () => {
+      if (!cursorWasSet) return;
+      const current = load(sliceName);
+      if (nextOrder < current.order) return;
+      sqlite
+        .prepare(
+          `INSERT INTO specter_slice_state (slice_name, state_json, last_applied_order)
+           VALUES (?, ?, ?)
+           ON CONFLICT(slice_name) DO UPDATE SET
+             state_json = excluded.state_json,
+             last_applied_order = max(specter_slice_state.last_applied_order, excluded.last_applied_order)`,
+        )
+        .run(sliceName, JSON.stringify(staged), nextOrder);
+    };
+    const publishAndRemember = () => {
+      const eventScope = eventTransactionScope.getStore();
+      if (eventScope) eventScope.afterRollback.push(publish);
+      publish();
+    };
+    return {
+      write: {
+        append: async (value) => {
+          staged.push(value);
+        },
+      },
+      read: {
+        values: async () => [...staged],
+      },
+      lastAppliedOrder: async () => initial.order,
+      setLastAppliedOrder: async (order) => {
+        nextOrder = Math.max(nextOrder, order);
+        cursorWasSet = true;
+        if (!deferPublish) sqlite.transaction(publishAndRemember)();
+      },
+      publish,
+    };
+  }
+
+  return {
+    get: async (sliceName) => createStore(sliceName, false),
+    transaction: async (sliceName, run) => {
+      const store = createStore(sliceName, true);
+      const result = await run(store);
+      const eventScope = eventTransactionScope.getStore();
+      if (eventScope) eventScope.afterRollback.push(store.publish);
+      sqlite.transaction(store.publish)();
+      return result;
+    },
+  };
+}
+
+type DeliveryStatus = "pending" | "running" | "completed" | "dead-letter";
+
+export interface KarakeepReactionDelivery {
+  deliveryId: string;
+  status: DeliveryStatus;
+  scheduledAt: string;
+  attemptIds: string[];
+  attemptCount: number;
+  lastError?: string;
+}
+
+export interface KarakeepReactionRuntime {
+  schedule: ReactionScheduler;
+  close(options?: { crash?: boolean }): Promise<void>;
+}
+
+export function prepareKarakeepReactionScheduler(sqlite: Sqlite): void {
+  sqlite.exec(`
+    CREATE TABLE IF NOT EXISTS specter_reaction_deliveries (
+      delivery_id TEXT PRIMARY KEY,
+      status TEXT NOT NULL CHECK(status IN ('pending','running','completed','dead-letter')),
+      scheduled_at TEXT NOT NULL,
+      available_at INTEGER NOT NULL,
+      lease_expires_at INTEGER,
+      attempt_count INTEGER NOT NULL DEFAULT 0,
+      attempt_ids TEXT NOT NULL DEFAULT '[]',
+      last_error TEXT
+    );
+  `);
+}
+
+export function createKarakeepReactionRuntime(
+  sqlite: Sqlite,
+  options: { maxAttempts?: number; leaseMs?: number } = {},
+): KarakeepReactionRuntime {
+  prepareKarakeepReactionScheduler(sqlite);
+  const maxAttempts = options.maxAttempts ?? 3;
+  const leaseMs = options.leaseMs ?? 1;
+  let active: Promise<void> | undefined;
+  let queued = false;
+  let crashed = false;
+
+  const enqueue = () => {
+    const deliveryId = randomUUID();
+    const scheduledAt = new Date().toISOString();
+    sqlite
+      .prepare(
+        `INSERT INTO specter_reaction_deliveries
+          (delivery_id, status, scheduled_at, available_at)
+         VALUES (?, 'pending', ?, ?)`,
+      )
+      .run(deliveryId, scheduledAt, Date.now());
+  };
+
+  const drain = async (
+    run: (context: ReactionDeliveryContext) => Promise<void>,
+  ) => {
+    const failures: unknown[] = [];
+    do {
+      queued = false;
+      sqlite
+        .prepare(
+          `UPDATE specter_reaction_deliveries
+              SET status = 'pending', lease_expires_at = NULL,
+                  last_error = 'Reaction attempt lease expired'
+            WHERE status = 'running' AND lease_expires_at <= ?`,
+        )
+        .run(Date.now());
+      let row = sqlite
+        .prepare(
+          `SELECT delivery_id, scheduled_at, attempt_count, attempt_ids
+             FROM specter_reaction_deliveries
+            WHERE status = 'pending' AND available_at <= ?
+            ORDER BY available_at, scheduled_at, delivery_id LIMIT 1`,
+        )
+        .get(Date.now()) as
+        | {
+            delivery_id: string;
+            scheduled_at: string;
+            attempt_count: number;
+            attempt_ids: string;
+          }
+        | undefined;
+      while (row && !crashed) {
+        let completed = false;
+        while (!completed && !crashed) {
+          const attemptNumber: number = Number(row.attempt_count) + 1;
+          const attemptId = randomUUID();
+          const attemptIds: string[] = [
+            ...(JSON.parse(row.attempt_ids) as string[]),
+            attemptId,
+          ];
+          sqlite
+            .prepare(
+              `UPDATE specter_reaction_deliveries
+                  SET status = 'running', attempt_count = ?, attempt_ids = ?,
+                      lease_expires_at = ?
+                WHERE delivery_id = ?`,
+            )
+            .run(
+              attemptNumber,
+              JSON.stringify(attemptIds),
+              Date.now() + leaseMs,
+              row.delivery_id,
+            );
+          try {
+            await run({
+              deliveryId: row.delivery_id,
+              scheduledAt: row.scheduled_at,
+              attemptId,
+              attemptNumber,
+            });
+            if (crashed) break;
+            sqlite
+              .prepare(
+                `UPDATE specter_reaction_deliveries
+                    SET status = 'completed', lease_expires_at = NULL, last_error = NULL
+                  WHERE delivery_id = ?`,
+              )
+              .run(row.delivery_id);
+            completed = true;
+          } catch (error) {
+            if (crashed) break;
+            const message =
+              error instanceof Error ? error.message : String(error);
+            if (attemptNumber >= maxAttempts) {
+              sqlite
+                .prepare(
+                  `UPDATE specter_reaction_deliveries
+                      SET status = 'dead-letter', lease_expires_at = NULL, last_error = ?
+                    WHERE delivery_id = ?`,
+                )
+                .run(message, row.delivery_id);
+              failures.push(error);
+              completed = true;
+            } else {
+              sqlite
+                .prepare(
+                  `UPDATE specter_reaction_deliveries
+                      SET status = 'pending', lease_expires_at = NULL, last_error = ?
+                    WHERE delivery_id = ?`,
+                )
+                .run(message, row.delivery_id);
+              row = {
+                ...row,
+                attempt_count: attemptNumber,
+                attempt_ids: JSON.stringify(attemptIds),
+              };
+            }
+          }
+        }
+        row = sqlite
+          .prepare(
+            `SELECT delivery_id, scheduled_at, attempt_count, attempt_ids
+               FROM specter_reaction_deliveries
+              WHERE status = 'pending' AND available_at <= ?
+              ORDER BY available_at, scheduled_at, delivery_id LIMIT 1`,
+          )
+          .get(Date.now()) as typeof row;
+      }
+      if (queued && !crashed) enqueue();
+    } while (queued && !crashed);
+    if (failures.length > 0) throw failures[0];
+  };
+
+  const schedule: ReactionScheduler = (run) => () => {
+    if (active) {
+      queued = true;
+    } else {
+      enqueue();
+      active = drain(run).finally(() => {
+        active = undefined;
+      });
+    }
+    const completion = active;
+    return () => completion ?? Promise.resolve();
+  };
+
+  return {
+    schedule,
+    async close(closeOptions) {
+      if (closeOptions?.crash) {
+        crashed = true;
+        return;
+      }
+      await active;
+      sqlite.close();
+    },
+  };
+}
+
+export function createKarakeepAppReactionRuntime(
+  appDatabase: Sqlite,
+): KarakeepReactionRuntime | undefined {
+  if (appDatabase.name === "" || appDatabase.name === ":memory:") {
+    return undefined;
+  }
+  return createKarakeepReactionRuntime(
+    new Database(path.join(path.dirname(appDatabase.name), "queue.db")),
+  );
+}
+
+export function listKarakeepReactionDeliveries(
+  sqlite: Sqlite,
+): KarakeepReactionDelivery[] {
+  prepareKarakeepReactionScheduler(sqlite);
+  return sqlite
+    .prepare(
+      `SELECT delivery_id, status, scheduled_at, attempt_count, attempt_ids, last_error
+         FROM specter_reaction_deliveries ORDER BY scheduled_at, delivery_id`,
+    )
+    .all()
+    .map((raw) => {
+      const row = raw as Record<string, unknown>;
+      return {
+        deliveryId: String(row.delivery_id),
+        status: String(row.status) as DeliveryStatus,
+        scheduledAt: String(row.scheduled_at),
+        attemptIds: JSON.parse(String(row.attempt_ids)) as string[],
+        attemptCount: Number(row.attempt_count),
+        lastError: row.last_error == null ? undefined : String(row.last_error),
+      };
+    });
+}
+
+export function retryKarakeepDeadLetter(
+  sqlite: Sqlite,
+  deliveryId: string,
+): void {
+  const changed = sqlite
+    .prepare(
+      `UPDATE specter_reaction_deliveries
+          SET status = 'pending', available_at = ?, lease_expires_at = NULL,
+              last_error = NULL
+        WHERE delivery_id = ? AND status = 'dead-letter'`,
+    )
+    .run(Date.now(), deliveryId).changes;
+  if (changed !== 1) {
+    throw new Error(`Reaction delivery is not dead-lettered: ${deliveryId}`);
+  }
+}
