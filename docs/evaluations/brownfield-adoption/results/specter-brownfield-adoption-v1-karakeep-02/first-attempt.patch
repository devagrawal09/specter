+import { z } from "zod";
+
+import type { StringListReadState, StringListWriteState } from "@karakeep/db";
+import type { SliceStoreAdapter } from "@specter-ts/core";
+
+import { bookmarkAddedToListEvent, bookmarkAddedToListSchema } from "../events";
+import { projectBookmarkListMembershipSpec } from "./spec";
+
+type BookmarkListStore = SliceStoreAdapter<
+  StringListWriteState,
+  StringListReadState
+>;
+
+const outputSchema = bookmarkAddedToListSchema;
+
+export function createProjectBookmarkListMembership(
+  store: BookmarkListStore,
+  project: (addition: z.infer<typeof outputSchema>) => Promise<void>,
+) {
+  return projectBookmarkListMembershipSpec
+    .outputSchema(outputSchema)
+    .plugin(async () => async (output) => project(output))
+    .store(store)
+    .apply(bookmarkAddedToListEvent, async (event, state) => {
+      await state.append(JSON.stringify(event.payload));
+    })
+    .handle(async (state) => {
+      const newest = (await state.values()).at(-1);
+      return newest ? outputSchema.parse(JSON.parse(newest)) : undefined;
+    });
+}
