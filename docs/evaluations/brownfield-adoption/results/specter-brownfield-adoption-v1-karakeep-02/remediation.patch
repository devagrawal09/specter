@@ -24,6 +24,37 @@ import type {
 
 type Sqlite = InstanceType<typeof Database>;
 
+export function checkpointAndCloseKarakeepSqlite(
+  sqlite: Sqlite,
+  options: { readOnlyHandoff?: boolean } = {},
+): void {
+  if (!sqlite.open) return;
+  try {
+    const [checkpoint] = sqlite.pragma("wal_checkpoint(TRUNCATE)") as {
+      busy: number;
+      log: number;
+      checkpointed: number;
+    }[];
+    if (checkpoint && checkpoint.busy !== 0) {
+      throw new Error(
+        `SQLite WAL checkpoint remained busy with ${checkpoint.log - checkpoint.checkpointed} frame(s) outstanding`,
+      );
+    }
+    if (options.readOnlyHandoff) {
+      const journalMode = sqlite.pragma("journal_mode = DELETE", {
+        simple: true,
+      });
+      if (journalMode !== "delete") {
+        throw new Error(
+          `SQLite read-only handoff expected DELETE journal mode, received ${String(journalMode)}`,
+        );
+      }
+    }
+  } finally {
+    sqlite.close();
+  }
+}
+
 interface EventTransactionScope {
   afterRollback: (() => void)[];
 }
