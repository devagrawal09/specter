       if (closeOptions?.crash) {
         crashed = true;
+        checkpointAndCloseKarakeepSqlite(sqlite, {
+          readOnlyHandoff: options.readOnlyHandoffOnClose,
+        });
         return;
       }
-      await active;
-      sqlite.close();
+      try {
+        await active;
+      } finally {
+        checkpointAndCloseKarakeepSqlite(sqlite, {
+          readOnlyHandoff: options.readOnlyHandoffOnClose,
+        });
+      }
     },
   };
 }
