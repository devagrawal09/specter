 export function createKarakeepReactionRuntime(
   sqlite: Sqlite,
-  options: { maxAttempts?: number; leaseMs?: number } = {},
+  options: {
+    maxAttempts?: number;
+    leaseMs?: number;
+    readOnlyHandoffOnClose?: boolean;
+  } = {},
 ): KarakeepReactionRuntime {
   prepareKarakeepReactionScheduler(sqlite);
   const maxAttempts = options.maxAttempts ?? 3;
