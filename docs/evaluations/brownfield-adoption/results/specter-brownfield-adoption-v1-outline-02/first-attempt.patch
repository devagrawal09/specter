+++ b/server/specter/accessRequests/events.ts
@@ -0,0 +1,40 @@
+import { createEventDefinition } from "@specter-ts/core";
+import { z } from "zod";
+
+export const pendingAccessRequestSchema = z.object({
+  accessRequestId: z.string().uuid(),
+  documentId: z.string().uuid(),
+  userId: z.string().uuid(),
+  teamId: z.string().uuid(),
+  status: z.literal("pending"),
+  createdAt: z.string().datetime(),
+  updatedAt: z.string().datetime(),
+});
+
+export const pendingAccessRequestBootstrappedEvent = createEventDefinition(
+  "pending-access-request-bootstrapped",
+  pendingAccessRequestSchema
+);
+
+export const documentAccessRequestedSchema = pendingAccessRequestSchema.extend({
+  actorId: z.string().uuid(),
+  ip: z.string().nullable(),
+  authType: z.string().nullable(),
+});
+
+export const documentAccessRequestedEvent = createEventDefinition(
+  "document-access-requested",
+  documentAccessRequestedSchema
+);
+
+export const accessRequestEventDefinitions = [
+  pendingAccessRequestBootstrappedEvent,
+  documentAccessRequestedEvent,
+] as const;
+
+export type PendingAccessRequestPayload = z.infer<
+  typeof pendingAccessRequestSchema
+>;
+export type DocumentAccessRequestedPayload = z.infer<
+  typeof documentAccessRequestedSchema
+>;
