+import type { SliceStore, SliceStoreAdapter } from "@specter-ts/core";
+import { QueryTypes } from "sequelize";
+import type { Transaction } from "sequelize";
+import { AccessRequest, Event } from "@server/models";
+import { AccessRequestStatus } from "@server/models/AccessRequest";
+import { sequelize } from "@server/storage/database";
+import type { AuthenticationType } from "@server/types";
+import type {
+  DocumentAccessRequestedPayload,
+  PendingAccessRequestPayload,
+} from "./events";
+
+export type AccessRequestWriteState = {
+  readonly projectBootstrap: (
+    payload: PendingAccessRequestPayload
+  ) => Promise<void>;
+  readonly projectCreated: (
+    payload: DocumentAccessRequestedPayload
+  ) => Promise<void>;
+};
+
+export type AccessRequestReadState = {
+  readonly hasPending: (documentId: string, userId: string) => Promise<boolean>;
+};
+
+type Cursor = { order: number };
+
+async function loadCursor(
+  sliceName: string,
+  transaction?: Transaction,
+  lock = false
+): Promise<Cursor> {
+  const rows = await sequelize.query<{ last_applied_order: string | number }>(
+    `SELECT last_applied_order
+       FROM specter_slice_states
+      WHERE slice_name = :sliceName${lock ? " FOR UPDATE" : ""}`,
+    { replacements: { sliceName }, transaction, type: QueryTypes.SELECT }
+  );
+  return { order: Number(rows[0]?.last_applied_order ?? 0) };
+}
+
+async function saveCursor(
+  sliceName: string,
+  cursor: Cursor,
+  transaction?: Transaction
+) {
+  await sequelize.query(
+    `INSERT INTO specter_slice_states (slice_name, state_json, last_applied_order)
+     VALUES (:sliceName, '{}'::jsonb, :order)
+     ON CONFLICT (slice_name) DO UPDATE SET
+       last_applied_order = EXCLUDED.last_applied_order`,
+    { replacements: { sliceName, order: cursor.order }, transaction }
+  );
+}
+
+function toStore(
+  sliceName: string,
+  cursor: Cursor,
+  transaction?: Transaction,
+  publishOnCursor = false
+): SliceStore<AccessRequestWriteState, AccessRequestReadState> {
+  const hasPending = async (documentId: string, userId: string) =>
+    Boolean(
+      await AccessRequest.findOne({
+        where: {
+          documentId,
+          userId,
+          status: AccessRequestStatus.Pending,
+        },
+        transaction,
+      })
+    );
+
+  return {
+    write: {
+      async projectBootstrap(payload) {
+        const existing = await AccessRequest.findByPk(payload.accessRequestId, {
+          transaction,
+        });
+        if (existing) {
+          return;
+        }
+        await AccessRequest.create(
+          {
+            id: payload.accessRequestId,
+            documentId: payload.documentId,
+            userId: payload.userId,
+            teamId: payload.teamId,
+            status: AccessRequestStatus.Pending,
+            responderId: null,
+            respondedAt: null,
+            createdAt: new Date(payload.createdAt),
+            updatedAt: new Date(payload.updatedAt),
+          },
+          { transaction }
+        );
+      },
+      async projectCreated(payload) {
+        const existing = await AccessRequest.findByPk(payload.accessRequestId, {
+          transaction,
+        });
+        if (!existing) {
+          await AccessRequest.create(
+            {
+              id: payload.accessRequestId,
+              documentId: payload.documentId,
+              userId: payload.userId,
+              teamId: payload.teamId,
+              status: AccessRequestStatus.Pending,
+              responderId: null,
+              respondedAt: null,
+              createdAt: new Date(payload.createdAt),
+              updatedAt: new Date(payload.updatedAt),
+            },
+            { transaction }
+          );
+        }
+        const auditEvent = await Event.findOne({
+          where: {
+            name: "access_requests.create",
+            modelId: payload.accessRequestId,
+          },
+          transaction,
+        });
+        if (!auditEvent) {
+          await Event.create(
+            {
+              name: "access_requests.create",
+              modelId: payload.accessRequestId,
+              documentId: payload.documentId,
+              userId: payload.userId,
+              teamId: payload.teamId,
+              actorId: payload.actorId,
+              ip: payload.ip,
+              authType: payload.authType as AuthenticationType | null,
+              data: null,
+              changes: null,
+              createdAt: new Date(payload.createdAt),
+            },
+            { transaction }
+          );
+        }
+      },
+    },
+    read: { hasPending },
+    lastAppliedOrder: async () => cursor.order,
+    setLastAppliedOrder: async (order) => {
+      if (!Number.isInteger(order) || order < cursor.order) {
+        throw new Error(
+          `Slice cursor cannot move from ${cursor.order} to ${order}`
+        );
+      }
+      cursor.order = order;
+      if (publishOnCursor) {
+        await saveCursor(sliceName, cursor, transaction);
+      }
+    },
+  };
+}
+
+export const accessRequestSliceStore: SliceStoreAdapter<
+  AccessRequestWriteState,
+  AccessRequestReadState
+> = {
+  async get(sliceName) {
+    const cursor = await loadCursor(sliceName);
+    return toStore(sliceName, cursor, undefined, true);
+  },
+  transaction(sliceName, run) {
+    return sequelize.transaction(async (transaction) => {
+      await sequelize.query(
+        `INSERT INTO specter_slice_states (slice_name, state_json, last_applied_order)
+         VALUES (:sliceName, '{}'::jsonb, 0)
+         ON CONFLICT (slice_name) DO NOTHING`,
+        { replacements: { sliceName }, transaction }
+      );
+      const cursor = await loadCursor(sliceName, transaction, true);
+      const result = await run(toStore(sliceName, cursor, transaction));
+      await saveCursor(sliceName, cursor, transaction);
+      return result;
+    });
+  },
+};
diff --git a/server/specter/eventLog.ts b/server/specter/eventLog.ts
new file mode 100644
index 0000000..38b4944
--- /dev/null
+++ b/server/specter/eventLog.ts
@@ -0,0 +1,252 @@
+import { randomUUID } from "node:crypto";
+import type {
+  EventDraft,
+  EventLogAdapter,
+  EventLogAppendOptions,
+  EventLogAppendResult,
+  EventLogCommit,
+  EventLogTransaction,
+  PersistedEvent,
+} from "@specter-ts/core";
+import {
+  SpecterIdempotencyConflictError,
+  SpecterVersionConflictError,
+} from "@specter-ts/core";
+import { QueryTypes } from "sequelize";
+import type { Sequelize, Transaction } from "sequelize";
+
+const advisoryLock = 4213501;
+let activeSequelize: Sequelize;
+
+type EventRow = {
+  id: string;
+  event_order: string | number;
+  type: string;
+  payload: unknown;
+  recorded_at: Date | string;
+};
+
+type CommitRow = {
+  fingerprint: string | null;
+  first_event_order: string | number;
+  last_event_order: string | number;
+};
+
+function eventFromRow(row: EventRow): PersistedEvent {
+  return {
+    id: row.id,
+    order: Number(row.event_order),
+    type: row.type,
+    payload: row.payload,
+    recordedAt: new Date(row.recorded_at).toISOString(),
+  };
+}
+
+export async function prepareSpecterEventLog(
+  sequelize: Sequelize
+): Promise<void> {
+  activeSequelize = sequelize;
+  await sequelize.query(`CREATE TABLE IF NOT EXISTS specter_events (
+    event_order BIGSERIAL PRIMARY KEY,
+    id UUID NOT NULL UNIQUE,
+    type TEXT NOT NULL,
+    payload JSONB NOT NULL,
+    recorded_at TIMESTAMPTZ NOT NULL
+  )`);
+  await sequelize.query(`CREATE INDEX IF NOT EXISTS specter_events_type_order_idx
+    ON specter_events(type, event_order)`);
+  await sequelize.query(`CREATE TABLE IF NOT EXISTS specter_event_commits (
+    idempotency_key TEXT PRIMARY KEY,
+    fingerprint TEXT,
+    first_event_order BIGINT NOT NULL,
+    last_event_order BIGINT NOT NULL,
+    committed_at TIMESTAMPTZ NOT NULL
+  )`);
+}
+
+async function queryEvents(
+  afterOrder: number,
+  eventTypes: readonly string[],
+  transaction?: Transaction
+): Promise<PersistedEvent[]> {
+  if (!eventTypes.length) {
+    return [];
+  }
+  const rows = await activeSequelize.query<EventRow>(
+    `SELECT id, event_order, type, payload, recorded_at
+       FROM specter_events
+      WHERE event_order > :afterOrder AND type IN (:eventTypes)
+      ORDER BY event_order ASC`,
+    {
+      replacements: { afterOrder, eventTypes: [...eventTypes] },
+      transaction,
+      type: QueryTypes.SELECT,
+    }
+  );
+  return rows.map(eventFromRow);
+}
+
+async function currentVersion(transaction?: Transaction): Promise<number> {
+  const rows = await activeSequelize.query<{ version: string | number }>(
+    "SELECT COALESCE(MAX(event_order), 0) AS version FROM specter_events",
+    { transaction, type: QueryTypes.SELECT }
+  );
+  return Number(rows[0]?.version ?? 0);
+}
+
+async function findCommit(
+  idempotencyKey: string,
+  transaction?: Transaction
+): Promise<EventLogCommit | undefined> {
+  const receipts = await activeSequelize.query<CommitRow>(
+    `SELECT fingerprint, first_event_order, last_event_order
+       FROM specter_event_commits
+      WHERE idempotency_key = :idempotencyKey`,
+    {
+      replacements: { idempotencyKey },
+      transaction,
+      type: QueryTypes.SELECT,
+    }
+  );
+  const receipt = receipts[0];
+  if (!receipt) {
+    return undefined;
+  }
+  const firstOrder = Number(receipt.first_event_order);
+  const version = Number(receipt.last_event_order);
+  const rows = await activeSequelize.query<EventRow>(
+    `SELECT id, event_order, type, payload, recorded_at
+       FROM specter_events
+      WHERE event_order BETWEEN :firstOrder AND :version
+      ORDER BY event_order ASC`,
+    {
+      replacements: { firstOrder, version },
+      transaction,
+      type: QueryTypes.SELECT,
+    }
+  );
+  return {
+    events: rows.map(eventFromRow),
+    version,
+    idempotencyKey,
+    fingerprint: receipt.fingerprint ?? undefined,
+  };
+}
+
+async function appendInTransaction(
+  transaction: Transaction,
+  drafts: readonly EventDraft[],
+  options: EventLogAppendOptions = {}
+): Promise<EventLogAppendResult> {
+  if (options.idempotencyKey) {
+    const existing = await findCommit(options.idempotencyKey, transaction);
+    if (existing) {
+      if (existing.fingerprint !== options.fingerprint) {
+        throw new SpecterIdempotencyConflictError(options.idempotencyKey);
+      }
+      return { ...existing, duplicate: true };
+    }
+  }
+  if (!drafts.length) {
+    throw new Error("Event Log append requires Events");
+  }
+  const version = await currentVersion(transaction);
+  if (
+    options.expectedVersion !== undefined &&
+    options.expectedVersion !== version
+  ) {
+    throw new SpecterVersionConflictError(options.expectedVersion, version);
+  }
+
+  const events: PersistedEvent[] = [];
+  for (const draft of drafts) {
+    const id = randomUUID();
+    const recordedAt = new Date().toISOString();
+    const encoded = JSON.stringify(draft.payload);
+    if (encoded === undefined) {
+      throw new Error("Specter Event payload must be JSON-serializable");
+    }
+    const rows = await activeSequelize.query<{ event_order: string | number }>(
+      `INSERT INTO specter_events (id, type, payload, recorded_at)
+       VALUES (:id, :type, CAST(:payload AS JSONB), :recordedAt)
+       RETURNING event_order`,
+      {
+        replacements: { id, type: draft.type, payload: encoded, recordedAt },
+        transaction,
+        type: QueryTypes.SELECT,
+      }
+    );
+    events.push({
+      ...draft,
+      id,
+      order: Number(rows[0]?.event_order),
+      recordedAt,
+    });
+  }
+
+  const committedVersion = events.at(-1)?.order ?? version;
+  if (options.idempotencyKey) {
+    await activeSequelize.query(
+      `INSERT INTO specter_event_commits (
+        idempotency_key, fingerprint, first_event_order, last_event_order, committed_at
+      ) VALUES (:idempotencyKey, :fingerprint, :firstOrder, :lastOrder, NOW())`,
+      {
+        replacements: {
+          idempotencyKey: options.idempotencyKey,
+          fingerprint: options.fingerprint ?? null,
+          firstOrder: events[0]?.order ?? version,
+          lastOrder: committedVersion,
+        },
+        transaction,
+      }
+    );
+  }
+  return {
+    events,
+    version: committedVersion,
+    idempotencyKey: options.idempotencyKey,
+    fingerprint: options.fingerprint,
+    duplicate: false,
+  };
+}
+
+function scopedEventLog(
+  transaction: Transaction,
+  baseVersion: number
+): EventLogTransaction {
+  return {
+    query: (afterOrder, eventTypes) =>
+      queryEvents(afterOrder, eventTypes, transaction),
+    currentVersion: async () => baseVersion,
+    findCommit: (key) => findCommit(key, transaction),
+    append: (events, options) =>
+      appendInTransaction(transaction, events, {
+        ...options,
+        expectedVersion: options?.expectedVersion ?? baseVersion,
+      }),
+  };
+}
+
+export function createOutlineEventLog(sequelize: Sequelize): EventLogAdapter {
+  activeSequelize = sequelize;
+  const runTransaction = <T>(
+    run: (eventLog: EventLogTransaction) => Promise<T>
+  ) =>
+    sequelize.transaction(async (transaction) => {
+      await sequelize.query("SELECT pg_advisory_xact_lock(:lock)", {
+        replacements: { lock: advisoryLock },
+        transaction,
+      });
+      const baseVersion = await currentVersion(transaction);
+      return run(scopedEventLog(transaction, baseVersion));
+    });
+
+  return {
+    query: queryEvents,
+    currentVersion,
+    findCommit,
+    append: (events, options) =>
+      runTransaction((eventLog) => eventLog.append(events, options)),
+    transaction: runTransaction,
+  };
+}
diff --git a/server/specter/jsonSliceStore.ts b/server/specter/jsonSliceStore.ts
new file mode 100644
index 0000000..324a28c
--- /dev/null
+++ b/server/specter/jsonSliceStore.ts
@@ -0,0 +1,128 @@
+import type { SliceStore, SliceStoreAdapter } from "@specter-ts/core";
+import { QueryTypes } from "sequelize";
+import type { Sequelize, Transaction } from "sequelize";
+
+export type JsonProbeWriteState = {
+  readonly append: (value: string) => Promise<void>;
+};
+
+export type JsonProbeReadState = {
+  readonly values: () => Promise<readonly string[]>;
+};
+
+type StoredState = { values: string[]; order: number };
+
+export async function prepareSpecterSliceStore(
+  sequelize: Sequelize
+): Promise<void> {
+  await sequelize.query(`CREATE TABLE IF NOT EXISTS specter_slice_states (
+    slice_name TEXT PRIMARY KEY,
+    state_json JSONB NOT NULL,
+    last_applied_order BIGINT NOT NULL
+  )`);
+}
+
+async function load(
+  sequelize: Sequelize,
+  sliceName: string,
+  transaction?: Transaction,
+  lock = false
+): Promise<StoredState> {
+  const rows = await sequelize.query<{
+    state_json: { values?: unknown };
+    last_applied_order: string | number;
+  }>(
+    `SELECT state_json, last_applied_order
+       FROM specter_slice_states
+      WHERE slice_name = :sliceName${lock ? " FOR UPDATE" : ""}`,
+    {
+      replacements: { sliceName },
+      transaction,
+      type: QueryTypes.SELECT,
+    }
+  );
+  const row = rows[0];
+  return {
+    values: Array.isArray(row?.state_json?.values)
+      ? row.state_json.values.filter(
+          (value): value is string => typeof value === "string"
+        )
+      : [],
+    order: Number(row?.last_applied_order ?? 0),
+  };
+}
+
+async function save(
+  sequelize: Sequelize,
+  sliceName: string,
+  state: StoredState,
+  transaction?: Transaction
+): Promise<void> {
+  await sequelize.query(
+    `INSERT INTO specter_slice_states (slice_name, state_json, last_applied_order)
+     VALUES (:sliceName, CAST(:state AS JSONB), :order)
+     ON CONFLICT (slice_name) DO UPDATE SET
+       state_json = EXCLUDED.state_json,
+       last_applied_order = EXCLUDED.last_applied_order`,
+    {
+      replacements: {
+        sliceName,
+        state: JSON.stringify({ values: state.values }),
+        order: state.order,
+      },
+      transaction,
+    }
+  );
+}
+
+function store(
+  sequelize: Sequelize,
+  sliceName: string,
+  state: StoredState,
+  transaction?: Transaction,
+  publishOnCursor = false
+): SliceStore<JsonProbeWriteState, JsonProbeReadState> {
+  return {
+    write: {
+      append: async (value) => {
+        state.values.push(value);
+      },
+    },
+    read: {
+      values: async () => [...state.values],
+    },
+    lastAppliedOrder: async () => state.order,
+    setLastAppliedOrder: async (order) => {
+      if (!Number.isInteger(order) || order < state.order) {
+        throw new Error(
+          `Slice cursor cannot move from ${state.order} to ${order}`
+        );
+      }
+      state.order = order;
+      if (publishOnCursor) {
+        await save(sequelize, sliceName, state, transaction);
+      }
+    },
+  };
+}
+
+export function createJsonSliceStore(
+  sequelize: Sequelize
+): SliceStoreAdapter<JsonProbeWriteState, JsonProbeReadState> {
+  return {
+    async get(sliceName) {
+      const state = await load(sequelize, sliceName);
+      return store(sequelize, sliceName, state, undefined, true);
+    },
+    transaction(sliceName, run) {
+      return sequelize.transaction(async (transaction) => {
+        const state = await load(sequelize, sliceName, transaction, true);
+        const result = await run(
+          store(sequelize, sliceName, state, transaction)
+        );
+        await save(sequelize, sliceName, state, transaction);
+        return result;
+      });
+    },
+  };
+}
diff --git a/server/specter/reactionScheduler.ts b/server/specter/reactionScheduler.ts
new file mode 100644
index 0000000..4dcf380
--- /dev/null
+++ b/server/specter/reactionScheduler.ts
@@ -0,0 +1,271 @@
+import { randomUUID } from "node:crypto";
+import Queue from "bull";
+import type { Job } from "bull";
+import type {
+  ReactionDeliveryContext,
+  ReactionScheduler,
+} from "@specter-ts/core";
+
+export const specterReactionQueueName = "specterReactionPasses";
+
+type ReactionJobData = {
+  scheduledAt: string;
+  attemptIds: string[];
+  lastError?: string;
+};
+
+export type OutlineReactionDelivery = {
+  readonly deliveryId: string;
+  readonly status: "pending" | "running" | "completed" | "dead-letter";
+  readonly scheduledAt: string;
+  readonly attemptIds: readonly string[];
+  readonly attemptCount: number;
+  readonly lastError?: string;
+};
+
+function createBullQueue(redisUrl: string) {
+  return new Queue<ReactionJobData>(specterReactionQueueName, redisUrl, {
+    defaultJobOptions: {
+      attempts: 3,
+      removeOnComplete: false,
+      removeOnFail: false,
+    },
+    settings: {
+      lockDuration: 20,
+      lockRenewTime: 5,
+      stalledInterval: 10,
+      maxStalledCount: 10,
+    },
+  });
+}
+
+type ReactionQueue = ReturnType<typeof createBullQueue>;
+
+function errorMessage(cause: unknown) {
+  return cause instanceof Error ? cause.message : String(cause);
+}
+
+async function pendingJob(queue: ReactionQueue) {
+  const [active, waiting, delayed] = await Promise.all([
+    queue.getActive(),
+    queue.getWaiting(),
+    queue.getDelayed(),
+  ]);
+  return active[0] ?? waiting[0] ?? delayed[0];
+}
+
+async function waitForDelivery(
+  queue: ReactionQueue,
+  deliveryId: string,
+  isClosed: () => boolean
+): Promise<void> {
+  for (;;) {
+    if (isClosed()) {
+      return new Promise<void>(() => undefined);
+    }
+    let job: Job<ReactionJobData> | null;
+    try {
+      job = await queue.getJob(deliveryId);
+    } catch (cause) {
+      if (isClosed()) {
+        return new Promise<void>(() => undefined);
+      }
+      throw cause;
+    }
+    if (!job) {
+      throw new Error(`Reaction delivery disappeared: ${deliveryId}`);
+    }
+    const state = await job.getState();
+    if (state === "completed") {
+      return;
+    }
+    if (state === "failed") {
+      throw new Error(
+        job.failedReason || job.data.lastError || "Reaction failed"
+      );
+    }
+    await new Promise<void>((resolve) => setTimeout(resolve, 2));
+  }
+}
+
+export function createOutlineReactionScheduler(redisUrl: string): {
+  schedule: ReactionScheduler;
+  close: (options?: { readonly crash?: boolean }) => Promise<void>;
+} {
+  const queue = createBullQueue(redisUrl);
+  const crashController = new AbortController();
+  let activeDeliveryId: string | undefined;
+  let queuedDeliveryId: string | undefined;
+  let queuedDeliveryPromise: Promise<string> | undefined;
+  let closed = false;
+  let processorInstalled = false;
+
+  const schedule: ReactionScheduler = (run) => {
+    if (!processorInstalled) {
+      processorInstalled = true;
+      void queue.process(1, async (job: Job<ReactionJobData>) => {
+        const deliveryId = String(job.id);
+        activeDeliveryId = deliveryId;
+        if (queuedDeliveryId === deliveryId) {
+          queuedDeliveryId = undefined;
+          queuedDeliveryPromise = undefined;
+        }
+        const attemptId = randomUUID();
+        const attemptIds = [...job.data.attemptIds, attemptId];
+        await job.update({ ...job.data, attemptIds, lastError: undefined });
+        const context: ReactionDeliveryContext = {
+          deliveryId,
+          scheduledAt: job.data.scheduledAt,
+          attemptId,
+          attemptNumber: attemptIds.length,
+        };
+        const crashed = new Promise<never>((_resolve, reject) => {
+          crashController.signal.addEventListener(
+            "abort",
+            () => reject(new Error("Specter Reaction worker interrupted")),
+            { once: true }
+          );
+        });
+        try {
+          await Promise.race([run(context), crashed]);
+        } catch (cause) {
+          const lastError = errorMessage(cause);
+          await job.update({ ...job.data, attemptIds, lastError });
+          throw cause;
+        } finally {
+          if (activeDeliveryId === deliveryId) {
+            activeDeliveryId = undefined;
+          }
+        }
+      });
+    }
+    return () => {
+      let selected: Promise<string> | undefined;
+      return () => {
+        if (closed) {
+          return Promise.reject(new Error("Reaction scheduler closed"));
+        }
+        selected ??= (async () => {
+          if (activeDeliveryId) {
+            queuedDeliveryPromise ??= queue
+              .add(
+                {
+                  scheduledAt: new Date().toISOString(),
+                  attemptIds: [],
+                },
+                { jobId: randomUUID() }
+              )
+              .then((job) => {
+                queuedDeliveryId = String(job.id);
+                return queuedDeliveryId;
+              });
+            return queuedDeliveryPromise;
+          }
+          const pending = await pendingJob(queue);
+          if (pending) {
+            return String(pending.id);
+          }
+          const job = await queue.add(
+            {
+              scheduledAt: new Date().toISOString(),
+              attemptIds: [],
+            },
+            { jobId: randomUUID() }
+          );
+          return String(job.id);
+        })();
+        return selected.then((deliveryId) =>
+          waitForDelivery(queue, deliveryId, () => closed)
+        );
+      };
+    };
+  };
+
+  return {
+    schedule,
+    async close(options) {
+      closed = true;
+      if (options?.crash) {
+        crashController.abort();
+        await new Promise<void>((resolve) => setTimeout(resolve, 1));
+        await queue.close(true);
+        return;
+      }
+      await queue.close();
+    },
+  };
+}
+
+function deliveryStatus(state: string): OutlineReactionDelivery["status"] {
+  if (state === "active") {
+    return "running";
+  }
+  if (state === "completed") {
+    return "completed";
+  }
+  if (state === "failed") {
+    return "dead-letter";
+  }
+  return "pending";
+}
+
+export async function outlineReactionDeliveries(
+  redisUrl: string
+): Promise<readonly OutlineReactionDelivery[]> {
+  const queue = createBullQueue(redisUrl);
+  try {
+    const jobs = await queue.getJobs([
+      "waiting",
+      "active",
+      "delayed",
+      "completed",
+      "failed",
+      "paused",
+    ]);
+    return await Promise.all(
+      jobs.map(async (job) => {
+        const state = await job.getState();
+        return {
+          deliveryId: String(job.id),
+          status: deliveryStatus(state),
+          scheduledAt: job.data.scheduledAt,
+          attemptIds: [...job.data.attemptIds],
+          attemptCount: job.data.attemptIds.length,
+          lastError: job.data.lastError ?? job.failedReason ?? undefined,
+        };
+      })
+    );
+  } finally {
+    await queue.close();
+  }
+}
+
+export async function retryOutlineDeadLetter(
+  redisUrl: string,
+  deliveryId: string
+): Promise<void> {
+  const queue = createBullQueue(redisUrl);
+  try {
+    const job = await queue.getJob(deliveryId);
+    if (!job) {
+      throw new Error(`Unknown Reaction delivery: ${deliveryId}`);
+    }
+    if ((await job.getState()) !== "failed") {
+      throw new Error(`Reaction delivery is not dead-lettered: ${deliveryId}`);
+    }
+    await job.retry();
+  } finally {
+    await queue.close();
+  }
+}
+
+export async function resetOutlineReactionQueue(
+  redisUrl: string
+): Promise<void> {
+  const queue = createBullQueue(redisUrl);
+  try {
+    await queue.obliterate({ force: true });
+  } finally {
+    await queue.close();
+  }
+}
