+import { z } from "zod";
+import {
+  documentAccessRequestedEvent,
+  pendingAccessRequestBootstrappedEvent,
+} from "./events";
+import { projectDocumentAccessRequestsSpec } from "./projectionSpec";
+import { accessRequestSliceStore } from "./store";
+
+export const projectDocumentAccessRequests = projectDocumentAccessRequestsSpec
+  .outputSchema(z.never())
+  .plugin(async () => async () => undefined)
+  .store(accessRequestSliceStore)
+  .apply(pendingAccessRequestBootstrappedEvent, async (event, state) => {
+    await state.projectBootstrap(event.payload);
+  })
+  .apply(documentAccessRequestedEvent, async (event, state) => {
+    await state.projectCreated(event.payload);
+  })
+  .handle(async () => undefined);
