index 0000000..cad0d89
--- /dev/null
+++ b/server/specter/accessRequests/runtime.ts
@@ -0,0 +1,107 @@
+import { randomUUID } from "node:crypto";
+import { createSpecterApp, type ReactionScheduler } from "@specter-ts/core";
+import { AccessRequest } from "@server/models";
+import { AccessRequestStatus } from "@server/models/AccessRequest";
+import env from "@server/env";
+import { sequelize } from "@server/storage/database";
+import { createOutlineEventLog, prepareSpecterEventLog } from "../eventLog";
+import { prepareSpecterSliceStore } from "../jsonSliceStore";
+import { createOutlineReactionScheduler } from "../reactionScheduler";
+import {
+  accessRequestEventDefinitions,
+  pendingAccessRequestBootstrappedEvent,
+} from "./events";
+import { requestDocumentAccess } from "./impl";
+import { projectDocumentAccessRequests } from "./projectionImpl";
+
+const immediateSchedule: ReactionScheduler = (run) => {
+  let active: Promise<void> | undefined;
+  return () => () => {
+    active ??= run({
+      deliveryId: randomUUID(),
+      scheduledAt: new Date().toISOString(),
+      attemptId: randomUUID(),
+      attemptNumber: 1,
+    }).finally(() => {
+      active = undefined;
+    });
+    return active;
+  };
+};
+
+const eventLog = createOutlineEventLog(sequelize);
+let appPromise: ReturnType<typeof createSpecterApp> | undefined;
+
+async function createApp() {
+  await prepareSpecterEventLog(sequelize);
+  await prepareSpecterSliceStore(sequelize);
+  const schedule =
+    env.ENVIRONMENT === "test"
+      ? immediateSchedule
+      : createOutlineReactionScheduler(
+          env.REDIS_URL ??
+            (() => {
+              throw new Error("REDIS_URL is required");
+            })()
+        ).schedule;
+  return createSpecterApp({
+    events: accessRequestEventDefinitions,
+    eventLog,
+    schedule,
+    slices: [requestDocumentAccess, projectDocumentAccessRequests],
+  });
+}
+
+export async function createAccessRequestSpecterAppInstance() {
+  return createApp();
+}
+
+async function bootstrapPendingAccessRequests() {
+  const alreadyRepresented = new Set(
+    (
+      await eventLog.query(0, [
+        pendingAccessRequestBootstrappedEvent.type,
+        "document-access-requested",
+      ])
+    ).map((event) =>
+      typeof event.payload === "object" &&
+      event.payload !== null &&
+      "accessRequestId" in event.payload
+        ? String(event.payload.accessRequestId)
+        : ""
+    )
+  );
+  const pending = await AccessRequest.findAll({
+    where: { status: AccessRequestStatus.Pending },
+    order: [["createdAt", "ASC"]],
+  });
+  for (const accessRequest of pending) {
+    if (alreadyRepresented.has(accessRequest.id)) {
+      continue;
+    }
+    await eventLog.append(
+      [
+        pendingAccessRequestBootstrappedEvent.create({
+          accessRequestId: accessRequest.id,
+          documentId: accessRequest.documentId,
+          userId: accessRequest.userId,
+          teamId: accessRequest.teamId,
+          status: "pending",
+          createdAt: accessRequest.createdAt.toISOString(),
+          updatedAt: accessRequest.updatedAt.toISOString(),
+        }),
+      ],
+      {
+        idempotencyKey: `access-request-bootstrap:${accessRequest.id}`,
+        fingerprint: accessRequest.updatedAt.toISOString(),
+      }
+    );
+  }
+}
+
+export async function accessRequestSpecterApp() {
+  appPromise ??= createApp();
+  const app = await appPromise;
+  await bootstrapPendingAccessRequests();
+  return app;
+}
