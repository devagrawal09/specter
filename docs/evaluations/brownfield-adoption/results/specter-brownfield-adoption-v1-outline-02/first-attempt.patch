+import { randomUUID } from "node:crypto";
+import { AccessRequest, Event } from "@server/models";
+import { sequelize } from "@server/storage/database";
+import { buildDocument } from "@server/test/factories";
+import {
+  cleanupLegacySnapshot,
+  setupLegacySnapshot,
+  type LegacySnapshotFixture,
+} from "../../../specter-evaluation/setup-legacy-snapshot";
+import {
+  accessRequestSpecterApp,
+  createAccessRequestSpecterAppInstance,
+} from "./runtime";
+
+describe.sequential("document access request replay", () => {
+  let fixture: LegacySnapshotFixture;
+
+  beforeEach(async () => {
+    await sequelize.query(
+      "TRUNCATE TABLE specter_event_commits, specter_events, specter_slice_states RESTART IDENTITY"
+    );
+    fixture = await setupLegacySnapshot();
+  });
+
+  afterEach(async () => {
+    await cleanupLegacySnapshot();
+    await sequelize.query(
+      "TRUNCATE TABLE specter_event_commits, specter_events, specter_slice_states RESTART IDENTITY"
+    );
+  });
+
+  it("reconstructs the legacy projection after a process-style restart", async () => {
+    const firstApp = await accessRequestSpecterApp();
+    const firstAccessRequestId = randomUUID();
+    const requestedAt = new Date().toISOString();
+    const first = await firstApp.command({
+      type: "requestDocumentAccess",
+      payload: {
+        accessRequestId: firstAccessRequestId,
+        documentId: fixture.document.id,
+        userId: fixture.freshRequester.id,
+        teamId: fixture.team.id,
+        status: "pending",
+        createdAt: requestedAt,
+        updatedAt: requestedAt,
+        actorId: fixture.freshRequester.id,
+        ip: null,
+        authType: "app",
+      },
+    });
+    await first.reactions;
+    expect(await AccessRequest.findByPk(firstAccessRequestId)).not.toBeNull();
+
+    await Event.destroy({
+      where: { modelId: firstAccessRequestId },
+      force: true,
+    });
+    await AccessRequest.destroy({
+      where: { id: firstAccessRequestId },
+      force: true,
+    });
+    await sequelize.query(
+      `UPDATE specter_slice_states
+          SET last_applied_order = 0
+        WHERE slice_name = 'projectDocumentAccessRequests'`
+    );
+
+    const secondDocument = await buildDocument({
+      teamId: fixture.team.id,
+      createdById: fixture.manager.id,
+      collectionId: fixture.privateCollection.id,
+    });
+    const restartedApp = await createAccessRequestSpecterAppInstance();
+    const secondRequestedAt = new Date().toISOString();
+    const second = await restartedApp.command({
+      type: "requestDocumentAccess",
+      payload: {
+        accessRequestId: randomUUID(),
+        documentId: secondDocument.id,
+        userId: fixture.freshRequester.id,
+        teamId: fixture.team.id,
+        status: "pending",
+        createdAt: secondRequestedAt,
+        updatedAt: secondRequestedAt,
+        actorId: fixture.freshRequester.id,
+        ip: null,
+        authType: "app",
+      },
+    });
+    await second.reactions;
+
+    expect(await AccessRequest.findByPk(firstAccessRequestId)).toMatchObject({
+      id: firstAccessRequestId,
+      documentId: fixture.document.id,
+      userId: fixture.freshRequester.id,
+    });
+    expect(
+      await Event.count({
+        where: {
+          name: "access_requests.create",
+          modelId: firstAccessRequestId,
+        },
+      })
+    ).toBe(1);
+  });
+});
