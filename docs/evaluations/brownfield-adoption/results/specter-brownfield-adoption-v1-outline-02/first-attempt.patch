+  documentId: "10000000-0000-4000-8000-000000000006",
+  userId: "10000000-0000-4000-8000-000000000003",
+  teamId: "10000000-0000-4000-8000-000000000001",
+  status: "pending" as const,
+  createdAt: "2026-07-18T18:06:00.000Z",
+  updatedAt: "2026-07-18T18:06:00.000Z",
+};
+
+const acceptedCommand = {
+  accessRequestId: "20000000-0000-4000-8000-000000000001",
+  documentId: legacyPending.documentId,
+  userId: "10000000-0000-4000-8000-000000000004",
+  teamId: legacyPending.teamId,
+  status: "pending" as const,
+  createdAt: "2026-07-18T19:00:00.000Z",
+  updatedAt: "2026-07-18T19:00:00.000Z",
+  actorId: "10000000-0000-4000-8000-000000000004",
+  ip: "127.0.0.1",
+  authType: "app",
+};
+
+export const requestDocumentAccessSpec = createCommandSlice(
+  "requestDocumentAccess"
+)
+  .description(
+    "Requests access to a document when the requester has no pending request."
+  )
+  .scenarios(
+    {
+      description:
+        "Creates a pending request alongside an unrelated bootstrapped request.",
+      given: [event("pending-access-request-bootstrapped", legacyPending)],
+      when: acceptedCommand,
+      expect: [event("document-access-requested", acceptedCommand)],
+    },
+    {
+      description: "Rejects a request already present in bootstrapped state.",
+      given: [event("pending-access-request-bootstrapped", legacyPending)],
+      when: {
+        ...acceptedCommand,
+        accessRequestId: "20000000-0000-4000-8000-000000000002",
+        userId: legacyPending.userId,
+      },
+      expect: [],
+      reject: {
+        reason:
+          "A pending access request already exists for this document and user.",
+      },
+    },
+    {
+      description:
+        "Creates a request for a different document after prior work.",
+      given: [event("document-access-requested", acceptedCommand)],
+      when: {
+        ...acceptedCommand,
+        accessRequestId: "20000000-0000-4000-8000-000000000003",
+        documentId: "30000000-0000-4000-8000-000000000001",
+        createdAt: "2026-07-18T19:01:00.000Z",
+        updatedAt: "2026-07-18T19:01:00.000Z",
+      },
+      expect: [
+        event("document-access-requested", {
+          ...acceptedCommand,
+          accessRequestId: "20000000-0000-4000-8000-000000000003",
+          documentId: "30000000-0000-4000-8000-000000000001",
+          createdAt: "2026-07-18T19:01:00.000Z",
+          updatedAt: "2026-07-18T19:01:00.000Z",
+        }),
+      ],
+    }
+  );
