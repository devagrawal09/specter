+++ b/server/specter/accessRequests/impl.ts
@@ -0,0 +1,34 @@
+import { z } from "zod";
+import {
+  documentAccessRequestedEvent,
+  pendingAccessRequestBootstrappedEvent,
+} from "./events";
+import { requestDocumentAccessSpec } from "./spec";
+import { accessRequestSliceStore } from "./store";
+
+export const requestDocumentAccess = requestDocumentAccessSpec
+  .inputSchema(
+    z.object({
+      accessRequestId: z.string().uuid(),
+      documentId: z.string().uuid(),
+      userId: z.string().uuid(),
+      teamId: z.string().uuid(),
+      status: z.literal("pending"),
+      createdAt: z.string().datetime(),
+      updatedAt: z.string().datetime(),
+      actorId: z.string().uuid(),
+      ip: z.string().nullable(),
+      authType: z.string().nullable(),
+    })
+  )
+  .store(accessRequestSliceStore)
+  .apply(pendingAccessRequestBootstrappedEvent, async () => undefined)
+  .apply(documentAccessRequestedEvent, async () => undefined)
+  .handle(async (command, state) => {
+    if (await state.hasPending(command.documentId, command.userId)) {
+      throw new Error(
+        "A pending access request already exists for this document and user."
+      );
+    }
+    return [documentAccessRequestedEvent.create(command)];
+  });
