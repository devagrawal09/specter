@@ -0,0 +1,62 @@
+import { z } from "zod";
+import type { ProbeSliceStore } from "@specter-ts/brownfield-verifier";
+import type { PersistedEvent } from "@specter-ts/core";
+import type { ProbeReadState, ProbeWriteState } from "@specter-ts/brownfield-verifier";
+import { AppError } from "../../../errors.js";
+import { legacyReturnBootstrappedEvent, refundApprovedEvent, ReturnSnapshot } from "../events.js";
+import { approveRefundSpec } from "./spec.js";
+
+type StateRecord =
+  | { kind: "return"; value: ReturnSnapshot }
+  | { kind: "approval"; value: { returnId: string } };
+
+type RefundApprovedPayload = Awaited<ReturnType<typeof refundApprovedEvent.decode>>;
+type ApproveRefundInput = { returnId: string; approvalId: string; approvedAt: string };
+
+export function createApproveRefund(store: ProbeSliceStore) {
+  return approveRefundSpec
+    .inputSchema(z.object({
+      returnId: z.string().min(1),
+      approvalId: z.string().min(1),
+      approvedAt: z.string().datetime(),
+    }))
+    .store(store)
+    .apply(legacyReturnBootstrappedEvent, async (persistedEvent: PersistedEvent<"legacy-return-bootstrapped", ReturnSnapshot>, state: ProbeWriteState) => {
+      await state.append(JSON.stringify({ kind: "return", value: persistedEvent.payload } satisfies StateRecord));
+    })
+    .apply(refundApprovedEvent, async (persistedEvent: PersistedEvent<"refund-approved", RefundApprovedPayload>, state: ProbeWriteState) => {
+      await state.append(JSON.stringify({ kind: "approval", value: { returnId: persistedEvent.payload.returnId } } satisfies StateRecord));
+    })
+    .handle(async (command: ApproveRefundInput, state: ProbeReadState) => {
+      const records = (await state.values()).map((value: string) => JSON.parse(value) as StateRecord);
+      const current = [...records].reverse().find(
+        (record: StateRecord): record is Extract<StateRecord, { kind: "return" }> => record.kind === "return" && record.value.id === command.returnId,
+      )?.value;
+      if (current === undefined) throw new AppError(404, "RETURN_NOT_FOUND", "Return was not found.");
+      if (current.status === "refunded" || records.some((record: StateRecord) => record.kind === "approval" && record.value.returnId === command.returnId)) {
+        throw new AppError(409, "REFUND_ALREADY_APPROVED", "Refund was already approved for this return.");
+      }
+      if (current.receivedAt === null) {
+        throw new AppError(409, "RETURN_NOT_RECEIVED", "Return must be received before refund approval.");
+      }
+      if (current.inspectedAt === null || current.inspectionResult === null) {
+        throw new AppError(409, "RETURN_NOT_INSPECTED", "Return must be inspected before refund approval.");
+      }
+      if (current.inspectionResult === "rejected" || current.status === "rejected") {
+        throw new AppError(409, "INSPECTION_REJECTED", "A rejected inspection cannot be refunded.");
+      }
+      if (current.status !== "inspected") {
+        throw new AppError(409, "INVALID_RETURN_STATE", "Return state does not permit refund approval.");
+      }
+      return [refundApprovedEvent.create({
+        returnId: command.returnId,
+        approvalId: command.approvalId,
+        amountCents: current.refundAmountCents,
+        currency: current.currency,
+        approvedAt: command.approvedAt,
+        previousReturnVersion: current.version,
+      })];
+    });
+}
+
+export type ApproveRefundSlice = ReturnType<typeof createApproveRefund>;
