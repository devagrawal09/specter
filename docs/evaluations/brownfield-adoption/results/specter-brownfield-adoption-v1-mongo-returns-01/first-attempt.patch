+import { createEventDefinition } from "@specter-ts/core";
+import { z } from "zod";
+
+const iso = z.string().datetime();
+const nullableIso = iso.nullable();
+
+export const returnSnapshotSchema = z.object({
+  id: z.string().min(1),
+  orderId: z.string().min(1),
+  customerId: z.string().min(1),
+  itemSku: z.string().min(1),
+  reason: z.string(),
+  status: z.enum(["requested", "received", "inspected", "rejected", "refunded"]),
+  refundAmountCents: z.number().int().positive(),
+  currency: z.literal("USD"),
+  receivedAt: nullableIso,
+  inspectedAt: nullableIso,
+  inspectionResult: z.enum(["accepted", "rejected"]).nullable(),
+  createdAt: iso,
+  updatedAt: iso,
+  version: z.number().int().positive(),
+});
+
+export type ReturnSnapshot = z.infer<typeof returnSnapshotSchema>;
+
+export const legacyReturnBootstrappedEvent = createEventDefinition(
+  "legacy-return-bootstrapped",
+  returnSnapshotSchema,
+);
+
+export const legacyApprovalBootstrappedEvent = createEventDefinition(
+  "legacy-approval-bootstrapped",
+  z.object({
+    id: z.string(), returnId: z.string(), amountCents: z.number().int().positive(), currency: z.literal("USD"),
+    approvedAt: iso, processedAt: nullableIso, providerReference: z.string().nullable(),
+  }),
+);
+
+export const legacyReminderBootstrappedEvent = createEventDefinition(
+  "legacy-reminder-bootstrapped",
+  z.object({
+    id: z.string(), returnId: z.string(), dueAt: iso,
+    state: z.enum(["scheduled", "cancelled", "sent"]), cancelledAt: nullableIso, sentAt: nullableIso,
+  }),
+);
+
+export const legacyHistoryBootstrappedEvent = createEventDefinition(
+  "legacy-history-bootstrapped",
+  z.object({
+    id: z.string(), returnId: z.string(), eventKey: z.string(), eventType: z.string(),
+    occurredAt: iso, metadata: z.record(z.unknown()),
+  }),
+);
+
+export const legacyAgendaJobBootstrappedEvent = createEventDefinition(
+  "legacy-agenda-job-bootstrapped",
+  z.object({
+    id: z.string(), name: z.string(), data: z.object({ returnId: z.string(), idempotencyKey: z.string(), seedOwner: z.string().optional() }).passthrough(),
+    type: z.literal("normal"), priority: z.number().int(), nextRunAt: nullableIso, lockedAt: nullableIso,
+    disabled: z.boolean().optional(), lastRunAt: iso.optional(), lastFinishedAt: iso.optional(),
+  }),
+);
+
+export const refundApprovedEvent = createEventDefinition(
+  "refund-approved",
+  z.object({
+    returnId: z.string().min(1),
+    approvalId: z.string().min(1),
+    amountCents: z.number().int().positive(),
+    currency: z.literal("USD"),
+    approvedAt: iso,
+    previousReturnVersion: z.number().int().positive(),
+  }),
+);
+
+export const returnEventDefinitions = [legacyReturnBootstrappedEvent, refundApprovedEvent] as const;
+export const allReturnEventDefinitions = [
+  legacyReturnBootstrappedEvent,
+  legacyApprovalBootstrappedEvent,
+  legacyReminderBootstrappedEvent,
+  legacyHistoryBootstrappedEvent,
+  legacyAgendaJobBootstrappedEvent,
+  refundApprovedEvent,
+] as const;
diff --git a/src/features/returns/projection.ts b/src/features/returns/projection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e68564482897999236a372d6eeee5b7a286d79e
--- /dev/null
+++ b/src/features/returns/projection.ts
@@ -0,0 +1,175 @@
+import type { EventLogAdapter, PersistedEvent } from "@specter-ts/core";
+import { ClientSession, Db, ObjectId } from "mongodb";
+import { AGENDA_COLLECTION } from "../../config.js";
+import {
+  AgendaJobDocument,
+  ApprovalDocument,
+  HistoryDocument,
+  ReminderDocument,
+  ReturnDocument,
+} from "../../domain/models.js";
+import { REFUND_JOB } from "../../repositories/job-repository.js";
+import {
+  allReturnEventDefinitions,
+  legacyAgendaJobBootstrappedEvent,
+  legacyApprovalBootstrappedEvent,
+  legacyHistoryBootstrappedEvent,
+  legacyReminderBootstrappedEvent,
+  legacyReturnBootstrappedEvent,
+  refundApprovedEvent,
+} from "./events.js";
+
+const PROJECTION_ID = "legacy-return-domain";
+interface ProjectionCursor { _id: string; lastAppliedOrder: number }
+
+export async function projectReturnEvents(db: Db, eventLog: EventLogAdapter): Promise<number> {
+  const cursor = await db.collection<ProjectionCursor>("specterProjectionState").findOne({ _id: PROJECTION_ID });
+  const events = await eventLog.query(cursor?.lastAppliedOrder ?? 0, allReturnEventDefinitions.map((event) => event.type));
+  if (events.length === 0) return cursor?.lastAppliedOrder ?? 0;
+
+  const session = db.client.startSession();
+  session.startTransaction({ readConcern: { level: "snapshot" }, writeConcern: { w: "majority" } });
+  try {
+    for (const event of events) await applyEvent(db, session, event);
+    const last = events.at(-1)?.order ?? cursor?.lastAppliedOrder ?? 0;
+    await db.collection<ProjectionCursor>("specterProjectionState").updateOne(
+      { _id: PROJECTION_ID }, { $set: { lastAppliedOrder: last } }, { upsert: true, session },
+    );
+    await session.commitTransaction();
+    return last;
+  } catch (error) {
+    await session.abortTransaction().catch(() => undefined);
+    throw error;
+  } finally {
+    await session.endSession();
+  }
+}
+
+async function applyEvent(db: Db, session: ClientSession, event: PersistedEvent): Promise<void> {
+  switch (event.type) {
+    case "legacy-return-bootstrapped": {
+      const payload = await legacyReturnBootstrappedEvent.decode(event.payload);
+      const document: ReturnDocument = {
+        _id: payload.id,
+        orderId: payload.orderId,
+        customerId: payload.customerId,
+        itemSku: payload.itemSku,
+        reason: payload.reason,
+        status: payload.status,
+        refundAmountCents: payload.refundAmountCents,
+        currency: payload.currency,
+        receivedAt: payload.receivedAt === null ? null : new Date(payload.receivedAt),
+        inspectedAt: payload.inspectedAt === null ? null : new Date(payload.inspectedAt),
+        inspectionResult: payload.inspectionResult,
+        createdAt: new Date(payload.createdAt),
+        updatedAt: new Date(payload.updatedAt),
+        version: payload.version,
+      };
+      await db.collection<ReturnDocument>("returns").replaceOne({ _id: document._id }, document, { upsert: true, session });
+      return;
+    }
+    case "legacy-approval-bootstrapped": {
+      const payload = await legacyApprovalBootstrappedEvent.decode(event.payload);
+      await db.collection<ApprovalDocument>("approvals").replaceOne(
+        { _id: payload.id },
+        {
+          returnId: payload.returnId, amountCents: payload.amountCents, currency: payload.currency,
+          approvedAt: new Date(payload.approvedAt), processedAt: payload.processedAt === null ? null : new Date(payload.processedAt),
+          providerReference: payload.providerReference,
+        },
+        { upsert: true, session },
+      );
+      return;
+    }
+    case "legacy-reminder-bootstrapped": {
+      const payload = await legacyReminderBootstrappedEvent.decode(event.payload);
+      await db.collection<ReminderDocument>("reminders").replaceOne(
+        { _id: payload.id },
+        {
+          returnId: payload.returnId, dueAt: new Date(payload.dueAt), state: payload.state,
+          cancelledAt: payload.cancelledAt === null ? null : new Date(payload.cancelledAt),
+          sentAt: payload.sentAt === null ? null : new Date(payload.sentAt),
+        },
+        { upsert: true, session },
+      );
+      return;
+    }
+    case "legacy-history-bootstrapped": {
+      const payload = await legacyHistoryBootstrappedEvent.decode(event.payload);
+      await db.collection<HistoryDocument>("returnHistory").replaceOne(
+        { _id: payload.id },
+        { returnId: payload.returnId, eventKey: payload.eventKey, eventType: payload.eventType, occurredAt: new Date(payload.occurredAt), metadata: payload.metadata },
+        { upsert: true, session },
+      );
+      return;
+    }
+    case "legacy-agenda-job-bootstrapped": {
+      const payload = await legacyAgendaJobBootstrappedEvent.decode(event.payload);
+      await db.collection<AgendaJobDocument>(AGENDA_COLLECTION).replaceOne(
+        { _id: new ObjectId(payload.id) },
+        {
+          name: payload.name, data: payload.data,
+          type: payload.type, priority: payload.priority,
+          nextRunAt: payload.nextRunAt === null ? null : new Date(payload.nextRunAt),
+          lockedAt: payload.lockedAt === null ? null : new Date(payload.lockedAt),
+          ...(payload.disabled === undefined ? {} : { disabled: payload.disabled }),
+          ...(payload.lastRunAt === undefined ? {} : { lastRunAt: new Date(payload.lastRunAt) }),
+          ...(payload.lastFinishedAt === undefined ? {} : { lastFinishedAt: new Date(payload.lastFinishedAt) }),
+        },
+        { upsert: true, session },
+      );
+      return;
+    }
+    case "refund-approved": {
+      const payload = await refundApprovedEvent.decode(event.payload);
+      const approvedAt = new Date(payload.approvedAt);
+      const update = await db.collection<ReturnDocument>("returns").updateOne(
+        { _id: payload.returnId, version: payload.previousReturnVersion, status: "inspected" },
+        { $set: { status: "refunded", updatedAt: approvedAt }, $inc: { version: 1 } },
+        { session },
+      );
+      if (update.matchedCount !== 1) {
+        const existing = await db.collection<ReturnDocument>("returns").findOne({ _id: payload.returnId }, { session });
+        if (existing?.status !== "refunded" || existing.version !== payload.previousReturnVersion + 1) {
+          throw new Error(`Cannot project refund approval for ${payload.returnId}`);
+        }
+      }
+      await db.collection<ApprovalDocument>("approvals").updateOne(
+        { _id: payload.approvalId },
+        { $setOnInsert: {
+          _id: payload.approvalId, returnId: payload.returnId, amountCents: payload.amountCents,
+          currency: payload.currency, approvedAt, processedAt: null, providerReference: null,
+        } },
+        { upsert: true, session },
+      );
+      await db.collection<HistoryDocument>("returnHistory").updateOne(
+        { returnId: payload.returnId, eventKey: "refund-approved" },
+        { $setOnInsert: {
+          _id: `history:${payload.returnId}:refund-approved`, returnId: payload.returnId,
+          eventKey: "refund-approved", eventType: "refund.approved", occurredAt: approvedAt,
+          metadata: { amountCents: payload.amountCents, currency: payload.currency },
+        } },
+        { upsert: true, session },
+      );
+      await db.collection<ReminderDocument>("reminders").updateOne(
+        { returnId: payload.returnId, state: "scheduled" },
+        { $set: { state: "cancelled", cancelledAt: approvedAt } },
+        { session },
+      );
+      await db.collection<AgendaJobDocument>(AGENDA_COLLECTION).updateOne(
+        { "data.idempotencyKey": `reminder:${payload.returnId}` },
+        { $set: { disabled: true, nextRunAt: null, lockedAt: null, "data.cancelledAt": approvedAt } },
+        { session },
+      );
+      await db.collection<AgendaJobDocument>(AGENDA_COLLECTION).updateOne(
+        { "data.idempotencyKey": `refund:${payload.returnId}` },
+        { $setOnInsert: {
+          name: REFUND_JOB, data: { returnId: payload.returnId, idempotencyKey: `refund:${payload.returnId}` },
+          type: "normal", priority: 10, nextRunAt: approvedAt, lockedAt: null, disabled: false,
+        } },
+        { upsert: true, session },
+      );
+      return;
+    }
+  }
+}
