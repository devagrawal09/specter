+        attemptIds: document.attemptIds,
+        attemptCount: document.attemptCount,
+        ...(document.lastError === undefined ? {} : { lastError: document.lastError }),
+      }));
+    },
+    retryDeadLetter: async (deliveryId: string) => {
+      const { db } = await database();
+      const result = await db.collection<ReactionDeliveryDocument>(AGENDA_COLLECTION).updateOne(
+        { _id: deliveryId, "data.owner": OWNER, status: "dead-letter" },
+        {
+          $set: { status: "pending", disabled: false, nextRunAt: new Date(), lockedAt: null },
+          $unset: { lockExpiresAt: "", lastError: "" },
+        },
+      );
+      if (result.matchedCount !== 1) throw new Error(`Dead-letter delivery not found: ${deliveryId}`);
+    },
+  };
+}
