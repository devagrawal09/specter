@@ -0,0 +1,73 @@
+import { createSpecterApp, SpecterCommandRejectedError } from "@specter-ts/core";
+import type { PersistedEvent, ReactionDeliveryContext, ReactionScheduler } from "@specter-ts/core";
+import { Db } from "mongodb";
+import { AppError } from "../../errors.js";
+import { ReturnDocument } from "../../domain/models.js";
+import { MongoEventLog } from "../../specter/mongo-event-log.js";
+import { MongoStringSliceStore } from "../../specter/mongo-slice-store.js";
+import { createApproveRefund } from "./approve-refund/impl.js";
+import { legacyReturnBootstrappedEvent, returnEventDefinitions } from "./events.js";
+
+const immediateSchedule: ReactionScheduler = (run: (context: ReactionDeliveryContext) => Promise<void>) => {
+  let sequence = 0;
+  return () => {
+    sequence += 1;
+    const deliveryId = `returns-reaction-${sequence}`;
+    const completion = run({
+      deliveryId,
+      scheduledAt: new Date().toISOString(),
+      attemptId: `${deliveryId}:attempt:1`,
+      attemptNumber: 1,
+    });
+    return () => completion;
+  };
+};
+
+export function createReturnsSpecterRuntime(db: Db) {
+  const eventLog = new MongoEventLog(db);
+  const sliceStore = new MongoStringSliceStore(db, "specterDomain");
+  const approveRefund = createApproveRefund(sliceStore);
+  return {
+    eventLog,
+    app: createSpecterApp({
+      events: returnEventDefinitions,
+      eventLog,
+      schedule: immediateSchedule,
+      slices: [approveRefund],
+    }),
+  };
+}
+
+export async function ensureReturnBootstrapped(db: Db, eventLog: MongoEventLog, returnId: string): Promise<void> {
+  await eventLog.transaction(async (transaction) => {
+    const existingEvents = await transaction.query(0, [legacyReturnBootstrappedEvent.type]);
+    if (existingEvents.some((event: PersistedEvent) => (event.payload as { id?: unknown }).id === returnId)) return;
+
+    const document = await db.collection<ReturnDocument>("returns").findOne({ _id: returnId });
+    if (document === null) throw new AppError(404, "RETURN_NOT_FOUND", "Return was not found.");
+    await transaction.append([legacyReturnBootstrappedEvent.create({
+      id: document._id,
+      orderId: document.orderId,
+      customerId: document.customerId,
+      itemSku: document.itemSku,
+      reason: document.reason,
+      status: document.status,
+      refundAmountCents: document.refundAmountCents,
+      currency: document.currency,
+      receivedAt: document.receivedAt?.toISOString() ?? null,
+      inspectedAt: document.inspectedAt?.toISOString() ?? null,
+      inspectionResult: document.inspectionResult,
+      createdAt: document.createdAt.toISOString(),
+      updatedAt: document.updatedAt.toISOString(),
+      version: document.version,
+    })]);
+  });
+}
+
+export function unwrapApproveRefundError(error: unknown): never {
+  if (error instanceof SpecterCommandRejectedError) {
+    const rejected = error as SpecterCommandRejectedError;
+    if (rejected.cause instanceof AppError) throw rejected.cause;
+  }
+  throw error;
+}
