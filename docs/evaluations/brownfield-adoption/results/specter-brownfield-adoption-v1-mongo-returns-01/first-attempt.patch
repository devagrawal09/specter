+import { testSliceImplementation } from "@specter-ts/core/testing";
+import type { ProbeSliceStore } from "@specter-ts/brownfield-verifier";
+import { createApproveRefund } from "./approve-refund/impl.js";
+import { returnEventDefinitions } from "./events.js";
+
+class ScenarioStore implements ProbeSliceStore {
+  private readonly valuesBySlice = new Map<string, string[]>();
+  private readonly cursors = new Map<string, number>();
+
+  async get(sliceName: string) {
+    const values = [...(this.valuesBySlice.get(sliceName) ?? [])];
+    return {
+      write: { append: async (value: string) => { values.push(value); } },
+      read: { values: async () => [...values] },
+      lastAppliedOrder: async () => this.cursors.get(sliceName) ?? 0,
+      setLastAppliedOrder: async (order: number) => {
+        this.valuesBySlice.set(sliceName, [...values]);
+        this.cursors.set(sliceName, order);
+      },
+    };
+  }
+
+  async transaction<T>(sliceName: string, run: (store: Awaited<ReturnType<ScenarioStore["get"]>>) => Promise<T>): Promise<T> {
+    return run(await this.get(sliceName));
+  }
+}
+
+testSliceImplementation(createApproveRefund(new ScenarioStore()), { events: returnEventDefinitions });
