+import { createCommandSlice, event } from "@specter-ts/core/spec";
+
+const eligible = {
+  id: "ret-1001", orderId: "ord-5001", customerId: "cus-301", itemSku: "JACKET-NAVY-M",
+  reason: "Sleeves are too short", status: "inspected", refundAmountCents: 12900, currency: "USD",
+  receivedAt: "2025-01-03T10:00:00.000Z", inspectedAt: "2025-01-03T14:00:00.000Z",
+  inspectionResult: "accepted", createdAt: "2025-01-01T09:00:00.000Z",
+  updatedAt: "2025-01-03T14:00:00.000Z", version: 3,
+} as const;
+
+export const approveRefundSpec = createCommandSlice("approveRefund")
+  .description("Approves an inspected return and records the authoritative refund fact.")
+  .scenarios(
+    {
+      description: "Approves an inspected return with an accepted inspection.",
+      given: [event("legacy-return-bootstrapped", eligible)],
+      when: { returnId: "ret-1001", approvalId: "approval:ret-1001", approvedAt: "2025-02-01T12:00:00.000Z" },
+      expect: [event("refund-approved", {
+        returnId: "ret-1001", approvalId: "approval:ret-1001", amountCents: 12900,
+        currency: "USD", approvedAt: "2025-02-01T12:00:00.000Z", previousReturnVersion: 3,
+      })],
+    },
+    {
+      description: "Rejects an already approved refund.",
+      given: [
+        event("legacy-return-bootstrapped", eligible),
+        event("refund-approved", {
+          returnId: "ret-1001", approvalId: "approval:ret-1001", amountCents: 12900,
+          currency: "USD", approvedAt: "2025-02-01T12:00:00.000Z", previousReturnVersion: 3,
+        }),
+      ],
+      when: { returnId: "ret-1001", approvalId: "approval:ret-1001", approvedAt: "2025-02-01T12:01:00.000Z" },
+      expect: [],
+      reject: { reason: "Refund was already approved for this return." },
+    },
+    {
+      description: "Rejects a return that has not been received.",
+      given: [event("legacy-return-bootstrapped", {
+        ...eligible, id: "ret-1003", status: "requested", receivedAt: null, inspectedAt: null,
+        inspectionResult: null, version: 1,
+      })],
+      when: { returnId: "ret-1003", approvalId: "approval:ret-1003", approvedAt: "2025-02-01T12:00:00.000Z" },
+      expect: [],
+      reject: { reason: "Return must be received before refund approval." },
+    },
+    {
+      description: "Rejects a received return that has not been inspected.",
+      given: [event("legacy-return-bootstrapped", {
+        ...eligible, id: "ret-1004", status: "received", inspectedAt: null, inspectionResult: null, version: 2,
+      })],
+      when: { returnId: "ret-1004", approvalId: "approval:ret-1004", approvedAt: "2025-02-01T12:00:00.000Z" },
+      expect: [],
+      reject: { reason: "Return must be inspected before refund approval." },
+    },
+    {
+      description: "Rejects a return with a rejected inspection.",
+      given: [event("legacy-return-bootstrapped", {
+        ...eligible, id: "ret-1005", status: "rejected", inspectionResult: "rejected", version: 3,
+      })],
+      when: { returnId: "ret-1005", approvalId: "approval:ret-1005", approvedAt: "2025-02-01T12:00:00.000Z" },
+      expect: [],
+      reject: { reason: "A rejected inspection cannot be refunded." },
+    },
+  );
