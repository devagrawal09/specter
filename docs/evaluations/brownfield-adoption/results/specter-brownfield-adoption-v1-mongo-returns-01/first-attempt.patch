+        recoveryLeaseMs: 3,
+        pollMs: 1,
+      });
+      return {
+        eventLog: new MongoEventLog(db, { namespace: NAMESPACE }),
+        sliceStore: new MongoStringSliceStore(db, NAMESPACE),
+        schedule: scheduler.schedule,
+        close: scheduler.close,
+      };
+    },
+    deliveries: async (): Promise<readonly ReactionDeliverySnapshot[]> => {
