diff --git a/src/specter/agenda-reaction-scheduler.ts b/src/specter/agenda-reaction-scheduler.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e65e73f348e898b9be5897e300cd08f4d73cefb
--- /dev/null
+++ b/src/specter/agenda-reaction-scheduler.ts
@@ -0,0 +1,170 @@
+import { randomUUID } from "node:crypto";
+import type { ReactionDeliveryContext, ReactionScheduler } from "@specter-ts/core";
+import { Db } from "mongodb";
+import { AGENDA_COLLECTION } from "../config.js";
+
+export type DeliveryStatus = "pending" | "running" | "completed" | "dead-letter";
+
+export interface ReactionDeliveryDocument {
+  _id: string;
+  name: "specter:reaction-pass";
+  data: { owner: string; deliveryId: string; idempotencyKey: string };
+  type: "normal";
+  priority: number;
+  nextRunAt: Date | null;
+  lockedAt: Date | null;
+  disabled: boolean;
+  status: DeliveryStatus;
+  scheduledAt: string;
+  attemptIds: string[];
+  attemptCount: number;
+  lastError?: string;
+  lockExpiresAt?: Date;
+}
+
+export interface DurableReactionSchedulerRuntime {
+  schedule: ReactionScheduler;
+  close(options?: { crash?: boolean }): Promise<void>;
+}
+
+export function createDurableReactionScheduler(
+  db: Db,
+  owner: string,
+  options: { maxAttempts?: number; recoveryLeaseMs?: number; pollMs?: number } = {},
+): DurableReactionSchedulerRuntime {
+  const maxAttempts = options.maxAttempts ?? 3;
+  const recoveryLeaseMs = options.recoveryLeaseMs ?? 3;
+  const pollMs = options.pollMs ?? 1;
+  let closed = false;
+  let active = false;
+  let followUpId: string | undefined;
+  let handler: ((context: ReactionDeliveryContext) => Promise<void>) | undefined;
+
+  const collection = db.collection<ReactionDeliveryDocument>(AGENDA_COLLECTION);
+
+  const enqueue = async (deliveryId: string) => {
+    const scheduledAt = new Date().toISOString();
+    await collection.insertOne({
+      _id: deliveryId,
+      name: "specter:reaction-pass",
+      data: { owner, deliveryId, idempotencyKey: `${owner}:${deliveryId}` },
+      type: "normal",
+      priority: 20,
+      nextRunAt: new Date(),
+      lockedAt: null,
+      disabled: false,
+      status: "pending",
+      scheduledAt,
+      attemptIds: [],
+      attemptCount: 0,
+    });
+  };
+
+  const awaitDelivery = async (deliveryId: string): Promise<void> => {
+    while (!closed) {
+      const delivery = await collection.findOne({ _id: deliveryId });
+      if (delivery?.status === "completed") return;
+      if (delivery?.status === "dead-letter") throw new Error(delivery.lastError ?? "Reaction delivery dead-lettered");
+      await new Promise((resolve) => setTimeout(resolve, pollMs));
+    }
+    // A crashed process abandons its in-memory waiter. The persisted running
+    // delivery is recovered by the next worker after its short lease expires.
+    return new Promise<void>(() => undefined);
+  };
+
+  const claim = async (): Promise<ReactionDeliveryDocument | undefined> => {
+    if (handler === undefined) return undefined;
+    const now = new Date();
+    const attemptId = `attempt:${randomUUID()}`;
+    const claimed = await collection.findOneAndUpdate(
+      {
+        "data.owner": owner,
+        $or: [
+          { status: "pending", nextRunAt: { $lte: now } },
+          { status: "running", lockExpiresAt: { $lte: now } },
+        ],
+      },
+      {
+        $set: {
+          status: "running",
+          lockedAt: now,
+          lockExpiresAt: new Date(now.getTime() + recoveryLeaseMs),
+          nextRunAt: null,
+        },
+        $inc: { attemptCount: 1 },
+        $push: { attemptIds: attemptId },
+      },
+      { sort: { scheduledAt: 1 }, returnDocument: "after" },
+    );
+    return claimed ?? undefined;
+  };
+
+  const work = async () => {
+    if (closed || active) return;
+    active = true;
+    try {
+      const delivery = await claim();
+      if (delivery === undefined || handler === undefined) return;
+      const attemptNumber = delivery.attemptCount;
+      const attemptId = delivery.attemptIds.at(-1);
+      if (attemptId === undefined) throw new Error("Claimed delivery has no attempt ID");
+      try {
+        await handler({ deliveryId: delivery._id, scheduledAt: delivery.scheduledAt, attemptId, attemptNumber });
+        await collection.updateOne(
+          { _id: delivery._id },
+          { $set: { status: "completed", disabled: true, lockedAt: null, nextRunAt: null }, $unset: { lockExpiresAt: "", lastError: "" } },
+        );
+      } catch (error) {
+        const message = error instanceof Error ? error.message : String(error);
+        const dead = attemptNumber >= maxAttempts;
+        await collection.updateOne(
+          { _id: delivery._id },
+          {
+            $set: {
+              status: dead ? "dead-letter" : "pending",
+              disabled: dead,
+              lockedAt: null,
+              nextRunAt: dead ? null : new Date(),
+              lastError: message,
+            },
+            $unset: { lockExpiresAt: "" },
+          },
+        );
+      }
+    } finally {
+      active = false;
+    }
+  };
+
+  const timer = setInterval(() => { void work(); }, pollMs);
+  timer.unref();
+
+  const schedule: ReactionScheduler = (run: (context: ReactionDeliveryContext) => Promise<void>) => {
+    handler = run;
+    return () => {
+      let id: string;
+      if (active) {
+        id = followUpId ?? randomUUID();
+        if (followUpId === undefined) {
+          followUpId = id;
+          void enqueue(id).finally(() => { followUpId = undefined; });
+        }
+      } else {
+        id = randomUUID();
+        void enqueue(id);
+      }
+      return () => awaitDelivery(id);
+    };
+  };
+
+  return {
+    schedule,
+    close: async ({ crash = false } = {}) => {
+      closed = true;
+      clearInterval(timer);
+      if (!crash) {
+        while (active) await new Promise((resolve) => setTimeout(resolve, pollMs));
+      }
+    },
+  };
+}
diff --git a/src/specter/mongo-event-log.ts b/src/specter/mongo-event-log.ts
new file mode 100644
index 0000000000000000000000000000000000000000..00746e3864b8fd9323ceab06c53095d63023bc17
--- /dev/null
+++ b/src/specter/mongo-event-log.ts
@@ -0,0 +1,216 @@
+import { randomUUID } from "node:crypto";
+import type {
+  EventLogAdapter,
+  EventLogAppendOptions,
+  EventLogAppendResult,
+  EventLogCommit,
+  EventLogTransaction,
+  EventDraft,
+  PersistedEvent,
+} from "@specter-ts/core";
+import {
+  SpecterIdempotencyConflictError,
+  SpecterVersionConflictError,
+} from "@specter-ts/core";
+import { ClientSession, Db } from "mongodb";
+
+interface EventDocument {
+  _id: string;
+  id: string;
+  order: number;
+  recordedAt: string;
+  type: string;
+  payload: unknown;
+}
+
+interface CommitDocument {
+  _id: string;
+  eventIds: string[];
+  version: number;
+  fingerprint?: string;
+}
+
+interface MetaDocument {
+  _id: "global";
+  version: number;
+}
+
+export interface MongoEventLogOptions {
+  namespace?: string;
+  now?: () => Date;
+  id?: () => string;
+}
+
+export class MongoEventLog implements EventLogAdapter {
+  private tail: Promise<void> = Promise.resolve();
+  private readonly eventsName: string;
+  private readonly commitsName: string;
+  private readonly metaName: string;
+  private readonly now: () => Date;
+  private readonly id: () => string;
+
+  constructor(private readonly db: Db, options: MongoEventLogOptions = {}) {
+    const namespace = options.namespace ?? "specter";
+    this.eventsName = `${namespace}Events`;
+    this.commitsName = `${namespace}Commits`;
+    this.metaName = `${namespace}EventLogMeta`;
+    this.now = options.now ?? (() => new Date());
+    this.id = options.id ?? randomUUID;
+  }
+
+  async query(afterOrder: number, eventTypes: readonly string[]): Promise<PersistedEvent[]> {
+    return this.queryWith(undefined, afterOrder, eventTypes);
+  }
+
+  async currentVersion(): Promise<number> {
+    return this.currentVersionWith(undefined);
+  }
+
+  async findCommit(idempotencyKey: string): Promise<EventLogCommit | undefined> {
+    return this.findCommitWith(undefined, idempotencyKey);
+  }
+
+  async append(events: readonly EventDraft[], options: EventLogAppendOptions = {}): Promise<EventLogAppendResult> {
+    return this.transaction((transaction) => transaction.append(events, options));
+  }
+
+  async transaction<T>(run: (eventLog: EventLogTransaction) => Promise<T>): Promise<T> {
+    return this.serialized(async () => {
+      const session = this.db.client.startSession();
+      session.startTransaction({ readConcern: { level: "snapshot" }, writeConcern: { w: "majority" } });
+      try {
+        const transaction: EventLogTransaction = {
+          query: (afterOrder: number, eventTypes: readonly string[]) => this.queryWith(session, afterOrder, eventTypes),
+          currentVersion: () => this.currentVersionWith(session),
+          findCommit: (idempotencyKey: string) => this.findCommitWith(session, idempotencyKey),
+          append: (events: readonly EventDraft[], options: EventLogAppendOptions = {}) => this.appendWith(session, events, options),
+        };
+        const result = await run(transaction);
+        await session.commitTransaction();
+        return result;
+      } catch (error) {
+        await session.abortTransaction().catch(() => undefined);
+        throw error;
+      } finally {
+        await session.endSession();
+      }
+    });
+  }
+
+  private async queryWith(
+    session: ClientSession | undefined,
+    afterOrder: number,
+    eventTypes: readonly string[],
+  ): Promise<PersistedEvent[]> {
+    if (eventTypes.length === 0) return [];
+    const documents = await this.db
+      .collection<EventDocument>(this.eventsName)
+      .find({ order: { $gt: afterOrder }, type: { $in: [...eventTypes] } }, session === undefined ? {} : { session })
+      .sort({ order: 1 })
+      .toArray();
+    return documents.map(({ _id: _mongoId, ...event }) => event);
+  }
+
+  private async currentVersionWith(session: ClientSession | undefined): Promise<number> {
+    const meta = await this.db.collection<MetaDocument>(this.metaName).findOne(
+      { _id: "global" },
+      session === undefined ? {} : { session },
+    );
+    return meta?.version ?? 0;
+  }
+
+  private async findCommitWith(
+    session: ClientSession | undefined,
+    idempotencyKey: string,
+  ): Promise<EventLogCommit | undefined> {
+    const commit = await this.db.collection<CommitDocument>(this.commitsName).findOne(
+      { _id: idempotencyKey },
+      session === undefined ? {} : { session },
+    );
+    if (commit === null) return undefined;
+    const documents = await this.db.collection<EventDocument>(this.eventsName)
+      .find({ _id: { $in: commit.eventIds } }, session === undefined ? {} : { session })
+      .sort({ order: 1 })
+      .toArray();
+    const events = documents.map(({ _id: _mongoId, ...event }) => event);
+    return {
+      events,
+      version: commit.version,
+      idempotencyKey,
+      ...(commit.fingerprint === undefined ? {} : { fingerprint: commit.fingerprint }),
+    };
+  }
+
+  private async appendWith(
+    session: ClientSession,
+    drafts: readonly EventDraft[],
+    options: EventLogAppendOptions,
+  ): Promise<EventLogAppendResult> {
+    if (options.idempotencyKey !== undefined) {
+      const existing = await this.findCommitWith(session, options.idempotencyKey);
+      if (existing !== undefined) {
+        if (existing.fingerprint !== options.fingerprint) {
+          throw new SpecterIdempotencyConflictError(options.idempotencyKey);
+        }
+        return { ...existing, duplicate: true };
+      }
+    }
+
+    const version = await this.currentVersionWith(session);
+    if (options.expectedVersion !== undefined && options.expectedVersion !== version) {
+      throw new SpecterVersionConflictError(options.expectedVersion, version);
+    }
+
+    const persisted = drafts.map((draft, index): EventDocument => {
+      const id = this.id();
+      return {
+        _id: id,
+        id,
+        order: version + index + 1,
+        recordedAt: this.now().toISOString(),
+        type: draft.type,
+        payload: draft.payload,
+      };
+    });
+    if (persisted.length > 0) {
+      await this.db.collection<EventDocument>(this.eventsName).insertMany(persisted, { session });
+    }
+    const nextVersion = version + persisted.length;
+    await this.db.collection<MetaDocument>(this.metaName).updateOne(
+      { _id: "global" },
+      { $set: { version: nextVersion } },
+      { upsert: true, session },
+    );
+    if (options.idempotencyKey !== undefined) {
+      await this.db.collection<CommitDocument>(this.commitsName).insertOne(
+        {
+          _id: options.idempotencyKey,
+          eventIds: persisted.map((event) => event._id),
+          version: nextVersion,
+          ...(options.fingerprint === undefined ? {} : { fingerprint: options.fingerprint }),
+        },
+        { session },
+      );
+    }
+    const events = persisted.map(({ _id: _mongoId, ...event }) => event);
+    return {
+      events,
+      version: nextVersion,
+      duplicate: false,
+      ...(options.idempotencyKey === undefined ? {} : { idempotencyKey: options.idempotencyKey }),
+      ...(options.fingerprint === undefined ? {} : { fingerprint: options.fingerprint }),
+    };
+  }
+
+  private async serialized<T>(run: () => Promise<T>): Promise<T> {
+    const previous = this.tail;
+    let release!: () => void;
+    this.tail = new Promise<void>((resolve) => { release = resolve; });
+    await previous;
+    try {
+      return await run();
+    } finally {
+      release();
+    }
+  }
+}
diff --git a/src/specter/mongo-slice-store.ts b/src/specter/mongo-slice-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6d7caf3f45eccdbc7f12a54df7455c0f286bd4ae
--- /dev/null
+++ b/src/specter/mongo-slice-store.ts
@@ -0,0 +1,70 @@
+import { Db } from "mongodb";
+import type { ProbeSliceStore } from "@specter-ts/brownfield-verifier";
+
+interface SliceDocument {
+  _id: string;
+  values: string[];
+  lastAppliedOrder: number;
+}
+
+export class MongoStringSliceStore implements ProbeSliceStore {
+  private readonly collectionName: string;
+
+  constructor(private readonly db: Db, namespace = "specter") {
+    this.collectionName = `${namespace}SliceState`;
+  }
+
+  async get(sliceName: string) {
+    return this.staged(sliceName);
+  }
+
+  async transaction<T>(sliceName: string, run: (store: Awaited<ReturnType<MongoStringSliceStore["get"]>>) => Promise<T>): Promise<T> {
+    const session = this.db.client.startSession();
+    session.startTransaction({ readConcern: { level: "snapshot" }, writeConcern: { w: "majority" } });
+    try {
+      const staged = await this.staged(sliceName, session);
+      const result = await run(staged);
+      await staged.publish();
+      await session.commitTransaction();
+      return result;
+    } catch (error) {
+      await session.abortTransaction().catch(() => undefined);
+      throw error;
+    } finally {
+      await session.endSession();
+    }
+  }
+
+  private async staged(sliceName: string, session?: import("mongodb").ClientSession) {
+    const document = await this.db.collection<SliceDocument>(this.collectionName).findOne(
+      { _id: sliceName },
+      session === undefined ? {} : { session },
+    );
+    const values = [...(document?.values ?? [])];
+    const originalOrder = document?.lastAppliedOrder ?? 0;
+    let pendingOrder: number | undefined;
+    let published = false;
+
+    const publish = async () => {
+      if (published || pendingOrder === undefined) return;
+      published = true;
+      await this.db.collection<SliceDocument>(this.collectionName).updateOne(
+        { _id: sliceName, $or: [{ lastAppliedOrder: { $lte: pendingOrder } }, { lastAppliedOrder: { $exists: false } }] },
+        { $set: { values: [...values], lastAppliedOrder: pendingOrder } },
+        { upsert: document === null, ...(session === undefined ? {} : { session }) },
+      );
+    };
+
+    return {
+      write: { append: async (value: string) => { values.push(value); } },
+      read: { values: async () => [...values] as readonly string[] },
+      lastAppliedOrder: async () => pendingOrder ?? originalOrder,
+      setLastAppliedOrder: async (order: number) => {
+        if (order < originalOrder) throw new Error(`Cannot lower Slice cursor from ${originalOrder} to ${order}`);
+        pendingOrder = order;
+        if (session === undefined) await publish();
+      },
+      publish,
+    };
+  }
+}
