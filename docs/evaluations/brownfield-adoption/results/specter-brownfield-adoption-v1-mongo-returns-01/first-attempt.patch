+export function createAdapterHarnessDriver(): AdapterHarnessDriver {
+  let databasePromise: Promise<DatabaseContext> | undefined;
+  const database = () => databasePromise ??= connectDatabase(loadConfig().mongodbUri);
+
+  return {
+    name: "mongo-returns-mongodb-agenda",
+    reset: async () => {
+      const { db } = await database();
+      await Promise.all([
+        db.collection(`${NAMESPACE}Events`).deleteMany({}),
+        db.collection(`${NAMESPACE}Commits`).deleteMany({}),
+        db.collection(`${NAMESPACE}EventLogMeta`).deleteMany({}),
