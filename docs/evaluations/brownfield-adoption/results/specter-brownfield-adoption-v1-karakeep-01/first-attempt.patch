+++ b/specter-evaluation/application-adapters.ts
@@ -0,0 +1,594 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { randomUUID } from "node:crypto";
+import path from "node:path";
+import Database from "better-sqlite3";
+
+import {
+  SpecterIdempotencyConflictError,
+  SpecterVersionConflictError,
+} from "@specter-ts/core";
+import type {
+  EventDraft,
+  EventLogAdapter,
+  EventLogAppendOptions,
+  EventLogAppendResult,
+  EventLogTransaction,
+  PersistedEvent,
+  ReactionDeliveryContext,
+  ReactionScheduler,
+  SliceStore,
+  SliceStoreAdapter,
+} from "@specter-ts/core";
+import type {
+  AdapterHarnessRuntime,
+  ProbeReadState,
+  ProbeSliceStore,
+  ProbeWriteState,
+  ReactionDeliverySnapshot,
+} from "@specter-ts/brownfield-verifier";
+
+type Sqlite = InstanceType<typeof Database>;
+
+type EventTransactionContext = {
+  readonly slicePublications: Map<string, StagedSlice>;
+};
+const eventTransactionContext =
+  new AsyncLocalStorage<EventTransactionContext>();
+let eventTransactionTail = Promise.resolve();
+let sliceTransactionTail = Promise.resolve();
+
+function serialize<T>(kind: "event" | "slice", run: () => Promise<T>) {
+  const previous =
+    kind === "event" ? eventTransactionTail : sliceTransactionTail;
+  let release!: () => void;
+  const current = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  if (kind === "event") eventTransactionTail = previous.then(() => current);
+  else sliceTransactionTail = previous.then(() => current);
+  return previous.then(run).finally(release);
+}
+
+export function prepareKarakeepSpecterDatabase(db: Sqlite) {
+  db.pragma("journal_mode = WAL");
+  db.exec(`
+    create table if not exists specter_events (
+      event_order integer primary key autoincrement,
+      event_id text not null unique,
+      event_type text not null,
+      payload_json text not null,
+      recorded_at text not null
+    );
+    create table if not exists specter_commits (
+      idempotency_key text primary key,
+      fingerprint text,
+      committed_version integer not null,
+      first_event_order integer not null,
+      last_event_order integer not null
+    );
+    create table if not exists specter_slice_state (
+      slice_name text primary key,
+      last_applied_order integer not null default 0,
+      values_json text not null default '[]'
+    );
+  `);
+}
+
+function eventRows(
+  db: Sqlite,
+  where: string,
+  parameters: readonly unknown[],
+): PersistedEvent[] {
+  const rows = db
+    .prepare(
+      `select event_order, event_id, event_type, payload_json, recorded_at
+       from specter_events where ${where} order by event_order asc`,
+    )
+    .all(...parameters) as Array<{
+    event_order: number;
+    event_id: string;
+    event_type: string;
+    payload_json: string;
+    recorded_at: string;
+  }>;
+  return rows.map((row) => ({
+    id: row.event_id,
+    order: row.event_order,
+    type: row.event_type,
+    payload: JSON.parse(row.payload_json) as unknown,
+    recordedAt: row.recorded_at,
+  }));
+}
+
+export function createKarakeepEventLog(db: Sqlite): EventLogAdapter {
+  const query: EventLogTransaction["query"] = async (
+    afterOrder,
+    eventTypes,
+  ) => {
+    if (eventTypes.length === 0) return [];
+    return eventRows(
+      db,
+      `event_order > ? and event_type in (${eventTypes.map(() => "?").join(", ")})`,
+      [afterOrder, ...eventTypes],
+    );
+  };
+  const currentVersion = async () => {
+    const row = db
+      .prepare(
+        "select coalesce(max(event_order), 0) as version from specter_events",
+      )
+      .get() as { version: number };
+    return row.version;
+  };
+  const findCommit: EventLogTransaction["findCommit"] = async (
+    idempotencyKey,
+  ) => {
+    const row = db
+      .prepare(
+        `select idempotency_key, fingerprint, committed_version,
+                first_event_order, last_event_order
+         from specter_commits where idempotency_key = ?`,
+      )
+      .get(idempotencyKey) as
+      | {
+          idempotency_key: string;
+          fingerprint: string | null;
+          committed_version: number;
+          first_event_order: number;
+          last_event_order: number;
+        }
+      | undefined;
+    if (!row) return undefined;
+    return {
+      events: eventRows(db, "event_order between ? and ?", [
+        row.first_event_order,
+        row.last_event_order,
+      ]),
+      version: row.committed_version,
+      idempotencyKey: row.idempotency_key,
+      ...(row.fingerprint === null ? {} : { fingerprint: row.fingerprint }),
+    };
+  };
+
+  const appendInTransaction = async (
+    events: readonly EventDraft[],
+    options: EventLogAppendOptions = {},
+  ): Promise<EventLogAppendResult> => {
+    if (options.idempotencyKey) {
+      const existing = await findCommit(options.idempotencyKey);
+      if (existing) {
+        if (existing.fingerprint !== options.fingerprint) {
+          throw new SpecterIdempotencyConflictError(options.idempotencyKey);
+        }
+        return { ...existing, duplicate: true };
+      }
+    }
+    const version = await currentVersion();
+    if (
+      options.expectedVersion !== undefined &&
+      options.expectedVersion !== version
+    ) {
+      throw new SpecterVersionConflictError(options.expectedVersion, version);
+    }
+    const insert = db.prepare(
+      `insert into specter_events(event_id, event_type, payload_json, recorded_at)
+       values (?, ?, ?, ?)`,
+    );
+    const persisted: PersistedEvent[] = [];
+    for (const draft of events) {
+      const id = randomUUID();
+      const recordedAt = new Date().toISOString();
+      const result = insert.run(
+        id,
+        draft.type,
+        JSON.stringify(draft.payload),
+        recordedAt,
+      );
+      persisted.push({
+        id,
+        order: Number(result.lastInsertRowid),
+        type: draft.type,
+        payload: JSON.parse(JSON.stringify(draft.payload)) as unknown,
+        recordedAt,
+      });
+    }
+    const committedVersion = version + persisted.length;
+    if (options.idempotencyKey) {
+      const firstOrder = persisted.at(0)?.order ?? committedVersion;
+      const lastOrder = persisted.at(-1)?.order ?? committedVersion;
+      db.prepare(
+        `insert into specter_commits(
+          idempotency_key, fingerprint, committed_version,
+          first_event_order, last_event_order
+        ) values (?, ?, ?, ?, ?)`,
+      ).run(
+        options.idempotencyKey,
+        options.fingerprint ?? null,
+        committedVersion,
+        firstOrder,
+        lastOrder,
+      );
+    }
+    return {
+      events: persisted,
+      version: committedVersion,
+      ...(options.idempotencyKey
+        ? { idempotencyKey: options.idempotencyKey }
+        : {}),
+      ...(options.fingerprint ? { fingerprint: options.fingerprint } : {}),
+      duplicate: false,
+    };
+  };
+
+  const transaction: EventLogAdapter["transaction"] = async (run) => {
+    if (eventTransactionContext.getStore()) return run(api);
+    return serialize("event", async () => {
+      const context: EventTransactionContext = { slicePublications: new Map() };
+      db.exec("begin immediate");
+      try {
+        const result = await eventTransactionContext.run(context, () =>
+          run(api),
+        );
+        db.exec("commit");
+        return result;
+      } catch (error) {
+        if (db.inTransaction) db.exec("rollback");
+        for (const [sliceName, staged] of context.slicePublications) {
+          persistSlice(db, sliceName, staged);
+        }
+        throw error;
+      }
+    });
+  };
+  const append: EventLogAdapter["append"] = (events, options) =>
+    eventTransactionContext.getStore()
+      ? appendInTransaction(events, options)
+      : transaction((eventLog) => eventLog.append(events, options));
+  const api: EventLogAdapter = {
+    query,
+    currentVersion,
+    findCommit,
+    append,
+    transaction,
+  };
+  return api;
+}
+
+type StagedSlice = {
+  values: string[];
+  cursor: number;
+  publishRequested: boolean;
+};
+
+function loadSlice(db: Sqlite, sliceName: string): StagedSlice {
+  const row = db
+    .prepare(
+      `select last_applied_order, values_json from specter_slice_state where slice_name = ?`,
+    )
+    .get(sliceName) as
+    | { last_applied_order: number; values_json: string }
+    | undefined;
+  return {
+    values: row ? (JSON.parse(row.values_json) as string[]) : [],
+    cursor: row?.last_applied_order ?? 0,
+    publishRequested: false,
+  };
+}
+
+function persistSlice(db: Sqlite, sliceName: string, staged: StagedSlice) {
+  const current = loadSlice(db, sliceName).cursor;
+  if (staged.cursor < current) return;
+  db.prepare(
+    `insert into specter_slice_state(slice_name, last_applied_order, values_json)
+     values (?, ?, ?)
+     on conflict(slice_name) do update set
+       last_applied_order = excluded.last_applied_order,
+       values_json = excluded.values_json
+     where excluded.last_applied_order >= specter_slice_state.last_applied_order`,
+  ).run(sliceName, staged.cursor, JSON.stringify(staged.values));
+}
+
+function wrapSlice(
+  db: Sqlite,
+  sliceName: string,
+  staged: StagedSlice,
+  direct: boolean,
+): SliceStore<ProbeWriteState, ProbeReadState> {
+  return {
+    write: {
+      append: async (value) => {
+        staged.values.push(value);
+      },
+    },
+    read: {
+      values: async () => [...staged.values],
+    },
+    lastAppliedOrder: async () => staged.cursor,
+    setLastAppliedOrder: async (order) => {
+      if (order < staged.cursor) return;
+      staged.cursor = order;
+      staged.publishRequested = true;
+      if (direct) {
+        eventTransactionContext.getStore()?.slicePublications.set(sliceName, {
+          values: [...staged.values],
+          cursor: staged.cursor,
+          publishRequested: true,
+        });
+        persistSlice(db, sliceName, staged);
+      }
+    },
+  };
+}
+
+export function createKarakeepProbeSliceStore(db: Sqlite): ProbeSliceStore {
+  return {
+    async get(sliceName) {
+      return wrapSlice(db, sliceName, loadSlice(db, sliceName), true);
+    },
+    async transaction(sliceName, run) {
+      return serialize("slice", async () => {
+        db.exec("begin immediate");
+        const staged = loadSlice(db, sliceName);
+        try {
+          const result = await run(wrapSlice(db, sliceName, staged, false));
+          if (staged.publishRequested) persistSlice(db, sliceName, staged);
+          db.exec("commit");
+          return result;
+        } catch (error) {
+          if (db.inTransaction) db.exec("rollback");
+          throw error;
+        }
+      });
+    },
+  };
+}
+
+export function createKarakeepDatabaseSliceStore(
+  db: Sqlite,
+): SliceStoreAdapter<Sqlite, Sqlite> {
+  return {
+    async get(sliceName) {
+      const staged = loadSlice(db, sliceName);
+      return {
+        write: db,
+        read: db,
+        lastAppliedOrder: async () => staged.cursor,
+        setLastAppliedOrder: async (order) => {
+          if (order < staged.cursor) return;
+          staged.cursor = order;
+          staged.publishRequested = true;
+          eventTransactionContext.getStore()?.slicePublications.set(sliceName, {
+            values: [...staged.values],
+            cursor: staged.cursor,
+            publishRequested: true,
+          });
+          persistSlice(db, sliceName, staged);
+        },
+      };
+    },
+    async transaction(sliceName, run) {
+      return run(await this.get(sliceName));
+    },
+  };
+}
+
+function prepareQueueDatabase(db: Sqlite, recoverRunning = false) {
+  db.pragma("journal_mode = WAL");
+  db.exec(`
+    create table if not exists specter_reaction_deliveries (
+      delivery_id text primary key,
+      status text not null,
+      scheduled_at text not null,
+      attempt_ids_json text not null default '[]',
+      attempt_count integer not null default 0,
+      last_error text
+    );
+  `);
+  if (recoverRunning) {
+    db.prepare(
+      `update specter_reaction_deliveries set status = 'pending'
+       where status = 'running'`,
+    ).run();
+  }
+}
+
+type DeliveryRow = {
+  delivery_id: string;
+  status: "pending" | "running" | "completed" | "dead-letter";
+  scheduled_at: string;
+  attempt_ids_json: string;
+  attempt_count: number;
+  last_error: string | null;
+};
+
+function deliveryRows(db: Sqlite): DeliveryRow[] {
+  return db
+    .prepare(
+      `select delivery_id, status, scheduled_at, attempt_ids_json,
+              attempt_count, last_error
+       from specter_reaction_deliveries order by rowid asc`,
+    )
+    .all() as DeliveryRow[];
+}
+
+function createScheduler(db: Sqlite) {
+  let active: Promise<void> | undefined;
+  let closed = false;
+  let runCurrent:
+    | ((context: ReactionDeliveryContext) => Promise<void>)
+    | undefined;
+
+  const schedule: ReactionScheduler = (run) => {
+    runCurrent = run;
+    const request = () => {
+      if (closed) throw new Error("Reaction scheduler is closed");
+      const hasPending = db
+        .prepare(
+          "select 1 from specter_reaction_deliveries where status = 'pending' limit 1",
+        )
+        .get();
+      if (!hasPending) {
+        db.prepare(
+          `insert into specter_reaction_deliveries(
+            delivery_id, status, scheduled_at, attempt_ids_json, attempt_count
+          ) values (?, 'pending', ?, '[]', 0)`,
+        ).run(randomUUID(), new Date().toISOString());
+      }
+      if (!active) {
+        active = drain().finally(() => {
+          active = undefined;
+        });
+      }
+      const completion = active;
+      return () => completion;
+    };
+    return request;
+  };
+
+  async function drain() {
+    const failures: unknown[] = [];
+    while (!closed) {
+      const delivery = db
+        .prepare(
+          `select delivery_id, status, scheduled_at, attempt_ids_json,
+                  attempt_count, last_error
+           from specter_reaction_deliveries
+           where status = 'pending' order by rowid asc limit 1`,
+        )
+        .get() as DeliveryRow | undefined;
+      if (!delivery) break;
+      let completed = false;
+      let lastError: unknown;
+      const manualRetry = delivery.last_error === "__specter_manual_retry__";
+      const maximumAttempts = manualRetry ? delivery.attempt_count + 3 : 3;
+      while (delivery.attempt_count < maximumAttempts) {
+        delivery.attempt_count += 1;
+        const attemptId = randomUUID();
+        const attemptIds = JSON.parse(delivery.attempt_ids_json) as string[];
+        attemptIds.push(attemptId);
+        delivery.attempt_ids_json = JSON.stringify(attemptIds);
+        db.prepare(
+          `update specter_reaction_deliveries set
+             status = 'running', attempt_count = ?, attempt_ids_json = ?, last_error = null
+           where delivery_id = ?`,
+        ).run(
+          delivery.attempt_count,
+          delivery.attempt_ids_json,
+          delivery.delivery_id,
+        );
+        try {
+          await runCurrent?.({
+            deliveryId: delivery.delivery_id,
+            scheduledAt: delivery.scheduled_at,
+            attemptId,
+            attemptNumber: delivery.attempt_count,
+          });
+          db.prepare(
+            `update specter_reaction_deliveries set status = 'completed', last_error = null
+             where delivery_id = ?`,
+          ).run(delivery.delivery_id);
+          completed = true;
+          break;
+        } catch (error) {
+          lastError = error;
+          db.prepare(
+            `update specter_reaction_deliveries set last_error = ? where delivery_id = ?`,
+          ).run(
+            error instanceof Error ? error.message : String(error),
+            delivery.delivery_id,
+          );
+        }
+      }
+      if (!completed) {
+        db.prepare(
+          `update specter_reaction_deliveries set status = 'dead-letter' where delivery_id = ?`,
+        ).run(delivery.delivery_id);
+        failures.push(lastError);
+      }
+    }
+    if (failures.length > 0) throw failures[0];
+  }
+
+  return {
+    schedule,
+    async close(options?: { readonly crash?: boolean }) {
+      closed = true;
+      if (!options?.crash && active) await active;
+    },
+  };
+}
+
+export function resetVerifierRecords(dataDir: string) {
+  const domainDb = new Database(path.join(dataDir, "db.db"));
+  prepareKarakeepSpecterDatabase(domainDb);
+  domainDb.exec(
+    "delete from specter_commits; delete from specter_events; delete from specter_slice_state;",
+  );
+  domainDb
+    .prepare("delete from sqlite_sequence where name = 'specter_events'")
+    .run();
+  domainDb.close();
+  const queueDb = new Database(path.join(dataDir, "queue.db"));
+  prepareQueueDatabase(queueDb);
+  queueDb.prepare("delete from specter_reaction_deliveries").run();
+  queueDb.close();
+}
+
+export function openVerifierRuntime(dataDir: string): AdapterHarnessRuntime {
+  const domainDb = new Database(path.join(dataDir, "db.db"));
+  const queueDb = new Database(path.join(dataDir, "queue.db"));
+  prepareKarakeepSpecterDatabase(domainDb);
+  prepareQueueDatabase(queueDb, true);
+  const scheduler = createScheduler(queueDb);
+  return {
+    eventLog: createKarakeepEventLog(domainDb),
+    sliceStore: createKarakeepProbeSliceStore(domainDb),
+    schedule: scheduler.schedule,
+    async close(options) {
+      await scheduler.close(options);
+      domainDb.close();
+      queueDb.close();
+    },
+  };
+}
+
+export function createKarakeepReactionScheduler(dataDir: string) {
+  const db = new Database(path.join(dataDir, "queue.db"));
+  prepareQueueDatabase(db, true);
+  const scheduler = createScheduler(db);
+  return {
+    schedule: scheduler.schedule,
+    async close() {
+      await scheduler.close();
+      db.close();
+    },
+  };
+}
+
+export function verifierDeliveries(
+  dataDir: string,
+): ReactionDeliverySnapshot[] {
+  const db = new Database(path.join(dataDir, "queue.db"));
+  prepareQueueDatabase(db);
+  const rows = deliveryRows(db);
+  db.close();
+  return rows.map((row) => ({
+    deliveryId: row.delivery_id,
+    status: row.status,
+    scheduledAt: row.scheduled_at,
+    attemptIds: JSON.parse(row.attempt_ids_json) as string[],
+    attemptCount: row.attempt_count,
+    ...(row.last_error === null ? {} : { lastError: row.last_error }),
+  }));
+}
+
+export function retryVerifierDeadLetter(dataDir: string, deliveryId: string) {
+  const db = new Database(path.join(dataDir, "queue.db"));
+  prepareQueueDatabase(db);
+  db.prepare(
+    `update specter_reaction_deliveries
+     set status = 'pending', last_error = '__specter_manual_retry__'
+     where delivery_id = ? and status = 'dead-letter'`,
+  ).run(deliveryId);
+  db.close();
+}
