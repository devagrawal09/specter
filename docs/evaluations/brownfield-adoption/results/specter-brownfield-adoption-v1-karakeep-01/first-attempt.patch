index 0000000000000000000000000000000000000000..53bbe129a5ae3178caa63dc727073094fd1511ca
--- /dev/null
+++ b/packages/trpc/specter/list-membership-restart.test.ts
@@ -0,0 +1,163 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import Database from "better-sqlite3";
+import { drizzle } from "drizzle-orm/better-sqlite3";
+import { afterEach, expect, test, vi } from "vitest";
+
+import { createSpecterApp } from "@specter-ts/core";
+import type { DB } from "@karakeep/db/drizzle";
+
+import {
+  createKarakeepDatabaseSliceStore,
+  createKarakeepEventLog,
+  createKarakeepReactionScheduler,
+  prepareKarakeepSpecterDatabase,
+} from "../../../specter-evaluation/application-adapters";
+import { RuleEngine } from "../lib/ruleEngine";
+import { listMembershipEvents } from "./add-bookmark-to-list/events";
+import { createAddBookmarkToList } from "./add-bookmark-to-list/impl";
+import { createProjectBookmarkAddedToList } from "./project-bookmark-added-to-list/impl";
+
+let testDirectory: string | undefined;
+
+afterEach(async () => {
+  vi.restoreAllMocks();
+  if (testDirectory) await rm(testDirectory, { recursive: true, force: true });
+  testDirectory = undefined;
+});
+
+test("restart replay reconstructs legacy memberships and duplicate decisions append no Event", async () => {
+  testDirectory = await mkdtemp(
+    path.join(tmpdir(), "karakeep-specter-restart-"),
+  );
+  const sqlite = new Database(path.join(testDirectory, "db.db"));
+  prepareKarakeepSpecterDatabase(sqlite);
+  sqlite.exec(`
+    create table bookmarkLists (id text primary key, type text not null);
+    create table bookmarks (id text primary key, userId text not null);
+    create table bookmarksInLists (
+      bookmarkId text not null,
+      listId text not null,
+      addedAt integer,
+      listMembershipId text,
+      primary key(bookmarkId, listId)
+    );
+    create table specter_list_decision_lists (
+      list_id text primary key,
+      list_type text not null
+    );
+    create table specter_list_decision_memberships (
+      list_id text not null,
+      bookmark_id text not null,
+      primary key(list_id, bookmark_id)
+    );
+    create table specter_list_latest_effect (
+      singleton integer primary key,
+      effect_json text not null
+    );
+    insert into bookmarkLists values ('list-1', 'manual');
+    insert into bookmarks values ('bookmark-1', 'user-1');
+    insert into bookmarks values ('bookmark-2', 'user-1');
+  `);
+  const db = drizzle(sqlite) as unknown as DB;
+  vi.spyOn(RuleEngine, "triggerOnEvent").mockResolvedValue();
+
+  async function open() {
+    const eventLog = createKarakeepEventLog(sqlite);
+    const store = createKarakeepDatabaseSliceStore(sqlite);
+    const scheduler = createKarakeepReactionScheduler(testDirectory!);
+    const app = await createSpecterApp({
+      events: listMembershipEvents,
+      eventLog,
+      schedule: scheduler.schedule,
+      slices: [
+        createAddBookmarkToList(store),
+        createProjectBookmarkAddedToList(store, db),
+      ],
+    });
+    return { app, eventLog, scheduler };
+  }
+
+  const first = await open();
+  await first.eventLog.append([
+    {
+      type: "bookmark-list-bootstrapped",
+      payload: { listId: "list-1", type: "manual" },
+    },
+  ]);
+  const firstExecution = await first.app.command({
+    type: "addBookmarkToList",
+    payload: {
+      listId: "list-1",
+      bookmarkId: "bookmark-1",
+      userId: "user-1",
+      listMembershipId: null,
+      addedAt: "2026-07-18T12:00:00.000Z",
+    },
+  });
+  await firstExecution.reactions;
+  await expect(
+    first.app.command({
+      type: "addBookmarkToList",
+      payload: {
+        listId: "list-1",
+        bookmarkId: "bookmark-1",
+        userId: "user-1",
+        listMembershipId: null,
+        addedAt: "2026-07-18T12:01:00.000Z",
+      },
+    }),
+  ).rejects.toThrow("Bookmark is already in list");
+  expect(await first.eventLog.currentVersion()).toBe(2);
+  await first.scheduler.close();
+
+  sqlite.exec(`
+    delete from bookmarksInLists;
+    delete from specter_list_latest_effect;
+    delete from specter_slice_state where slice_name = 'projectBookmarkAddedToList';
+  `);
+
+  const reopened = await open();
+  const secondExecution = await reopened.app.command({
+    type: "addBookmarkToList",
+    payload: {
+      listId: "list-1",
+      bookmarkId: "bookmark-2",
+      userId: "user-1",
+      listMembershipId: null,
+      addedAt: "2026-07-18T12:02:00.000Z",
+    },
+  });
+  await secondExecution.reactions;
+
+  expect(
+    sqlite
+      .prepare(
+        "select bookmarkId from bookmarksInLists order by bookmarkId asc",
+      )
+      .all(),
+  ).toEqual([{ bookmarkId: "bookmark-1" }, { bookmarkId: "bookmark-2" }]);
+  expect(
+    (await reopened.eventLog.query(0, ["bookmark-added-to-list"])).map(
+      (event) => event.payload,
+    ),
+  ).toEqual([
+    {
+      listId: "list-1",
+      bookmarkId: "bookmark-1",
+      userId: "user-1",
+      listMembershipId: null,
+      addedAt: "2026-07-18T12:00:00.000Z",
+    },
+    {
+      listId: "list-1",
+      bookmarkId: "bookmark-2",
+      userId: "user-1",
+      listMembershipId: null,
+      addedAt: "2026-07-18T12:02:00.000Z",
+    },
+  ]);
+  await reopened.scheduler.close();
+  sqlite.close();
+});
