+});
+
+afterAll(() => sqlite.close());
diff --git a/packages/trpc/specter/list-membership-service.ts b/packages/trpc/specter/list-membership-service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e027d4ee6676792a5d8195ef50b6f39b24a44be
--- /dev/null
+++ b/packages/trpc/specter/list-membership-service.ts
@@ -0,0 +1,160 @@
+import type Database from "better-sqlite3";
+import {
+  createSpecterApp,
+  SpecterCommandRejectedError,
+} from "@specter-ts/core";
+
+import type { DB } from "@karakeep/db/drizzle";
+import serverConfig from "@karakeep/shared/config";
+
+import {
+  createKarakeepDatabaseSliceStore,
+  createKarakeepEventLog,
+  createKarakeepReactionScheduler,
+  prepareKarakeepSpecterDatabase,
+} from "../../../specter-evaluation/application-adapters";
+import { createAddBookmarkToList } from "./add-bookmark-to-list/impl";
+import { listMembershipEvents } from "./add-bookmark-to-list/events";
+import { createProjectBookmarkAddedToList } from "./project-bookmark-added-to-list/impl";
+
+type Sqlite = InstanceType<typeof Database>;
+
+const runtimes = new WeakMap<Sqlite, ReturnType<typeof buildRuntime>>();
+
+function prepareDomainProjectionTables(sqlite: Sqlite) {
+  prepareKarakeepSpecterDatabase(sqlite);
+  sqlite.exec(`
+    create table if not exists specter_list_decision_lists (
+      list_id text primary key,
+      list_type text not null
+    );
+    create table if not exists specter_list_decision_memberships (
+      list_id text not null,
+      bookmark_id text not null,
+      primary key(list_id, bookmark_id)
+    );
+    create table if not exists specter_list_latest_effect (
+      singleton integer primary key check(singleton = 1),
+      effect_json text not null
+    );
+  `);
+}
+
+async function buildRuntime(db: DB) {
+  const sqlite = db.$client;
+  prepareDomainProjectionTables(sqlite);
+  const eventLog = createKarakeepEventLog(sqlite);
+  const sliceStore = createKarakeepDatabaseSliceStore(sqlite);
+  const scheduler = createKarakeepReactionScheduler(serverConfig.dataDir);
+  const app = await createSpecterApp({
+    events: listMembershipEvents,
+    eventLog,
+    schedule: scheduler.schedule,
+    slices: [
+      createAddBookmarkToList(sliceStore),
+      createProjectBookmarkAddedToList(sliceStore, db),
+    ],
+  });
+  return { app, eventLog };
+}
+
+async function runtimeFor(db: DB) {
+  const sqlite = db.$client;
+  let runtime = runtimes.get(sqlite);
+  if (!runtime) {
+    runtime = buildRuntime(db);
+    runtimes.set(sqlite, runtime);
+  }
+  return runtime;
+}
+
+async function bootstrapCurrentMemberships(db: DB) {
+  const { eventLog } = await runtimeFor(db);
+  const sqlite = db.$client;
+  const lists = sqlite
+    .prepare("select id, type from bookmarkLists order by id")
+    .all() as { id: string; type: "manual" | "smart" }[];
+  for (const list of lists) {
+    const key = `karakeep-list-bootstrap-v1:${list.id}`;
+    if (await eventLog.findCommit(key)) continue;
+    await eventLog.append(
+      [
+        {
+          type: "bookmark-list-bootstrapped",
+          payload: { listId: list.id, type: list.type },
+        },
+      ],
+      { idempotencyKey: key, fingerprint: "bookmark-list-bootstrap-v1" },
+    );
+  }
+  const memberships = sqlite
+    .prepare(
+      `select m.listId as listId, m.bookmarkId as bookmarkId,
+              b.userId as userId, m.listMembershipId as listMembershipId,
+              m.addedAt as addedAt
+       from bookmarksInLists m
+       join bookmarks b on b.id = m.bookmarkId
+       order by m.listId, m.bookmarkId`,
+    )
+    .all() as {
+    listId: string;
+    bookmarkId: string;
+    userId: string;
+    listMembershipId: string | null;
+    addedAt: number | null;
+  }[];
+  const domainMemberships = new Set(
+    (await eventLog.query(0, ["bookmark-added-to-list"])).map((event) => {
+      const payload = event.payload as { listId: string; bookmarkId: string };
+      return `${payload.listId}:${payload.bookmarkId}`;
+    }),
+  );
+  for (const membership of memberships) {
+    if (
+      domainMemberships.has(`${membership.listId}:${membership.bookmarkId}`)
+    ) {
+      continue;
+    }
+    const key = `karakeep-membership-bootstrap-v1:${membership.listId}:${membership.bookmarkId}`;
+    if (await eventLog.findCommit(key)) continue;
+    await eventLog.append(
+      [{ type: "bookmark-list-membership-bootstrapped", payload: membership }],
+      {
+        idempotencyKey: key,
+        fingerprint: "bookmark-list-membership-bootstrap-v1",
+      },
+    );
+  }
+}
+
+export async function addBookmarkToListWithSpecter(
+  db: DB,
+  input: {
+    listId: string;
+    bookmarkId: string;
+    userId: string;
+    listMembershipId: string | null;
+    addedAt: string;
+  },
+) {
+  await bootstrapCurrentMemberships(db);
+  const { app } = await runtimeFor(db);
+  try {
+    const execution = await app.command({
+      type: "addBookmarkToList",
+      payload: input,
+    });
+    await execution.reactions;
+    return "added" as const;
+  } catch (error) {
+    if (error instanceof SpecterCommandRejectedError) {
+      const reason =
+        error.cause instanceof Error ? error.cause.message : error.message;
+      if (reason === "Bookmark is already in list")
+        return "already-present" as const;
+      if (reason === "Smart lists cannot be added to")
+        return "smart-list" as const;
+    }
+    throw error;
+  }
+}
