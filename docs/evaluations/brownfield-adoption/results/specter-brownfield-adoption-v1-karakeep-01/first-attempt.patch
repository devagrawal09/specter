diff --git a/packages/trpc/specter/add-bookmark-to-list/events.ts b/packages/trpc/specter/add-bookmark-to-list/events.ts
new file mode 100644
index 0000000000000000000000000000000000000000..342c1aee9ce864914e3a665e25fae46f9cc85a04
--- /dev/null
+++ b/packages/trpc/specter/add-bookmark-to-list/events.ts
@@ -0,0 +1,38 @@
+import { createEventDefinition } from "@specter-ts/core";
+import { z } from "zod";
+
+export const bookmarkListBootstrapped = createEventDefinition(
+  "bookmark-list-bootstrapped",
+  z.object({
+    listId: z.string().min(1),
+    type: z.enum(["manual", "smart"]),
+  }),
+);
+
+export const bookmarkListMembershipBootstrapped = createEventDefinition(
+  "bookmark-list-membership-bootstrapped",
+  z.object({
+    listId: z.string().min(1),
+    bookmarkId: z.string().min(1),
+    userId: z.string().min(1),
+    listMembershipId: z.string().nullable(),
+    addedAt: z.number().int().nullable(),
+  }),
+);
+
+export const bookmarkAddedToList = createEventDefinition(
+  "bookmark-added-to-list",
+  z.object({
+    listId: z.string().min(1),
+    bookmarkId: z.string().min(1),
+    userId: z.string().min(1),
+    listMembershipId: z.string().nullable(),
+    addedAt: z.string().datetime(),
+  }),
+);
+
+export const listMembershipEvents = [
+  bookmarkListBootstrapped,
+  bookmarkListMembershipBootstrapped,
+  bookmarkAddedToList,
+] as const;
diff --git a/packages/trpc/specter/add-bookmark-to-list/impl.ts b/packages/trpc/specter/add-bookmark-to-list/impl.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d0fab3e5ed8eb2ff8e515015732f53407fac4e40
--- /dev/null
+++ b/packages/trpc/specter/add-bookmark-to-list/impl.ts
@@ -0,0 +1,66 @@
+import type Database from "better-sqlite3";
+import type { SliceStoreAdapter } from "@specter-ts/core";
+import { z } from "zod";
+
+import {
+  bookmarkAddedToList,
+  bookmarkListBootstrapped,
+  bookmarkListMembershipBootstrapped,
+} from "./events";
+import { addBookmarkToListSpec } from "./spec";
+
+type Sqlite = InstanceType<typeof Database>;
+
+export function createAddBookmarkToList(
+  store: SliceStoreAdapter<Sqlite, Sqlite>,
+) {
+  return addBookmarkToListSpec
+    .inputSchema(
+      z.object({
+        listId: z.string().min(1),
+        bookmarkId: z.string().min(1),
+        userId: z.string().min(1),
+        listMembershipId: z.string().nullable(),
+        addedAt: z.string().datetime(),
+      }),
+    )
+    .store(store)
+    .apply(bookmarkListBootstrapped, async (event, db) => {
+      db.prepare(
+        `insert into specter_list_decision_lists(list_id, list_type)
+         values (?, ?)
+         on conflict(list_id) do update set list_type = excluded.list_type`,
+      ).run(event.payload.listId, event.payload.type);
+    })
+    .apply(bookmarkListMembershipBootstrapped, async (event, db) => {
+      db.prepare(
+        `insert or ignore into specter_list_decision_memberships(list_id, bookmark_id)
+         values (?, ?)`,
+      ).run(event.payload.listId, event.payload.bookmarkId);
+    })
+    .apply(bookmarkAddedToList, async (event, db) => {
+      db.prepare(
+        `insert or ignore into specter_list_decision_memberships(list_id, bookmark_id)
+         values (?, ?)`,
+      ).run(event.payload.listId, event.payload.bookmarkId);
+    })
+    .handle(async (command, db) => {
+      const list = db
+        .prepare(
+          "select list_type from specter_list_decision_lists where list_id = ?",
+        )
+        .get(command.listId) as { list_type: "manual" | "smart" } | undefined;
+      if (list?.list_type === "smart") {
+        throw new Error("Smart lists cannot be added to");
+      }
+      if (!list) throw new Error("List not found");
+      const existing = db
+        .prepare(
+          `select 1 from specter_list_decision_memberships
+           where list_id = ? and bookmark_id = ?`,
+        )
+        .get(command.listId, command.bookmarkId);
+      if (existing) throw new Error("Bookmark is already in list");
+      return [bookmarkAddedToList.create(command)];
+    });
+}
diff --git a/packages/trpc/specter/add-bookmark-to-list/spec.ts b/packages/trpc/specter/add-bookmark-to-list/spec.ts
