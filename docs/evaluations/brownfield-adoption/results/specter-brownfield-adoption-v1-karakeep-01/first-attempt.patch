+import type Database from "better-sqlite3";
+import type {
+  ReactionDeliveryContext,
+  SliceStoreAdapter,
+} from "@specter-ts/core";
+import { z } from "zod";
+
+import type { DB } from "@karakeep/db/drizzle";
+
+import { RuleEngine } from "../../lib/ruleEngine";
+import {
+  bookmarkAddedToList,
+  bookmarkListMembershipBootstrapped,
+} from "../add-bookmark-to-list/events";
+import { projectBookmarkAddedToListSpec } from "./spec";
+
+type Sqlite = InstanceType<typeof Database>;
+
+export function createProjectBookmarkAddedToList(
+  store: SliceStoreAdapter<Sqlite, Sqlite>,
+  db: DB,
+) {
+  return projectBookmarkAddedToListSpec
+    .outputSchema(
+      z.object({
+        listId: z.string().min(1),
+        bookmarkId: z.string().min(1),
+        userId: z.string().min(1),
+      }),
+    )
+    .plugin(async () => async (effect, context: ReactionDeliveryContext) => {
+      await RuleEngine.triggerOnEvent(
+        effect.userId,
+        effect.bookmarkId,
+        [{ type: "addedToList", listId: effect.listId }],
+        { idempotencyKey: `${context.deliveryId}:rule-engine` },
+        db,
+      );
+    })
+    .store(store)
+    .apply(bookmarkListMembershipBootstrapped, async (event, sqlite) => {
+      sqlite
+        .prepare(
+          `insert or ignore into bookmarksInLists(
+          bookmarkId, listId, addedAt, listMembershipId
+        ) values (?, ?, ?, ?)`,
+        )
+        .run(
+          event.payload.bookmarkId,
+          event.payload.listId,
+          event.payload.addedAt,
+          event.payload.listMembershipId,
+        );
+      sqlite.prepare("delete from specter_list_latest_effect").run();
+    })
+    .apply(bookmarkAddedToList, async (event, sqlite) => {
+      sqlite
+        .prepare(
+          `insert or ignore into bookmarksInLists(
+          bookmarkId, listId, addedAt, listMembershipId
+        ) values (?, ?, ?, ?)`,
+        )
+        .run(
+          event.payload.bookmarkId,
+          event.payload.listId,
+          Math.floor(Date.parse(event.payload.addedAt) / 1000),
+          event.payload.listMembershipId,
+        );
+      sqlite
+        .prepare(
+          `insert into specter_list_latest_effect(singleton, effect_json)
+           values (1, ?)
+           on conflict(singleton) do update set effect_json = excluded.effect_json`,
+        )
+        .run(
+          JSON.stringify({
+            listId: event.payload.listId,
+            bookmarkId: event.payload.bookmarkId,
+            userId: event.payload.userId,
+          }),
+        );
+    })
+    .handle(async (sqlite) => {
+      const row = sqlite
+        .prepare(
+          "select effect_json from specter_list_latest_effect where singleton = 1",
+        )
+        .get() as { effect_json: string } | undefined;
+      return row
+        ? (JSON.parse(row.effect_json) as {
+            listId: string;
+            bookmarkId: string;
+            userId: string;
+          })
+        : undefined;
+    });
+}
