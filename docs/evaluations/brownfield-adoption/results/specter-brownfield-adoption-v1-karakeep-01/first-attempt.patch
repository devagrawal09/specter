@@ -0,0 +1,107 @@
+import { createCommandSlice, event } from "@specter-ts/core/spec";
+
+export const addBookmarkToListSpec = createCommandSlice("addBookmarkToList")
+  .description("Adds an owned bookmark to one editable manual list.")
+  .scenarios(
+    {
+      description: "Adds a bookmark to a bootstrapped manual list.",
+      given: [
+        event("bookmark-list-bootstrapped", {
+          listId: "list-1",
+          type: "manual",
+        }),
+      ],
+      when: {
+        listId: "list-1",
+        bookmarkId: "bookmark-1",
+        userId: "user-1",
+        listMembershipId: null,
+        addedAt: "2026-07-18T12:00:00.000Z",
+      },
+      expect: [
+        event("bookmark-added-to-list", {
+          listId: "list-1",
+          bookmarkId: "bookmark-1",
+          userId: "user-1",
+          listMembershipId: null,
+          addedAt: "2026-07-18T12:00:00.000Z",
+        }),
+      ],
+    },
+    {
+      description:
+        "Adds another bookmark while preserving bootstrapped membership state.",
+      given: [
+        event("bookmark-list-bootstrapped", {
+          listId: "list-1",
+          type: "manual",
+        }),
+        event("bookmark-list-membership-bootstrapped", {
+          listId: "list-1",
+          bookmarkId: "bookmark-existing",
+          userId: "user-1",
+          listMembershipId: null,
+          addedAt: 1_768_435_200,
+        }),
+      ],
+      when: {
+        listId: "list-1",
+        bookmarkId: "bookmark-2",
+        userId: "user-1",
+        listMembershipId: null,
+        addedAt: "2026-07-18T12:00:00.000Z",
+      },
+      expect: [
+        event("bookmark-added-to-list", {
+          listId: "list-1",
+          bookmarkId: "bookmark-2",
+          userId: "user-1",
+          listMembershipId: null,
+          addedAt: "2026-07-18T12:00:00.000Z",
+        }),
+      ],
+    },
+    {
+      description: "Rejects adding to a smart list.",
+      given: [
+        event("bookmark-list-bootstrapped", {
+          listId: "smart-list-1",
+          type: "smart",
+        }),
+      ],
+      when: {
+        listId: "smart-list-1",
+        bookmarkId: "bookmark-1",
+        userId: "user-1",
+        listMembershipId: null,
+        addedAt: "2026-07-18T12:00:00.000Z",
+      },
+      expect: [],
+      reject: { reason: "Smart lists cannot be added to" },
+    },
+    {
+      description: "Rejects a repeated manual-list membership.",
+      given: [
+        event("bookmark-list-bootstrapped", {
+          listId: "list-1",
+          type: "manual",
+        }),
+        event("bookmark-added-to-list", {
+          listId: "list-1",
+          bookmarkId: "bookmark-1",
+          userId: "user-1",
+          listMembershipId: null,
+          addedAt: "2026-07-18T12:00:00.000Z",
+        }),
+      ],
+      when: {
+        listId: "list-1",
+        bookmarkId: "bookmark-1",
+        userId: "user-1",
+        listMembershipId: null,
+        addedAt: "2026-07-18T12:01:00.000Z",
+      },
+      expect: [],
+      reject: { reason: "Bookmark is already in list" },
+    },
+  );
