+function finalizeOwnedSqlite(db: Sqlite) {
+  if (db.inTransaction) {
+    throw new Error(
+      "Cannot finalize an owned SQLite connection in a transaction",
+    );
+  }
+  db.pragma("wal_checkpoint(TRUNCATE)");
+  const journalMode = db.pragma("journal_mode = DELETE", {
+    simple: true,
+  }) as string;
+  if (journalMode.toLowerCase() !== "delete") {
+    throw new Error(
+      `Expected owned SQLite connection to hand off in DELETE mode, received ${journalMode}`,
+    );
+  }
+}
+
