diff --git a/specter-evaluation/run-public-app.mjs b/specter-evaluation/run-public-app.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0ab6beb348ef3a066b2822d05910ed3feb64a462
--- /dev/null
+++ b/specter-evaluation/run-public-app.mjs
@@ -0,0 +1,60 @@
+import { spawn } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { createServer } from "node:net";
+import dotenv from "@dotenvx/dotenvx";
+
+const host = "127.0.0.1";
+const port = 42135;
+const probe = createServer();
+const testEnvironment = dotenv.parse(
+  readFileSync(new URL("../.env.test", import.meta.url), "utf8")
+);
+
+await new Promise((resolve, reject) => {
+  probe.once("error", reject);
+  probe.listen(port, host, () => {
+    probe.close((error) => {
+      if (error) {
+        reject(error);
+        return;
+      }
+
+      resolve();
+    });
+  });
+});
+
+const child = spawn(
+  process.execPath,
+  ["./build/server/index.js", "--services=web"],
+  {
+    env: {
+      ...process.env,
+      ...testEnvironment,
+      ENABLE_UPDATES: "false",
+      FORCE_HTTPS: "false",
+      NODE_ENV: "production",
+      PGSSLMODE: "disable",
+      PORT: String(port),
+      URL: `http://${host}:${port}`,
+      WEB_CONCURRENCY: "1",
+    },
+    stdio: "inherit",
+  }
+);
+
+let terminating = false;
+
+for (const signal of ["SIGINT", "SIGTERM"]) {
+  process.once(signal, () => {
+    terminating = true;
+    child.kill(signal);
+  });
+}
+
+const exitCode = await new Promise((resolve, reject) => {
+  child.once("error", reject);
+  child.once("exit", (code) => resolve(code));
+});
+
+process.exitCode = terminating ? 0 : (exitCode ?? 1);
diff --git a/specter-evaluation/setup-legacy-snapshot.ts b/specter-evaluation/setup-legacy-snapshot.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eee42342ea144ba9268bc1a91993e3bc99ec7ec4
--- /dev/null
+++ b/specter-evaluation/setup-legacy-snapshot.ts
@@ -0,0 +1,184 @@
+import { Op } from "sequelize";
+import { UserRole } from "@shared/types";
+import {
+  AccessRequest,
+  Collection,
+  Document,
+  Event,
+  Notification,
+  Team,
+  User,
+  UserMembership,
+} from "@server/models";
+import { AccessRequestStatus } from "@server/models/AccessRequest";
+import { sequelize } from "@server/storage/database";
+import {
+  buildAdmin,
+  buildCollection,
+  buildDocument,
+  buildTeam,
+  buildUser,
+} from "@server/test/factories";
+import snapshot from "./legacy-snapshot.json";
+
+export interface LegacySnapshotFixture {
+  team: Team;
+  manager: User;
+  legacyRequester: User;
+  freshRequester: User;
+  privateCollection: Collection;
+  document: Document;
+  pendingAccessRequest: AccessRequest;
+}
+
+/**
+ * Removes every database row owned by the fixed evaluation snapshot.
+ *
+ * @returns a promise that resolves when cleanup is complete.
+ */
+export async function cleanupLegacySnapshot(): Promise<void> {
+  const userIds = [
+    snapshot.manager.id,
+    snapshot.legacyRequester.id,
+    snapshot.freshRequester.id,
+  ];
+
+  await sequelize.authenticate();
+  await Notification.destroy({
+    where: { teamId: snapshot.team.id },
+    force: true,
+  });
+  await Event.destroy({
+    where: { teamId: snapshot.team.id },
+    force: true,
+  });
+  await AccessRequest.destroy({
+    where: {
+      [Op.or]: [
+        { id: snapshot.pendingAccessRequest.id },
+        { documentId: snapshot.document.id },
+      ],
+    },
+    force: true,
+  });
+  await UserMembership.destroy({
+    where: {
+      [Op.or]: [
+        { collectionId: snapshot.privateCollection.id },
+        { documentId: snapshot.document.id },
+        { userId: { [Op.in]: userIds } },
+      ],
+    },
+    force: true,
+  });
+  await Document.destroy({
+    where: { id: snapshot.document.id },
+    force: true,
+  });
+  await Collection.destroy({
+    where: { id: snapshot.privateCollection.id },
+    force: true,
+  });
+  await User.destroy({
+    where: { id: { [Op.in]: userIds } },
+    force: true,
+  });
+  await Team.destroy({
+    where: { id: snapshot.team.id },
+    force: true,
+  });
+}
+
+/**
+ * Recreates the fixed legacy state with Outline test factories and Sequelize.
+ *
+ * @returns the persisted fixture models.
+ */
+export async function setupLegacySnapshot(): Promise<LegacySnapshotFixture> {
+  await cleanupLegacySnapshot();
+
+  const team = await buildTeam({
+    id: snapshot.team.id,
+    name: snapshot.team.name,
+    subdomain: snapshot.team.subdomain,
+    createdAt: new Date(snapshot.team.createdAt),
+    updatedAt: new Date(snapshot.team.updatedAt),
+    authenticationProviders: [],
+  });
+  const manager = await buildAdmin({
+    id: snapshot.manager.id,
+    teamId: team.id,
+    email: snapshot.manager.email,
+    name: snapshot.manager.name,
+    role: UserRole.Admin,
+    createdAt: new Date(snapshot.manager.createdAt),
+    updatedAt: new Date(snapshot.manager.updatedAt),
+    lastActiveAt: new Date(snapshot.manager.lastActiveAt),
+  });
+  const legacyRequester = await buildUser({
+    id: snapshot.legacyRequester.id,
+    teamId: team.id,
+    email: snapshot.legacyRequester.email,
+    name: snapshot.legacyRequester.name,
+    role: UserRole.Member,
+    createdAt: new Date(snapshot.legacyRequester.createdAt),
+    updatedAt: new Date(snapshot.legacyRequester.updatedAt),
+    lastActiveAt: new Date(snapshot.legacyRequester.lastActiveAt),
+  });
+  const freshRequester = await buildUser({
+    id: snapshot.freshRequester.id,
+    teamId: team.id,
+    email: snapshot.freshRequester.email,
+    name: snapshot.freshRequester.name,
+    role: UserRole.Member,
+    createdAt: new Date(snapshot.freshRequester.createdAt),
+    updatedAt: new Date(snapshot.freshRequester.updatedAt),
+    lastActiveAt: new Date(snapshot.freshRequester.lastActiveAt),
+  });
+  const privateCollection = await buildCollection({
+    id: snapshot.privateCollection.id,
+    teamId: team.id,
+    userId: manager.id,
+    createdById: manager.id,
+    name: snapshot.privateCollection.name,
+    description: snapshot.privateCollection.description,
+    permission: null,
+    createdAt: new Date(snapshot.privateCollection.createdAt),
+    updatedAt: new Date(snapshot.privateCollection.updatedAt),
+  });
+  const document = await buildDocument({
+    id: snapshot.document.id,
+    urlId: snapshot.document.urlId,
+    teamId: team.id,
+    userId: manager.id,
+    createdById: manager.id,
+    lastModifiedById: manager.id,
+    collectionId: privateCollection.id,
+    title: snapshot.document.title,
+    text: snapshot.document.text,
+    publishedAt: new Date(snapshot.document.publishedAt),
+    createdAt: new Date(snapshot.document.createdAt),
+    updatedAt: new Date(snapshot.document.updatedAt),
+  });
+  const pendingAccessRequest = await AccessRequest.create({
+    id: snapshot.pendingAccessRequest.id,
+    teamId: team.id,
+    documentId: document.id,
+    userId: legacyRequester.id,
+    status: AccessRequestStatus.Pending,
+    responderId: null,
+    respondedAt: null,
+    createdAt: new Date(snapshot.pendingAccessRequest.createdAt),
+    updatedAt: new Date(snapshot.pendingAccessRequest.updatedAt),
+  });
+
+  return {
+    team,
+    manager,
+    legacyRequester,
+    freshRequester,
+    privateCollection,
+    document,
+    pendingAccessRequest,
+  };
+}
