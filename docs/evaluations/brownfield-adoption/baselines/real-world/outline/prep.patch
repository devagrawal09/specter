diff --git a/specter-evaluation/coordinator-acceptance.test.ts b/specter-evaluation/coordinator-acceptance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9248adc2fc44280ace5097ff5f08d02db583917f
--- /dev/null
+++ b/specter-evaluation/coordinator-acceptance.test.ts
@@ -0,0 +1,259 @@
+import { NotificationEventType } from "@shared/types";
+import { AccessRequest, Event, Notification } from "@server/models";
+import { AccessRequestStatus } from "@server/models/AccessRequest";
+import { globalEventQueue, taskQueue } from "@server/queues";
+import NotificationsProcessor from "@server/queues/processors/NotificationsProcessor";
+import DocumentAccessRequestNotificationsTask from "@server/queues/tasks/DocumentAccessRequestNotificationsTask";
+import { TaskPriority } from "@server/queues/tasks/base/BaseTask";
+import { getTestServer } from "@server/test/support";
+import type { AccessRequestEvent } from "@server/types";
+import {
+  cleanupLegacySnapshot,
+  type LegacySnapshotFixture,
+  setupLegacySnapshot,
+} from "./setup-legacy-snapshot";
+
+interface AccessRequestData {
+  id: string;
+  documentId: string;
+  userId: string;
+  teamId: string;
+  status: AccessRequestStatus;
+  responderId: string | null;
+  respondedAt: string | null;
+  createdAt: string;
+  updatedAt: string;
+}
+
+interface AccessRequestResponse {
+  data: AccessRequestData;
+  policies: Record<string, boolean>;
+}
+
+interface ScheduledAccessRequestTask {
+  name: "DocumentAccessRequestNotificationsTask";
+  props: AccessRequestEvent;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
+
+function isAccessRequestEvent(value: unknown): value is AccessRequestEvent {
+  return (
+    isRecord(value) &&
+    value.name === "access_requests.create" &&
+    typeof value.modelId === "string" &&
+    typeof value.documentId === "string" &&
+    typeof value.teamId === "string" &&
+    typeof value.actorId === "string" &&
+    (typeof value.ip === "string" || value.ip === null)
+  );
+}
+
+function isScheduledAccessRequestTask(
+  value: unknown
+): value is ScheduledAccessRequestTask {
+  return (
+    isRecord(value) &&
+    value.name === "DocumentAccessRequestNotificationsTask" &&
+    isAccessRequestEvent(value.props)
+  );
+}
+
+const server = getTestServer();
+let fixture: LegacySnapshotFixture;
+
+beforeEach(async () => {
+  fixture = await setupLegacySnapshot();
+});
+
+afterEach(async () => {
+  vi.restoreAllMocks();
+  await cleanupLegacySnapshot();
+});
+
+describe("Outline brownfield coordinator acceptance", () => {
+  it("preserves accepted access-request creation", async () => {
+    const response = await server.post(
+      "/api/accessRequests.create",
+      fixture.freshRequester,
+      { body: { documentId: fixture.document.id } }
+    );
+    const body: AccessRequestResponse = await response.json();
+
+    expect(response.status).toEqual(200);
+    expect(body.data).toMatchObject({
+      documentId: fixture.document.id,
+      userId: fixture.freshRequester.id,
+      teamId: fixture.team.id,
+      status: AccessRequestStatus.Pending,
+      responderId: null,
+      respondedAt: null,
+    });
+    expect(
+      await AccessRequest.count({
+        where: {
+          documentId: fixture.document.id,
+          userId: fixture.freshRequester.id,
+        },
+      })
+    ).toEqual(1);
+  });
+
+  it("rejects a repeated request without inserting a second row", async () => {
+    const first = await server.post(
+      "/api/accessRequests.create",
+      fixture.freshRequester,
+      { body: { documentId: fixture.document.id } }
+    );
+    const duplicate = await server.post(
+      "/api/accessRequests.create",
+      fixture.freshRequester,
+      { body: { documentId: fixture.document.id } }
+    );
+    const duplicateBody = await duplicate.json();
+
+    expect(first.status).toEqual(200);
+    expect(duplicate.status).toEqual(400);
+    expect(duplicateBody.message).toEqual(
+      "A pending access request already exists for this document and user."
+    );
+    expect(
+      await AccessRequest.count({
+        where: {
+          documentId: fixture.document.id,
+          userId: fixture.freshRequester.id,
+        },
+      })
+    ).toEqual(1);
+  });
+
+  it("rejects the fixed pre-existing pending request", async () => {
+    const response = await server.post(
+      "/api/accessRequests.create",
+      fixture.legacyRequester,
+      { body: { documentId: fixture.document.id } }
+    );
+    const body = await response.json();
+
+    expect(response.status).toEqual(400);
+    expect(body.message).toEqual(
+      "A pending access request already exists for this document and user."
+    );
+    const requests = await AccessRequest.findAll({
+      where: {
+        documentId: fixture.document.id,
+        userId: fixture.legacyRequester.id,
+      },
+    });
+    expect(requests).toHaveLength(1);
+    expect(requests[0]?.id).toEqual(fixture.pendingAccessRequest.id);
+    expect(requests[0]?.status).toEqual(AccessRequestStatus.Pending);
+  });
+
+  it("preserves the existing-access guard and exact public message", async () => {
+    const response = await server.post(
+      "/api/accessRequests.create",
+      fixture.manager,
+      { body: { documentId: fixture.document.id } }
+    );
+    const body = await response.json();
+
+    expect(response.status).toEqual(400);
+    expect(body.message).toEqual("User already has document access");
+    expect(
+      await AccessRequest.count({
+        where: {
+          documentId: fixture.document.id,
+          userId: fixture.manager.id,
+        },
+      })
+    ).toEqual(0);
+  });
+
+  it("preserves accessRequests.info reader parity", async () => {
+    const createResponse = await server.post(
+      "/api/accessRequests.create",
+      fixture.freshRequester,
+      { body: { documentId: fixture.document.id } }
+    );
+    const created: AccessRequestResponse = await createResponse.json();
+    const infoResponse = await server.post(
+      "/api/accessRequests.info",
+      fixture.freshRequester,
+      { body: { documentId: fixture.document.urlId } }
+    );
+    const info: AccessRequestResponse = await infoResponse.json();
+
+    expect(createResponse.status).toEqual(200);
+    expect(infoResponse.status).toEqual(200);
+    expect(info.data).toMatchObject(created.data);
+    expect(info.policies).toEqual(created.policies);
+  });
+
+  it("persists the route Event and schedules its notification task without sending email", async () => {
+    const globalEventAdd = vi.spyOn(globalEventQueue(), "add");
+    const taskQueueAdd = vi.spyOn(taskQueue(), "add");
+    const createResponse = await server.post(
+      "/api/accessRequests.create",
+      fixture.freshRequester,
+      { body: { documentId: fixture.document.id } }
+    );
+    const created: AccessRequestResponse = await createResponse.json();
+
+    expect(createResponse.status).toEqual(200);
+    const routeEvents = await Event.findAll({
+      where: {
+        name: "access_requests.create",
+        modelId: created.data.id,
+        documentId: fixture.document.id,
+        teamId: fixture.team.id,
+        actorId: fixture.freshRequester.id,
+      },
+    });
+    expect(routeEvents).toHaveLength(1);
+    expect(globalEventAdd).toHaveBeenCalledWith(
+      expect.objectContaining({ id: routeEvents[0]?.id })
+    );
+
+    const routeEvent = routeEvents[0]?.toJSON();
+    if (!isAccessRequestEvent(routeEvent)) {
+      throw new Error(
+        "The selected route did not persist a complete access request Event"
+      );
+    }
+
+    expect(NotificationsProcessor.applicableEvents).toContain(routeEvent.name);
+    await new NotificationsProcessor().perform(routeEvent);
+    expect(taskQueueAdd).toHaveBeenCalledTimes(1);
+    expect(taskQueueAdd).toHaveBeenCalledWith(
+      {
+        name: "DocumentAccessRequestNotificationsTask",
+        props: routeEvent,
+      },
+      expect.objectContaining({ priority: TaskPriority.Background })
+    );
+
+    const scheduledTask = taskQueueAdd.mock.calls[0]?.[0];
+    if (!isScheduledAccessRequestTask(scheduledTask)) {
+      throw new Error(
+        "NotificationsProcessor did not schedule the expected durable task"
+      );
+    }
+    await new DocumentAccessRequestNotificationsTask().perform(
+      scheduledTask.props
+    );
+
+    const notifications = await Notification.findAll({
+      where: {
+        event: NotificationEventType.RequestDocumentAccess,
+        userId: fixture.manager.id,
+        actorId: fixture.freshRequester.id,
+        documentId: fixture.document.id,
+        accessRequestId: created.data.id,
+      },
+    });
+    expect(notifications).toHaveLength(1);
+  });
+});
