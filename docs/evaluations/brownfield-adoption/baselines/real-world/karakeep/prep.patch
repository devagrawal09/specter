diff --git a/specter-evaluation/list-operation.acceptance.test.ts b/specter-evaluation/list-operation.acceptance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eaaf170d587b3f718f996be7a769caa7b2a1fb81
--- /dev/null
+++ b/specter-evaluation/list-operation.acceptance.test.ts
@@ -0,0 +1,216 @@
+import { and, eq } from "drizzle-orm";
+import { Hono } from "hono";
+import { createTRPCClient, httpBatchLink } from "@trpc/client";
+import superjson from "superjson";
+import { beforeEach, describe, expect, test, vi } from "vitest";
+
+import { bookmarksInLists } from "@karakeep/db/schema";
+import { BookmarkTypes } from "@karakeep/shared/types/bookmarks";
+import type { Context } from "@karakeep/trpc";
+import type { AppRouter } from "@karakeep/trpc/routers/_app";
+
+import apiApp from "../packages/api/index";
+import type {
+  APICallerType,
+  CustomTestContext,
+} from "../packages/trpc/testUtils";
+import { buildTestContext } from "../packages/trpc/testUtils";
+import { RuleEngine } from "../packages/trpc/lib/ruleEngine";
+
+vi.mock("@karakeep/shared-server", async (original) => {
+  const actual = (await original()) as typeof import("@karakeep/shared-server");
+  return {
+    ...actual,
+    LinkCrawlerQueue: { enqueue: vi.fn() },
+    OpenAIQueue: { enqueue: vi.fn() },
+    EmbeddingsQueue: { enqueue: vi.fn() },
+    SearchIndexingQueue: { enqueue: vi.fn() },
+    RuleEngineQueue: { enqueue: vi.fn() },
+    triggerSearchReindex: vi.fn(),
+  };
+});
+
+async function createTextBookmark(api: APICallerType) {
+  return await api.bookmarks.createBookmark({
+    type: BookmarkTypes.TEXT,
+    text: "Specter evaluation bookmark",
+  });
+}
+
+function createPublicHttpApp(context: Context) {
+  return new Hono<{ Variables: { ctx: Context } }>()
+    .basePath("/api")
+    .use("*", async (requestContext, next) => {
+      requestContext.set("ctx", context);
+      await next();
+    })
+    .route("/", apiApp);
+}
+
+function createPublicTrpcClient(context: Context) {
+  const app = createPublicHttpApp(context);
+  let lastResponse: Response | undefined;
+  const client = createTRPCClient<AppRouter>({
+    links: [
+      httpBatchLink({
+        transformer: superjson,
+        url: "http://localhost/api/trpc",
+        fetch: async (input, init) => {
+          const response = await app.request(new Request(input, init));
+          lastResponse = response.clone();
+          return response;
+        },
+      }),
+    ],
+  });
+  return {
+    client,
+    lastResponse() {
+      if (!lastResponse) throw new Error("Expected a public HTTP response");
+      return lastResponse;
+    },
+  };
+}
+
+beforeEach<CustomTestContext>(async (context) => {
+  vi.clearAllMocks();
+  Object.assign(context, await buildTestContext(true));
+});
+
+describe("coordinator-owned lists.addToList acceptance", () => {
+  test<CustomTestContext>("manual add is idempotent, preserves reader parity, and emits one Rule Engine event", async ({
+    apiCallers,
+    db,
+  }) => {
+    const api = apiCallers[0];
+    const user = await db.query.users.findFirst();
+    if (!user) throw new Error("Expected a seeded HTTP actor");
+    const httpContext: Context = {
+      user,
+      auth: { type: "session" },
+      db,
+      req: { ip: "127.0.0.1" },
+    };
+    const transport = createPublicTrpcClient(httpContext);
+    const bookmark = await createTextBookmark(api);
+    const list = await api.lists.create({
+      name: "Specter Reference",
+      type: "manual",
+      icon: "📚",
+    });
+    await api.rules.create({
+      name: "Specter added-to-list probe",
+      description: "Coordinator-owned queue assertion",
+      enabled: true,
+      event: { type: "addedToList", listIds: [list.id] },
+      condition: { type: "alwaysTrue" },
+      actions: [{ type: "favouriteBookmark" }],
+    });
+    const persistedBookmark = await db.query.bookmarks.findFirst({
+      where: (table, { eq }) => eq(table.id, bookmark.id),
+      columns: { userId: true },
+    });
+    expect(
+      await RuleEngine.matchesAnyRule(
+        persistedBookmark?.userId ?? "",
+        [{ type: "addedToList", listId: list.id }],
+        db,
+      ),
+    ).toBe(true);
+    const triggerOnEvent = vi.spyOn(RuleEngine, "triggerOnEvent");
+
+    await transport.client.lists.addToList.mutate({
+      listId: list.id,
+      bookmarkId: bookmark.id,
+    });
+    expect(transport.lastResponse().status).toBe(200);
+    await transport.client.lists.addToList.mutate({
+      listId: list.id,
+      bookmarkId: bookmark.id,
+    });
+    expect(transport.lastResponse().status).toBe(200);
+
+    const memberships = await db
+      .select()
+      .from(bookmarksInLists)
+      .where(
+        and(
+          eq(bookmarksInLists.listId, list.id),
+          eq(bookmarksInLists.bookmarkId, bookmark.id),
+        ),
+      );
+    expect(memberships).toHaveLength(1);
+
+    const listsReader = await api.lists.getListsOfBookmark({
+      bookmarkId: bookmark.id,
+    });
+    expect(listsReader.lists.map((entry) => entry.id)).toContain(list.id);
+
+    const bookmarksReader = await api.bookmarks.getBookmarks({
+      listId: list.id,
+    });
+    expect(bookmarksReader.bookmarks.map((entry) => entry.id)).toContain(
+      bookmark.id,
+    );
+
+    const listReader = await api.lists.get({ listId: list.id });
+    expect(listReader).toMatchObject({ id: list.id, type: "manual" });
+
+    const statsReader = await api.lists.stats();
+    expect(statsReader.stats.get(list.id)).toBe(1);
+
+    expect(triggerOnEvent).toHaveBeenCalledTimes(1);
+    expect(triggerOnEvent.mock.calls[0]?.slice(0, 3)).toEqual([
+      persistedBookmark?.userId,
+      bookmark.id,
+      [{ type: "addedToList", listId: list.id }],
+    ]);
+  });
+
+  test<CustomTestContext>("smart-list add preserves the public rejection and creates no membership", async ({
+    apiCallers,
+    db,
+  }) => {
+    const api = apiCallers[0];
+    const user = await db.query.users.findFirst();
+    if (!user) throw new Error("Expected a seeded HTTP actor");
+    const httpContext: Context = {
+      user,
+      auth: { type: "session" },
+      db,
+      req: { ip: "127.0.0.1" },
+    };
+    const transport = createPublicTrpcClient(httpContext);
+    const bookmark = await createTextBookmark(api);
+    const list = await api.lists.create({
+      name: "Specter Research Smart",
+      type: "smart",
+      query: "tag:research",
+      icon: "🔎",
+    });
+    const triggerOnEvent = vi.spyOn(RuleEngine, "triggerOnEvent");
+
+    await expect(
+      transport.client.lists.addToList.mutate({
+        listId: list.id,
+        bookmarkId: bookmark.id,
+      }),
+    ).rejects.toThrow("Smart lists cannot be added to");
+    expect(transport.lastResponse().status).toBe(400);
+    expect(await transport.lastResponse().text()).toContain(
+      "Smart lists cannot be added to",
+    );
+
+    const memberships = await db
+      .select()
+      .from(bookmarksInLists)
+      .where(
+        and(
+          eq(bookmarksInLists.listId, list.id),
+          eq(bookmarksInLists.bookmarkId, bookmark.id),
+        ),
+      );
+    expect(memberships).toHaveLength(0);
+    expect(triggerOnEvent).not.toHaveBeenCalled();
+  });
+});
