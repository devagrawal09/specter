diff --git a/specter-evaluation/queue-probe.ts b/specter-evaluation/queue-probe.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8bc73512e0cb23a6db09f7f14fcff702815cf506
--- /dev/null
+++ b/specter-evaluation/queue-probe.ts
@@ -0,0 +1,70 @@
+import {
+  RuleEngineQueue,
+  prepareQueue,
+} from "../packages/shared-server/index.ts";
+
+async function main() {
+  const mode = process.argv[2];
+  const expectedModes = ["enqueue", "assert-pending", "wait-drained"] as const;
+  if (!expectedModes.includes(mode as (typeof expectedModes)[number])) {
+    throw new Error(`Expected one of: ${expectedModes.join(", ")}`);
+  }
+
+  await prepareQueue();
+
+  if (mode === "enqueue") {
+    const before = await RuleEngineQueue.stats();
+    if (before.pending !== 0 || before.running !== 0) {
+      throw new Error(
+        `Rule Engine queue is not clean: ${JSON.stringify(before)}`,
+      );
+    }
+    const jobId = await RuleEngineQueue.enqueue(
+      {
+        bookmarkId: "specter-evaluation-missing-bookmark",
+        events: [
+          {
+            type: "addedToList",
+            listId: "qxhgpg4iyzxcx5i50uzugf6p",
+          },
+        ],
+      },
+      { idempotencyKey: "specter-evaluation-rule-engine-restart" },
+    );
+    const after = await RuleEngineQueue.stats();
+    if (after.pending !== 1 || after.running !== 0) {
+      throw new Error(
+        `Expected one durable pending job: ${JSON.stringify(after)}`,
+      );
+    }
+    process.stdout.write(`${JSON.stringify({ mode, jobId, stats: after })}\n`);
+  } else if (mode === "assert-pending") {
+    const stats = await RuleEngineQueue.stats();
+    if (stats.pending !== 1 || stats.running !== 0) {
+      throw new Error(
+        `Pending job did not survive restart: ${JSON.stringify(stats)}`,
+      );
+    }
+    process.stdout.write(`${JSON.stringify({ mode, stats })}\n`);
+  } else {
+    const deadline = Date.now() + 15_000;
+    while (Date.now() < deadline) {
+      const stats = await RuleEngineQueue.stats();
+      if (stats.pending === 0 && stats.running === 0) {
+        process.stdout.write(`${JSON.stringify({ mode, stats })}\n`);
+        return;
+      }
+      await new Promise((resolve) => setTimeout(resolve, 100));
+    }
+    throw new Error(
+      `Rule Engine queue did not drain: ${JSON.stringify(await RuleEngineQueue.stats())}`,
+    );
+  }
+}
+
+void main().catch((cause: unknown) => {
+  process.stderr.write(
+    `${cause instanceof Error ? cause.stack : String(cause)}\n`,
+  );
+  process.exitCode = 1;
+});
diff --git a/specter-evaluation/run-adapter-verifier.ts b/specter-evaluation/run-adapter-verifier.ts
