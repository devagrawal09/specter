{
  "name": "specter-workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @specter-ts/core build && pnpm --filter @specter/reference dev",
    "dev:kill": "fuser -k 41731/tcp || true",
    "build": "pnpm -r --filter @specter-ts/core --filter create-specter --filter @specter/reference build",
    "start": "pnpm --filter @specter/reference start",
    "preview": "pnpm --filter @specter/reference preview",
    "test": "pnpm --filter @specter/reference test",
    "typecheck": "pnpm --filter @specter-ts/core build && pnpm -r --filter @specter-ts/core --filter create-specter --filter @specter/reference typecheck",
    "db:generate": "pnpm --filter @specter/reference db:generate",
    "db:migrate": "pnpm --filter @specter/reference db:migrate",
    "db:studio": "pnpm --filter @specter/reference db:studio",
    "format": "biome format",
    "lint": "biome lint && pnpm --filter @specter/reference lint:boundaries",
    "check": "biome check",
    "release:auth": "npm whoami && npm owner ls @specter-ts/core && npm owner ls create-specter",
    "release:verify": "pnpm typecheck && pnpm test && pnpm build",
    "release:pack": "pnpm --filter @specter-ts/core pack --pack-destination /tmp/opencode && pnpm --filter create-specter pack --pack-destination /tmp/opencode",
    "release:dry-run": "pnpm release:auth && pnpm release:verify && pnpm --filter @specter-ts/core publish --dry-run --access public && pnpm --filter create-specter publish --dry-run",
    "release:publish": "pnpm release:auth && pnpm release:verify && pnpm --filter @specter-ts/core publish --access public && pnpm --filter create-specter publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "typescript": "^6.0.2"
  }
}
