# Google Cloud OAuth credentials. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development:
GOOGLE_REDIRECT_URI=http://127.0.0.1:41738/auth/google/callback
# Tailscale production example:
# GOOGLE_REDIRECT_URI=https://your-mac.your-tailnet.ts.net/auth/google/callback

# Development accepts loopback traffic. Production must use tailscale mode.
SPECTER_MAIL_ACCESS_MODE=local
# Required when SPECTER_MAIL_ACCESS_MODE=tailscale.
TAILSCALE_ALLOWED_LOGIN=you@example.com

# Local OpenAI-compatible inference is always the default.
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_MODEL=llama3.2
AI_REQUEST_TIMEOUT_MS=60000

# Optional cloud provider. Content is sent only when a request carries an
# explicit cloudOptIn=true value.
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_API_KEY=

SPECTER_MAIL_SQLITE_PATH=./data/personal-mail.db
SPECTER_MAIL_SYNC_INTERVAL_MS=300000
GMAIL_REQUEST_TIMEOUT_MS=20000
GMAIL_READ_ATTEMPTS=3
GMAIL_READ_CONCURRENCY=8
