# Optional local SQLite database path.
# Defaults to ./data/worklog.db when unset.
# WORKLOG_SQLITE_PATH=./data/worklog.db

# Optional comma-separated exact hostnames for authenticated private reverse
# proxies. The server still binds only to 127.0.0.1.
# WORKLOG_TRUSTED_HOSTNAMES=worklog.example.ts.net
# WORKLOG_TRUSTED_ORIGINS=https://worklog.example.ts.net

# Never point verification at the live default above. `dev:verify` selects an
# isolated temporary path automatically.
