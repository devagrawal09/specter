{
  "name": "@specter/reference",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "pnpm spec:build && npm run db:migrate",
    "dev": "vite dev",
    "dev:kill": "fuser -k 41731/tcp || true",
    "build": "pnpm spec:build && vite build --mode client && vite build",
    "prestart": "npm run db:migrate",
    "start": "node dist/index.js",
    "preview": "vite preview",
    "test": "pnpm spec:build && vitest run",
    "typecheck": "pnpm spec:build && tsc --noEmit",
    "spec:build": "node ../../packages/spec/dist/cli.js export src/features",
    "db:generate": "drizzle-kit generate",
    "db:prepare": "node -e \"require('node:fs').mkdirSync('data', { recursive: true })\"",
    "db:migrate": "npm run db:prepare && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "biome format",
    "lint": "biome lint && npm run lint:boundaries",
    "lint:boundaries": "node scripts/check-slice-imports.mjs && node scripts/check-client-server-imports.mjs",
    "check": "biome check"
  },
  "dependencies": {
    "@hono/node-server": "2.0.3",
    "@hono/vite-build": "1.11.1",
    "@hono/vite-dev-server": "0.25.3",
    "@libsql/client": "^0.17.3",
    "@solidjs/web": "2.0.0-beta.13",
    "@specter-ts/core": "workspace:*",
    "@specter-ts/spec": "workspace:*",
    "@specter-ts/memory": "workspace:*",
    "@specter-ts/sqlite": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.78",
    "hono": "4.12.19",
    "solid-js": "2.0.0-beta.13",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.60.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "3.0.0-next.5",
    "vitest": "^4.1.5"
  }
}
