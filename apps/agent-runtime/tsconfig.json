{
  "extends": "../../tsconfig.base.json",
  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    // @ocpp/ai and @ocpp/codemode are linked as TypeScript source and are
    // compiled under this config: they need ESNext library types and have a
    // few unused locals. Biome (pnpm lint) still flags unused code here.
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "vitest",
      "node"
    ],
    "paths": {
      "@specter-ts/core": [
        "../../packages/core/src/index.ts"
      ],
      "@specter-ts/core/testing": [
        "../../packages/core/src/testing-entry.ts"
      ],
      "@specter-ts/core/effect": [
        "../../packages/core/src/effect-entry.ts"
      ]
    }
  }
}
