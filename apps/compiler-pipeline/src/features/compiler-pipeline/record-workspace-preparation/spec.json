{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "formatVersion": 1,
  "kind": "command",
  "name": "recordWorkspacePreparation",
  "description": "Records a workspace preparation attempt without changing the frozen compilation inputs.",
  "scenarios": [
    {
      "description": "Records a prepared sandbox at the compilation source revision.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "compilation-started",
          "examplePayload": {
            "runId": "compile-001",
            "requestedAt": "2026-07-22T10:00:00.000Z",
            "sourceRevision": "git:source-001",
            "sourceTreeDigest": "sha256:source-tree-001",
            "specificationBundleDigest": "sha256:bundle-001",
            "specifications": [],
            "profile": {
              "name": "specter-solid-sqlite",
              "digest": "sha256:profile-001"
            },
            "deployment": null
          }
        }
      ],
      "when": {
        "runId": "compile-001",
        "attemptId": "workspace-attempt-001",
        "status": "prepared",
        "workspaceId": "sandbox-001",
        "preparedRevision": "git:source-001",
        "completedAt": "2026-07-22T10:01:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "workspace-prepared",
          "examplePayload": {
            "runId": "compile-001",
            "attemptId": "workspace-attempt-001",
            "workspaceId": "sandbox-001",
            "preparedRevision": "git:source-001",
            "completedAt": "2026-07-22T10:01:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Records a failed workspace attempt for deterministic retry.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "compilation-started",
          "examplePayload": {
            "runId": "compile-002",
            "requestedAt": "2026-07-22T11:00:00.000Z",
            "sourceRevision": "git:source-002",
            "sourceTreeDigest": "sha256:source-tree-002",
            "specificationBundleDigest": "sha256:bundle-002",
            "specifications": [],
            "profile": {
              "name": "specter-solid-sqlite",
              "digest": "sha256:profile-001"
            },
            "deployment": null
          }
        }
      ],
      "when": {
        "runId": "compile-002",
        "attemptId": "workspace-attempt-001",
        "status": "failed",
        "reason": "Dependency installation failed",
        "completedAt": "2026-07-22T11:01:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "workspace-preparation-failed",
          "examplePayload": {
            "runId": "compile-002",
            "attemptId": "workspace-attempt-001",
            "reason": "Dependency installation failed",
            "completedAt": "2026-07-22T11:01:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Allows a later workspace attempt to succeed after a recorded failure.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "compilation-started",
          "examplePayload": {
            "runId": "compile-003",
            "requestedAt": "2026-07-22T12:00:00.000Z",
            "sourceRevision": "git:source-003",
            "sourceTreeDigest": "sha256:source-tree-003",
            "specificationBundleDigest": "sha256:bundle-003",
            "specifications": [],
            "profile": {
              "name": "specter-solid-sqlite",
              "digest": "sha256:profile-001"
            },
            "deployment": null
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "workspace-preparation-failed",
          "examplePayload": {
            "runId": "compile-003",
            "attemptId": "workspace-attempt-001",
            "reason": "Dependency installation failed",
            "completedAt": "2026-07-22T12:01:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-003",
        "attemptId": "workspace-attempt-002",
        "status": "prepared",
        "workspaceId": "sandbox-003",
        "preparedRevision": "git:source-003",
        "completedAt": "2026-07-22T12:02:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "workspace-prepared",
          "examplePayload": {
            "runId": "compile-003",
            "attemptId": "workspace-attempt-002",
            "workspaceId": "sandbox-003",
            "preparedRevision": "git:source-003",
            "completedAt": "2026-07-22T12:02:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Rejects another result after workspace preparation has completed.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "compilation-started",
          "examplePayload": {
            "runId": "compile-004",
            "requestedAt": "2026-07-22T13:00:00.000Z",
            "sourceRevision": "git:source-004",
            "sourceTreeDigest": "sha256:source-tree-004",
            "specificationBundleDigest": "sha256:bundle-004",
            "specifications": [],
            "profile": {
              "name": "specter-solid-sqlite",
              "digest": "sha256:profile-001"
            },
            "deployment": null
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "workspace-prepared",
          "examplePayload": {
            "runId": "compile-004",
            "attemptId": "workspace-attempt-001",
            "workspaceId": "sandbox-004",
            "preparedRevision": "git:source-004",
            "completedAt": "2026-07-22T13:01:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-004",
        "attemptId": "workspace-attempt-001",
        "status": "prepared",
        "workspaceId": "sandbox-004",
        "preparedRevision": "git:source-004",
        "completedAt": "2026-07-22T13:01:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Workspace preparation already completed"
      }
    },
    {
      "description": "Rejects a workspace result after the compilation is cancelled.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "compilation-started",
          "examplePayload": {
            "runId": "compile-005",
            "requestedAt": "2026-07-22T14:00:00.000Z",
            "sourceRevision": "git:source-005",
            "sourceTreeDigest": "sha256:source-tree-005",
            "specificationBundleDigest": "sha256:bundle-005",
            "specifications": [],
            "profile": {
              "name": "specter-solid-sqlite",
              "digest": "sha256:profile-001"
            },
            "deployment": null
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "compilation-cancelled",
          "examplePayload": {
            "runId": "compile-005",
            "reason": "Cancelled by operator",
            "cancelledAt": "2026-07-22T14:00:30.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-005",
        "attemptId": "workspace-attempt-001",
        "status": "prepared",
        "workspaceId": "sandbox-005",
        "preparedRevision": "git:source-005",
        "completedAt": "2026-07-22T14:01:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Compilation is cancelled"
      }
    }
  ]
}
