{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "formatVersion": 1,
  "kind": "command",
  "name": "recordApplicationVerification",
  "description": "Records whole-application CI evidence for the exact verification attempt and source tree.",
  "scenarios": [
    {
      "description": "Records passing scenarios, conformance, typecheck, lint, tests, and build checks.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-started",
          "examplePayload": {
            "runId": "compile-001",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-001",
            "sourceTreeDigest": "sha256:assembled-tree-001",
            "specificationBundleDigest": "sha256:bundle-001",
            "profileDigest": "sha256:profile-001",
            "verifier": {
              "name": "@specter-ts/core/testing",
              "version": "0.4.0"
            },
            "toolchain": {
              "runtime": "node@24.4.1",
              "packageManager": "pnpm@10.13.1"
            },
            "startedAt": "2026-07-22T10:06:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-001",
        "attemptId": "verification-attempt-001",
        "status": "passed",
        "sourceRevision": "git:assembled-001",
        "sourceTreeDigest": "sha256:assembled-tree-001",
        "checks": [
          {
            "name": "specter-scenarios",
            "status": "passed",
            "evidenceDigest": "sha256:scenarios-log-001"
          },
          {
            "name": "typecheck",
            "status": "passed",
            "evidenceDigest": "sha256:typecheck-log-001"
          },
          {
            "name": "build",
            "status": "passed",
            "evidenceDigest": "sha256:build-log-001"
          }
        ],
        "evidenceManifestDigest": "sha256:verification-evidence-001",
        "evidenceUri": "artifact://verification/compile-001/verification-attempt-001",
        "completedAt": "2026-07-22T10:08:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-passed",
          "examplePayload": {
            "runId": "compile-001",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-001",
            "sourceTreeDigest": "sha256:assembled-tree-001",
            "checks": [
              {
                "name": "specter-scenarios",
                "status": "passed",
                "evidenceDigest": "sha256:scenarios-log-001"
              },
              {
                "name": "typecheck",
                "status": "passed",
                "evidenceDigest": "sha256:typecheck-log-001"
              },
              {
                "name": "build",
                "status": "passed",
                "evidenceDigest": "sha256:build-log-001"
              }
            ],
            "evidenceManifestDigest": "sha256:verification-evidence-001",
            "evidenceUri": "artifact://verification/compile-001/verification-attempt-001",
            "completedAt": "2026-07-22T10:08:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Records failed whole-application verification without embedding logs in the Event.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-started",
          "examplePayload": {
            "runId": "compile-002",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-002",
            "sourceTreeDigest": "sha256:assembled-tree-002",
            "specificationBundleDigest": "sha256:bundle-002",
            "profileDigest": "sha256:profile-002",
            "verifier": {
              "name": "@specter-ts/core/testing",
              "version": "0.4.0"
            },
            "toolchain": {
              "runtime": "node@24.4.1",
              "packageManager": "pnpm@10.13.1"
            },
            "startedAt": "2026-07-22T11:06:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-002",
        "attemptId": "verification-attempt-001",
        "status": "failed",
        "sourceRevision": "git:assembled-002",
        "sourceTreeDigest": "sha256:assembled-tree-002",
        "failedChecks": [
          {
            "name": "specter-scenarios",
            "evidenceDigest": "sha256:failed-scenarios-log-002"
          }
        ],
        "evidenceManifestDigest": "sha256:verification-evidence-002",
        "evidenceUri": "artifact://verification/compile-002/verification-attempt-001",
        "completedAt": "2026-07-22T11:08:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-failed",
          "examplePayload": {
            "runId": "compile-002",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-002",
            "sourceTreeDigest": "sha256:assembled-tree-002",
            "failedChecks": [
              {
                "name": "specter-scenarios",
                "evidenceDigest": "sha256:failed-scenarios-log-002"
              }
            ],
            "evidenceManifestDigest": "sha256:verification-evidence-002",
            "evidenceUri": "artifact://verification/compile-002/verification-attempt-001",
            "completedAt": "2026-07-22T11:08:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Rejects verification evidence for a different source tree.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-started",
          "examplePayload": {
            "runId": "compile-003",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-003",
            "sourceTreeDigest": "sha256:assembled-tree-003",
            "specificationBundleDigest": "sha256:bundle-003",
            "profileDigest": "sha256:profile-003",
            "verifier": {
              "name": "@specter-ts/core/testing",
              "version": "0.4.0"
            },
            "toolchain": {
              "runtime": "node@24.4.1",
              "packageManager": "pnpm@10.13.1"
            },
            "startedAt": "2026-07-22T12:06:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-003",
        "attemptId": "verification-attempt-001",
        "status": "failed",
        "sourceRevision": "git:assembled-003",
        "sourceTreeDigest": "sha256:other-tree",
        "failedChecks": [],
        "evidenceManifestDigest": "sha256:verification-evidence-003",
        "evidenceUri": "artifact://verification/compile-003/verification-attempt-001",
        "completedAt": "2026-07-22T12:08:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Verification result does not match the active attempt source tree"
      }
    },
    {
      "description": "Rejects a late verification result after cancellation.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-started",
          "examplePayload": {
            "runId": "compile-004",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-004",
            "sourceTreeDigest": "sha256:assembled-tree-004",
            "specificationBundleDigest": "sha256:bundle-004",
            "profileDigest": "sha256:profile-004",
            "verifier": {
              "name": "@specter-ts/core/testing",
              "version": "0.4.0"
            },
            "toolchain": {
              "runtime": "node@24.4.1",
              "packageManager": "pnpm@10.13.1"
            },
            "startedAt": "2026-07-22T13:06:00.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "compilation-cancelled",
          "examplePayload": {
            "runId": "compile-004",
            "reason": "Cancelled by operator",
            "cancelledAt": "2026-07-22T13:07:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-004",
        "attemptId": "verification-attempt-001",
        "status": "failed",
        "sourceRevision": "git:assembled-004",
        "sourceTreeDigest": "sha256:assembled-tree-004",
        "failedChecks": [],
        "evidenceManifestDigest": "sha256:verification-evidence-004",
        "evidenceUri": "artifact://verification/compile-004/verification-attempt-001",
        "completedAt": "2026-07-22T13:08:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Compilation is cancelled"
      }
    }
  ]
}
