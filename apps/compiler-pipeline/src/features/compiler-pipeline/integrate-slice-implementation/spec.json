    },
    {
      "description": "Records an integration conflict without erasing the produced patch.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-005",
            "sliceName": "ordersQuery",
            "sliceKind": "query",
            "specificationDigest": "sha256:orders-query-005",
            "assignedBaseRevision": "git:source-005",
            "ownedPaths": [
              "src/features/orders/orders-query"
            ],
            "plannedAt": "2026-07-22T14:01:10.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-produced",
          "examplePayload": {
            "runId": "compile-005",
            "sliceName": "ordersQuery",
            "attemptId": "orders-query-attempt-001",
            "baseRevision": "git:source-005",
            "observedSpecificationDigest": "sha256:orders-query-005",
            "patchDigest": "sha256:patch-005",
            "changedPaths": [
              "src/features/orders/orders-query/impl.ts"
            ],
            "completedAt": "2026-07-22T14:03:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-005",
        "sliceName": "ordersQuery",
        "attemptId": "orders-query-attempt-001",
        "patchDigest": "sha256:patch-005",
        "reportedBaseRevision": "git:source-005",
        "observedSpecificationDigest": "sha256:orders-query-005",
        "changedPaths": [
          "src/features/orders/orders-query/impl.ts"
        ],
        "currentSourceRevision": "git:integrated-create-order",
        "result": {
          "status": "conflict",
          "reason": "Patch does not apply cleanly"
        },
        "completedAt": "2026-07-22T14:04:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "slice-integration-failed",
          "examplePayload": {
            "runId": "compile-005",
            "sliceName": "ordersQuery",
            "attemptId": "orders-query-attempt-001",
            "patchDigest": "sha256:patch-005",
            "currentSourceRevision": "git:integrated-create-order",
            "reason": "Patch does not apply cleanly",
            "failedAt": "2026-07-22T14:04:00.000Z"
          }
        }
      ]
    },
