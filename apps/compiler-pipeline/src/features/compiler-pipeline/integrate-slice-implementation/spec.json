{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "formatVersion": 1,
  "kind": "command",
  "name": "integrateSliceImplementation",
  "description": "Integrates a Slice patch in deterministic Slice-name order after verifying its immutable specification, owned paths, and assigned base.",
  "scenarios": [
    {
      "description": "Integrates the lexicographically next valid Slice patch and records the resulting source tree.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-001",
            "sliceName": "createOrder",
            "sliceKind": "command",
            "specificationDigest": "sha256:create-order-001",
            "assignedBaseRevision": "git:source-001",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "plannedAt": "2026-07-22T10:01:10.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-produced",
          "examplePayload": {
            "runId": "compile-001",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "baseRevision": "git:source-001",
            "observedSpecificationDigest": "sha256:create-order-001",
            "patchDigest": "sha256:patch-001",
            "changedPaths": [
              "src/features/orders/create-order/impl.ts"
            ],
            "completedAt": "2026-07-22T10:03:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-001",
        "sliceName": "createOrder",
        "attemptId": "create-order-attempt-001",
        "patchDigest": "sha256:patch-001",
        "reportedBaseRevision": "git:source-001",
        "observedSpecificationDigest": "sha256:create-order-001",
        "changedPaths": [
          "src/features/orders/create-order/impl.ts"
        ],
        "currentSourceRevision": "git:source-001",
        "result": {
          "status": "integrated",
          "sourceRevision": "git:integrated-001",
          "sourceTreeDigest": "sha256:tree-001"
        },
        "completedAt": "2026-07-22T10:04:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-integrated",
          "examplePayload": {
            "runId": "compile-001",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "patchDigest": "sha256:patch-001",
            "sourceRevision": "git:integrated-001",
            "sourceTreeDigest": "sha256:tree-001",
            "completedAt": "2026-07-22T10:04:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Rejects a patch produced against a different assigned base revision.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "sliceKind": "command",
            "specificationDigest": "sha256:create-order-002",
            "assignedBaseRevision": "git:source-002",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "plannedAt": "2026-07-22T11:01:10.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-produced",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "baseRevision": "git:other-source",
            "observedSpecificationDigest": "sha256:create-order-002",
            "patchDigest": "sha256:patch-002",
            "changedPaths": [
              "src/features/orders/create-order/impl.ts"
            ],
            "completedAt": "2026-07-22T11:03:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-002",
        "sliceName": "createOrder",
        "attemptId": "create-order-attempt-001",
        "patchDigest": "sha256:patch-002",
        "reportedBaseRevision": "git:other-source",
        "observedSpecificationDigest": "sha256:create-order-002",
        "changedPaths": [
          "src/features/orders/create-order/impl.ts"
        ],
        "currentSourceRevision": "git:source-002",
        "result": {
          "status": "integrated",
          "sourceRevision": "git:integrated-002",
          "sourceTreeDigest": "sha256:tree-002"
        },
        "completedAt": "2026-07-22T11:04:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Patch base revision differs from its assigned base revision"
      }
    },
    {
      "description": "Rejects a patch that changed its frozen Slice specification.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-003",
            "sliceName": "createOrder",
            "sliceKind": "command",
