        "attemptId": "create-order-attempt-001",
        "patchDigest": "sha256:patch-004",
        "reportedBaseRevision": "git:source-004",
        "observedSpecificationDigest": "sha256:create-order-004",
        "changedPaths": [
          "src/registry.ts"
        ],
        "currentSourceRevision": "git:source-004",
        "result": {
          "status": "integrated",
          "sourceRevision": "git:integrated-004",
          "sourceTreeDigest": "sha256:tree-004"
        },
        "completedAt": "2026-07-22T13:04:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Patch writes outside Slice-owned paths"
