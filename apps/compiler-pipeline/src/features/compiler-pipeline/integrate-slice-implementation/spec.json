          "status": "integrated",
          "sourceRevision": "git:integrated-003",
          "sourceTreeDigest": "sha256:tree-003"
        },
        "completedAt": "2026-07-22T12:04:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Slice specification changed during implementation"
      }
    },
