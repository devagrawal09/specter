{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "formatVersion": 1,
  "kind": "query",
  "name": "compilationRecoveryQuery",
  "description": "Derives stable, idempotent work that must resume after a compiler process restart.",
  "scenarios": [
    {
      "description": "Resumes the same verification attempt after restart.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-started",
          "examplePayload": {
            "runId": "compile-001",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-001",
            "sourceTreeDigest": "sha256:assembled-tree-001",
            "specificationBundleDigest": "sha256:bundle-001",
            "profileDigest": "sha256:profile-001",
            "verifier": {
              "name": "@specter-ts/core/testing",
              "version": "0.4.0"
            },
            "toolchain": {
              "runtime": "node@24.4.1",
              "packageManager": "pnpm@10.13.1"
            },
            "startedAt": "2026-07-22T10:06:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-001"
      },
      "expect": {
        "runId": "compile-001",
        "resumable": true,
        "nextActions": [
          {
            "type": "runApplicationVerification",
            "operationKey": "compile-001:verification:verification-attempt-001",
            "attemptId": "verification-attempt-001",
            "sourceTreeDigest": "sha256:assembled-tree-001"
          }
        ]
      }
    },
    {
      "description": "Resumes integration of a produced patch after restart.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-produced",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "baseRevision": "git:source-002",
            "observedSpecificationDigest": "sha256:create-order-002",
            "patchDigest": "sha256:patch-002",
            "changedPaths": [
              "src/features/orders/create-order/impl.ts"
            ],
            "completedAt": "2026-07-22T11:03:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-002"
      },
      "expect": {
        "runId": "compile-002",
        "resumable": true,
        "nextActions": [
          {
            "type": "integrateSliceImplementation",
            "operationKey": "compile-002:integrate:createOrder:sha256:patch-002",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "patchDigest": "sha256:patch-002"
          }
        ]
      }
    },
    {
      "description": "Returns no work after cancellation even when an earlier attempt was active.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-attempt-started",
          "examplePayload": {
            "runId": "compile-003",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "attemptNumber": 1,
            "sandboxId": "slice-sandbox-003",
            "assignedBaseRevision": "git:source-003",
            "specificationDigest": "sha256:create-order-003",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "startedAt": "2026-07-22T12:02:00.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "compilation-cancelled",
          "examplePayload": {
            "runId": "compile-003",
            "reason": "Cancelled by operator",
            "cancelledAt": "2026-07-22T12:02:30.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-003"
      },
      "expect": {
        "runId": "compile-003",
        "resumable": false,
        "nextActions": []
      }
    },
    {
      "description": "Returns no work after terminal compilation success.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "compilation-succeeded",
          "examplePayload": {
            "runId": "compile-004",
            "artifactDigest": "sha256:artifact-004",
            "receiptDigest": "sha256:receipt-004",
            "completedAt": "2026-07-22T13:11:30.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-004"
      },
      "expect": {
        "runId": "compile-004",
        "resumable": false,
        "nextActions": []
      }
    }
  ]
}
