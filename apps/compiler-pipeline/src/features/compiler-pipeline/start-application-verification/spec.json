{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "formatVersion": 1,
  "kind": "command",
  "name": "startApplicationVerification",
  "description": "Starts whole-application CI verification against one immutable assembled source tree.",
  "scenarios": [
    {
      "description": "Starts verification with exact verifier and toolchain versions.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-assembled",
          "examplePayload": {
            "runId": "compile-001",
            "inputSourceRevision": "git:integrated-001",
            "inputSourceTreeDigest": "sha256:integrated-tree-001",
            "specificationBundleDigest": "sha256:bundle-001",
            "profileDigest": "sha256:profile-001",
            "wiringDigest": "sha256:wiring-001",
            "sourceRevision": "git:assembled-001",
            "sourceTreeDigest": "sha256:assembled-tree-001",
            "assembledAt": "2026-07-22T10:05:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-001",
        "attemptId": "verification-attempt-001",
        "sourceRevision": "git:assembled-001",
        "sourceTreeDigest": "sha256:assembled-tree-001",
        "specificationBundleDigest": "sha256:bundle-001",
        "profileDigest": "sha256:profile-001",
        "verifier": {
          "name": "@specter-ts/core/testing",
          "version": "0.4.0"
        },
        "toolchain": {
          "runtime": "node@24.4.1",
          "packageManager": "pnpm@10.13.1"
        },
        "startedAt": "2026-07-22T10:06:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "application-verification-started",
          "examplePayload": {
            "runId": "compile-001",
            "attemptId": "verification-attempt-001",
            "sourceRevision": "git:assembled-001",
            "sourceTreeDigest": "sha256:assembled-tree-001",
            "specificationBundleDigest": "sha256:bundle-001",
            "profileDigest": "sha256:profile-001",
            "verifier": {
              "name": "@specter-ts/core/testing",
              "version": "0.4.0"
            },
            "toolchain": {
              "runtime": "node@24.4.1",
              "packageManager": "pnpm@10.13.1"
            },
            "startedAt": "2026-07-22T10:06:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Rejects verification against a source tree other than the assembled tree.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "application-assembled",
          "examplePayload": {
            "runId": "compile-002",
            "inputSourceRevision": "git:integrated-002",
            "inputSourceTreeDigest": "sha256:integrated-tree-002",
            "specificationBundleDigest": "sha256:bundle-002",
            "profileDigest": "sha256:profile-002",
            "wiringDigest": "sha256:wiring-002",
            "sourceRevision": "git:assembled-002",
            "sourceTreeDigest": "sha256:assembled-tree-002",
            "assembledAt": "2026-07-22T11:05:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-002",
        "attemptId": "verification-attempt-001",
        "sourceRevision": "git:assembled-002",
        "sourceTreeDigest": "sha256:changed-tree",
        "specificationBundleDigest": "sha256:bundle-002",
        "profileDigest": "sha256:profile-002",
        "verifier": {
          "name": "@specter-ts/core/testing",
          "version": "0.4.0"
        },
        "toolchain": {
          "runtime": "node@24.4.1",
          "packageManager": "pnpm@10.13.1"
        },
        "startedAt": "2026-07-22T11:06:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Verification source tree differs from the assembled source tree"
      }
    }
  ]
}
