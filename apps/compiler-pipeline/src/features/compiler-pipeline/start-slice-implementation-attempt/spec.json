{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "formatVersion": 1,
  "kind": "command",
  "name": "startSliceImplementationAttempt",
  "description": "Records the start of one isolated agent attempt for a planned Slice.",
  "scenarios": [
    {
      "description": "Starts the first implementation attempt for a planned Slice.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-001",
            "sliceName": "createOrder",
            "sliceKind": "command",
            "specificationDigest": "sha256:create-order-001",
            "assignedBaseRevision": "git:source-001",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "plannedAt": "2026-07-22T10:01:10.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-001",
        "sliceName": "createOrder",
        "attemptId": "create-order-attempt-001",
        "attemptNumber": 1,
        "sandboxId": "slice-sandbox-001",
        "startedAt": "2026-07-22T10:02:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-attempt-started",
          "examplePayload": {
            "runId": "compile-001",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "attemptNumber": 1,
            "sandboxId": "slice-sandbox-001",
            "assignedBaseRevision": "git:source-001",
            "specificationDigest": "sha256:create-order-001",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "startedAt": "2026-07-22T10:02:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Starts a later attempt after the prior agent attempt failed.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "sliceKind": "command",
            "specificationDigest": "sha256:create-order-002",
            "assignedBaseRevision": "git:source-002",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "plannedAt": "2026-07-22T11:01:10.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-attempt-started",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "attemptNumber": 1,
            "sandboxId": "slice-sandbox-002",
            "assignedBaseRevision": "git:source-002",
            "specificationDigest": "sha256:create-order-002",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "startedAt": "2026-07-22T11:02:00.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-failed",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "baseRevision": "git:source-002",
            "reason": "Scenario tests failed",
            "failedAt": "2026-07-22T11:03:00.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-retry-requested",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "failedAttemptId": "create-order-attempt-001",
            "nextAttemptNumber": 2,
            "requestedAt": "2026-07-22T11:03:30.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-002",
        "sliceName": "createOrder",
        "attemptId": "create-order-attempt-002",
        "attemptNumber": 2,
        "sandboxId": "slice-sandbox-003",
        "startedAt": "2026-07-22T11:04:00.000Z"
      },
      "expect": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-attempt-started",
          "examplePayload": {
            "runId": "compile-002",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-002",
            "attemptNumber": 2,
            "sandboxId": "slice-sandbox-003",
            "assignedBaseRevision": "git:source-002",
            "specificationDigest": "sha256:create-order-002",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "startedAt": "2026-07-22T11:04:00.000Z"
          }
        }
      ]
    },
    {
      "description": "Rejects a concurrent attempt while the current attempt has no terminal result.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-003",
            "sliceName": "createOrder",
            "sliceKind": "command",
            "specificationDigest": "sha256:create-order-003",
            "assignedBaseRevision": "git:source-003",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "plannedAt": "2026-07-22T12:01:10.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-attempt-started",
          "examplePayload": {
            "runId": "compile-003",
            "sliceName": "createOrder",
            "attemptId": "create-order-attempt-001",
            "attemptNumber": 1,
            "sandboxId": "slice-sandbox-004",
            "assignedBaseRevision": "git:source-003",
            "specificationDigest": "sha256:create-order-003",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "startedAt": "2026-07-22T12:02:00.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-003",
        "sliceName": "createOrder",
        "attemptId": "create-order-attempt-002",
        "attemptNumber": 2,
        "sandboxId": "slice-sandbox-005",
        "startedAt": "2026-07-22T12:03:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Slice implementation attempt already active"
      }
    },
    {
      "description": "Rejects an attempt after the compilation is cancelled.",
      "given": [
        {
          "kind": "scenario-event",
          "eventType": "slice-implementation-planned",
          "examplePayload": {
            "runId": "compile-004",
            "sliceName": "createOrder",
            "sliceKind": "command",
            "specificationDigest": "sha256:create-order-004",
            "assignedBaseRevision": "git:source-004",
            "ownedPaths": [
              "src/features/orders/create-order"
            ],
            "plannedAt": "2026-07-22T13:01:10.000Z"
          }
        },
        {
          "kind": "scenario-event",
          "eventType": "compilation-cancelled",
          "examplePayload": {
            "runId": "compile-004",
            "reason": "Cancelled by operator",
            "cancelledAt": "2026-07-22T13:01:30.000Z"
          }
        }
      ],
      "when": {
        "runId": "compile-004",
        "sliceName": "createOrder",
        "attemptId": "create-order-attempt-001",
        "attemptNumber": 1,
        "sandboxId": "slice-sandbox-006",
        "startedAt": "2026-07-22T13:02:00.000Z"
      },
      "expect": [],
      "reject": {
        "reason": "Compilation is cancelled"
      }
    }
  ]
}
