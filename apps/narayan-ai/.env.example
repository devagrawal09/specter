NARAYAN_AI_DB_PATH=./data/narayan-ai.db
NARAYAN_AI_PUBLIC_URL=https://example.ngrok-free.app

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+141****8886
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARIABLES_JSON={"1":"{{body}}","2":"Narayan AI"}
TWILIO_VALIDATE_SIGNATURE=true

OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Starts a fresh AI conversation after this many idle minutes.
NARAYAN_AI_SESSION_IDLE_MINUTES=60
